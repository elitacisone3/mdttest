# "Controlli extra" (--extended, vedi src/extra_scan): le etichette delle
# categorie (EXTRA_SCAN_DEFS) sono sempre risolte qui, PRIMA di costruire
# la TUI o qualunque report (vedi tui_build_steps()/generate_final_report()
# piu' sotto) — SEMPRE, indipendentemente da --extended: e' cosi' che la
# sezione "Controlli extra:" ha etichette stabili anche in una cattura non
# estesa (dove restano solo intestazioni, nessun valore). Fail-soft: se
# src/extra_scan manca o fallisce, l'array resta vuoto e quella sezione
# semplicemente non compare da nessuna parte, nessun errore fatale.
declare -A EXTRA_SCAN_DEFS=()
EXTRA_SCAN_DEFS_ORDER=()
extra_scan_get_defs() {
    [[ -f "$EXTRA_SCAN_SCRIPT" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    local out key val
    out=$(python3 "$EXTRA_SCAN_SCRIPT" --get-defs 2>/dev/null) || return 0
    while IFS=' ' read -r key val; do
        [[ -n "$key" ]] || continue
        EXTRA_SCAN_DEFS["$key"]="$val"
        EXTRA_SCAN_DEFS_ORDER+=("$key")
    done <<< "$out"
}
extra_scan_get_defs

# --analyze-dlf/--analyze-pcap (modalita' replay): nessun device coinvolto,
# --diag-port/--at-port/--autodetect non servono e non vengono validati.
# Serve solo che il file indicato esista. Controllato QUI, prima di creare
# l'outdir (vedi sotto): un --analyze-dlf/--analyze-pcap con percorso
# sbagliato deve fallire subito, senza lasciare in giro una cartella di
# evidenza vuota.
if [[ -n "$ANALYZE_DLF" ]]; then
    [[ -f "$ANALYZE_DLF" ]] || { echo "File --analyze-dlf non trovato: $ANALYZE_DLF" >&2; exit 1; }
elif [[ -n "$ANALYZE_PCAP" ]]; then
    [[ -f "$ANALYZE_PCAP" ]] || { echo "File --analyze-pcap non trovato: $ANALYZE_PCAP" >&2; exit 1; }
fi

TS_START_TAG=$(date -u +%Y%m%dT%H%M%SZ)
TS_START_NUMERIC="${TS_START_TAG//[TZ]/}"  # stesso istante, solo cifre: AAAAMMGGhhmmss

# --outdir-base DIR: crea automaticamente DIR/<AAAAMMGGhhmmss> e la usa
# come outdir, cosi' non serve comporre a mano il path con il timestamp
# (alternativo a --outdir, non usabile insieme: vedi validazione sopra).
# Se NESSUNO dei due e' stato passato (ne' esplicitamente ne' via
# system.conf/--op/--profile/--config), default: log/data (accanto a
# questo script) come se fosse stato passato --outdir-base log/data.
if [[ -n "$OUTDIR_BASE" ]]; then
    OUTDIR="$OUTDIR_BASE/$TS_START_NUMERIC"
elif [[ -z "$OUTDIR" ]]; then
    OUTDIR="$SCRIPT_DIR/log/data/$TS_START_NUMERIC"
fi

mkdir -p "$OUTDIR"
OUTDIR=$(cd "$OUTDIR" && pwd)
SESSION_LOG="$OUTDIR/session.log"

PCAP_FILE="$OUTDIR/capture_${TS_START_TAG}.pcap"
DLF_FILE="$OUTDIR/capture_${TS_START_TAG}.dlf"
QCSUPER_LOG="$OUTDIR/qcsuper.log"
CTX_PRE="$OUTDIR/context_pre.txt"
CTX_POST="$OUTDIR/context_post.txt"
PERIODIC_CSV="$OUTDIR/periodic_cell_gps.csv"
PERIODIC_DECODED_CSV="$OUTDIR/periodic_cell_gps_decoded.csv"
MANIFEST="$OUTDIR/manifest.txt"
HASH_FILE="$OUTDIR/hashes_sha256.txt"
TUI_NET_GPS_STATUS_FILE="$OUTDIR/.tui_net_gps_status"
TUI_MDT_STATUS_FILE="$OUTDIR/.tui_mdt_status"
TUI_RECONNECT_STATUS_FILE="$OUTDIR/.tui_reconnect_status"
TUI_DIAG_STATUS_FILE="$OUTDIR/.tui_diag_status"
TUI_DIAG_ERROR_STATUS_FILE="$OUTDIR/.tui_diag_error_status"

# Predefinite vuote/valorizzate qui (anche se assegnate "per davvero" solo
# piu' avanti, quando i rispettivi processi/file esistono) cosi' che
# finalize() possa essere agganciato come trap fin da subito: se lo script
# esce in anticipo (es. --require-lte che abortisce, o qcsuper che non
# parte) prima che qcsuper/i logger di background vengano avviati, il
# cleanup (incluso il ripristino di AT+CNMP dopo --force-lte) gira comunque.
QCSUPER_PID=""
PERIODIC_PID=""
VERBOSE_PID=""
VERBOSE_SNAPSHOT_DLF="$OUTDIR/.verbose_snapshot.dlf"
VERBOSE_SNAPSHOT_PCAP="$OUTDIR/.verbose_snapshot.pcap"
MDT_STATUS_PID=""
MDT_STATUS_SNAPSHOT_DLF="$OUTDIR/.tui_mdt_snapshot.dlf"
MDT_STATUS_SNAPSHOT_PCAP="$OUTDIR/.tui_mdt_snapshot.pcap"

# In modalita' replay (--analyze-dlf) tutto questo blocco - log di avvio
# "da cattura live" e apertura della porta AT vera e propria - non si
# applica: non c'e' alcun device. Viene saltato per intero; il branch che
# chiama run_replay_mode() ed esce e' piu' sotto, dopo le definizioni di
# funzione di cui ha bisogno (vedi commento li'). $AT_PORT resta vuoto in
# quel caso e le funzioni che seguono (at_query e affini) restano definite
# ma inutilizzate.
#
# Nota d'ordine: qui sotto la TUI (tui_init) viene inizializzata PRIMA di
# risolvere le porte (autodetect_ports, subito dopo), non dopo come per il
# resto del flusso: --autodetect impiega qualche secondo a provare "AT" su
# ogni ttyUSB* candidato, e senza questo accorgimento lo script
# sembrerebbe non fare nulla in quella finestra. "Diag port"/"AT port" non
# compaiono quindi in questa intestazione statica (non sono ancora noti):
# con --autodetect finiscono in nota sul passo "Rilevamento porte"
# stesso, altrimenti (porte passate esplicitamente, gia' note qui) sotto,
# subito dopo la validazione.
if [[ -z "$ANALYZE_DLF" && -z "$ANALYZE_PCAP" ]]; then
    if [[ "$TUI_ENABLED" -eq 1 ]]; then
        # Sotto --tui questo blocco NON stampa nulla di suo (comparirebbe
        # come testo grezzo PRIMA dell'elenco, mai piu' ripulito da
        # tui_redraw): Operatore/Percorso dati/Titolo sono gia' i primi 3
        # pallini di "Informazioni:" in tui_build_steps(), disegnati da
        # tui_init() qui sotto.
        tui_init
    else
        log --show "=== mdtcap v$SCRIPT_VERSION ==="
        log --show "Output dir: $OUTDIR"
        log --show "qcsuper   : $QCSUPER_BIN"
        [[ -f "$SYSTEM_FILE" ]] && log --show "Sistema   : mdt_configs/system.conf"
        if [[ -n "$OP_MCCMNC" ]]; then
            log --show "Operatore (auto MCC-MNC $OP_MCCMNC): $OP_NAME (mdt_configs/op/${OP_NAME}.conf)"
        elif [[ -n "$OP_NAME" ]]; then
            log --show "Operatore (--op): $OP_NAME (mdt_configs/op/${OP_NAME}.conf)"
        fi
        [[ -n "$PROFILE_NAME" ]] && log --show "Profilo (--profile): $PROFILE_NAME (mdt_configs/profile/${PROFILE_NAME}.conf)"
        [[ -n "$LABEL" ]] && log --show "Etichetta : $LABEL"
    fi
fi

# ---- risoluzione/validazione porte (autodetect, se richiesto) -----------
#
# Spostata qui (era prima della creazione dell'outdir/di tui_init, vedi
# nota sopra) apposta perche' --autodetect possa comparire come passo
# della TUI: autodetect_ports() usa QCSUPER_CMD (gia' risolto sopra) per
# verificare la porta Diag individuata.
if [[ -z "$ANALYZE_DLF" && -z "$ANALYZE_PCAP" ]]; then
    if [[ "$AUTODETECT" -eq 1 ]]; then
        tui_set autodetect running
        autodetect_ports
    fi

    if [[ -z "$DIAG_PORT" || -z "$AT_PORT" ]]; then
        tui_set autodetect error "porta non trovata"
    fi
    [[ -n "$DIAG_PORT" ]] || { echo "Manca --diag-port (usa --list-ports o --autodetect per individuarla)." >&2; exit 1; }
    [[ -n "$AT_PORT" ]] || { echo "Manca --at-port (usa --list-ports o --autodetect per individuarla)." >&2; exit 1; }
    # "auto" e' un valore speciale (impostato da --autodetect quando non
    # riesce a determinare con certezza la porta Diag): non e' un path, la
    # risoluzione resta a carico di qcsuper stesso al momento della cattura.
    if [[ "$DIAG_PORT" != "auto" ]]; then
        [[ -e "$DIAG_PORT" ]] || { echo "Porta diag inesistente: $DIAG_PORT" >&2; exit 1; }
    fi
    [[ -e "$AT_PORT" ]] || { echo "Porta AT inesistente: $AT_PORT" >&2; exit 1; }

    # --usb-modem: verificato qui (non prima) perche' e' indipendente da
    # --autodetect/--diag-port sopra (quella resta comunque richiesta: la
    # porta AT continua a servire per PIN/APN/CPSI/GPS, e $DIAG_PORT resta
    # nel manifest/nei log anche quando non e' cio' che viene passato a
    # qcsuper, vedi start_qcsuper_capture()) — cambia SOLO l'argomento che
    # start_qcsuper_capture() passera' a "qcsuper --usb-modem", non quali
    # porte servono a monte.
    if [[ "$USB_MODEM_MODE" -eq 1 ]]; then
        if [[ -z "$USB_MODEM_VID" || -z "$USB_MODEM_PID" ]]; then
            echo "--usb-modem richiede --usb-modem-vid/--usb-modem-pid (di norma gia' in mdt_configs/system.conf se rilevati da 'sudo ./install.sh --configure-system' a modem collegato; altrimenti passali a mano, vedi 'lsusb')." >&2
            exit 1
        fi
        if [[ ! "$USB_MODEM_VID" =~ ^[0-9a-fA-F]{4}$ || ! "$USB_MODEM_PID" =~ ^[0-9a-fA-F]{4}$ ]]; then
            echo "--usb-modem-vid/--usb-modem-pid vogliono 4 cifre esadecimali ciascuno (es. 1e0e/9000), ricevuto: '$USB_MODEM_VID'/'$USB_MODEM_PID'." >&2
            exit 1
        fi
    fi

    if [[ "$AUTODETECT" -eq 1 ]]; then
        tui_set autodetect ok "Diag: $DIAG_PORT, AT: $AT_PORT"
    fi
    # Con --tui e --autodetect insieme, Diag/AT port sono gia' visibili in
    # nota sul passo "Rilevamento porte" appena aggiornato sopra: stamparle
    # anche qui come righe statiche corromperebbe il disegno della TUI
    # (un redraw successivo risalirebbe di un numero di righe che non
    # tiene conto di queste due righe extra inserite nel mezzo).
    if [[ "$TUI_ENABLED" -eq 1 && "$AUTODETECT" -eq 1 ]]; then
        :
    else
        log --show "Diag port : $DIAG_PORT"
        log --show "AT port   : $AT_PORT"
        [[ "$USB_MODEM_MODE" -eq 1 ]] && log --show "USB modem : $USB_MODEM_VID:$USB_MODEM_PID (usato al posto del device path per qcsuper --usb-modem, vedi --usb-modem)"
    fi
fi

# ---- helper per comandi AT ---------------------------------------------

# NB: su porte seriali virtuali USB (come le porte AT del SIM7600XE) il baud
# rate e' puramente informativo: il trasporto reale e' USB, non UART, quindi
# forzare un numero di baud specifico puo' fallire la verifica interna di
# stty pur non avendo alcun effetto pratico. Impostiamo il baud "best effort"
# e non blocchiamo lo script se non viene accettato; cio' che conta davvero
# e' la modalita' raw (no canonical, no echo).
if [[ -z "$ANALYZE_DLF" && -z "$ANALYZE_PCAP" ]]; then
    stty -F "$AT_PORT" "$BAUD" 2>/dev/null || true
    stty -F "$AT_PORT" raw -echo -echoe -echok time 0 min 0
    exec {AT_FD}<>"$AT_PORT"
fi

at_query() {
    local cmd="$1" tmo="${2:-3}" resp="" line
    printf '%s\r' "$cmd" >&"$AT_FD"
    while IFS= read -r -t "$tmo" -u "$AT_FD" line; do
        line="${line%$'\r'}"
        [[ -z "$line" ]] && continue
        resp+="$line"$'\n'
        if [[ "$line" == "OK" || "$line" == "ERROR" || "$line" =~ ^\+CME\ ERROR ]]; then
            break
        fi
    done
    printf '%s' "$resp"
}

dump_context() {
    local out="$1" phase="$2"
    {
        echo "# Contesto AT — fase: $phase"
        echo "# Timestamp UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "# Hostname: $(hostname)"
        echo
        echo "## AT+CGMI (produttore)"; at_query "AT+CGMI"
        echo "## AT+CGMM (modello)"; at_query "AT+CGMM"
        echo "## AT+CGMR (firmware)"; at_query "AT+CGMR"
        echo "## AT+CGSN (IMEI)"; at_query "AT+CGSN"
        echo "## AT+CCID / AT+ICCID (SIM)"; at_query "AT+CCID"
        echo "## AT+COPS? (operatore)"; at_query "AT+COPS?"
        echo "## AT+CREG? (registrazione 2G/3G)"; at_query "AT+CREG?"
        echo "## AT+CEREG? (registrazione LTE)"; at_query "AT+CEREG?"
        echo "## AT+CPSI? (info sistema/cella dettagliata, SIMCom)"; at_query "AT+CPSI?" 5
        echo "## AT+CSQ (qualità segnale)"; at_query "AT+CSQ"
    } > "$out"
    log "Contesto AT ($phase) salvato in $out"
}

# Backup dell'IMEI ORIGINALE del modulo in mdt_configs/imei, se non esiste
# gia' (mai sovrascritto: e' un backup dell'IMEI di fabbrica, non l'ultimo
# osservato). Best-effort e non bloccante: l'IMEI e' comunque leggibile in
# ogni momento dal modulo stesso via AT+CGSN, questo file serve solo a non
# perderne memoria se in futuro viene cambiato con mdtimei (che non
# ripristina da solo, va rilanciato con --imei e questo valore). Chiamata
# ad ogni cattura live (non in modalita' replay): la prima esecuzione dopo
# l'installazione crea il file da sola, senza bisogno di un passo manuale
# a parte (vedi anche install.sh --configure-system, che tenta lo stesso
# salvataggio se la porta AT e' determinabile in fase di installazione).
ensure_imei_backup() {
    [[ -f "$IMEI_FILE" ]] && return 0
    local imei
    imei=$(at_query "AT+CGSN" 5 | tr -d '\r' | grep -E '^[0-9]{14,16}$' | head -n1)
    if [[ -n "$imei" ]]; then
        mkdir -p "$(dirname "$IMEI_FILE")"
        printf '%s\n' "$imei" > "$IMEI_FILE"
        log "IMEI originale del modulo salvato in $IMEI_FILE ($imei): non esisteva ancora un backup."
    else
        log "ATTENZIONE: impossibile leggere l'IMEI (AT+CGSN) per salvarlo in $IMEI_FILE."
    fi
}

unlock_sim_pin() {
    local status attempt
    tui_set pin running
    # Subito dopo un ciclo AT+CFUN=0/1 (vedi force_lte) il modem puo' essere
    # ancora in fase di re-inizializzazione e non rispondere in modo
    # riconoscibile alla prima interrogazione: ritenta un paio di volte
    # prima di arrendersi, per non saltare lo sblocco per una semplice
    # race condition.
    for attempt in 1 2 3; do
        status=$(at_query "AT+CPIN?" 5)
        echo "$status" | grep -qE '\+CPIN:|^OK|^ERROR|CME ERROR' && break
        [[ "$attempt" -lt 3 ]] && sleep 2
    done
    log "Stato SIM (AT+CPIN?): $(echo "$status" | tr -d '\r' | grep -E '^\+CPIN|^OK|^ERROR|CME ERROR' | tr '\n' ' ')"

    if echo "$status" | grep -q '+CPIN: READY'; then
        log "SIM gia' sbloccata, nessun PIN necessario"
        tui_set pin ok "READY"
        return
    fi

    if echo "$status" | grep -q '+CPIN: SIM PUK'; then
        log "ATTENZIONE: la SIM richiede il PUK (troppi tentativi di PIN errati), non il PIN. Lo script non gestisce lo sblocco PUK."
        tui_set pin error "richiede PUK, non gestito"
        return
    fi

    if echo "$status" | grep -q '+CPIN: SIM PIN'; then
        if [[ -z "$SIM_PIN" ]]; then
            log "ATTENZIONE: la SIM richiede il PIN ma --sim-pin non e' stato fornito. La registrazione di rete fallira'."
            tui_set pin error "PIN richiesto ma non fornito"
            return
        fi
        log "SIM richiede il PIN: invio il valore fornito con --sim-pin (non loggato in chiaro)"
        local res
        res=$(at_query "AT+CPIN=\"$SIM_PIN\"" 8)
        if echo "$res" | grep -q '^OK'; then
            log "PIN accettato, attendo qualche secondo per la registrazione di rete"
            tui_sleep 3
            tui_set pin ok "PIN accettato"
        else
            log "ATTENZIONE: PIN rifiutato o errore nell'invio (dettaglio omesso per non esporre il PIN nei log)"
            tui_set pin error "PIN rifiutato"
        fi
    fi
}

# Imposta l'APN sul contesto PDP 1 (AT+CGDCONT). Un APN residuo di
# fabbrica/da un uso precedente (es. "CMNET") non valido per l'operatore
# reale della SIM causa tipicamente il rifiuto dell'attach dati/LTE
# ("Missing or unknown APN"). Non bloccante: logga l'esito e ritorna
# comunque.
set_apn() {
    local res
    tui_set apn running
    log "Impostazione APN sul contesto PDP 1: \"$APN\" (AT+CGDCONT=1,\"IP\",\"$APN\")"
    res=$(at_query "AT+CGDCONT=1,\"IP\",\"$APN\"" 5)
    if echo "$res" | grep -q '^OK'; then
        log "APN impostato correttamente"
        tui_set apn ok
    else
        log "ATTENZIONE: impostazione APN fallita o risposta inattesa: $(echo "$res" | tr '\n' ' ')"
        tui_set apn skip "impostazione fallita, non bloccante"
    fi
}

# Forza la modalita' LTE-only (AT+CNMP=38) e cicla il radio (AT+CFUN=0
# poi AT+CFUN=1) per costringere il modem a un nuovo tentativo di attach,
# specificamente su LTE invece di ripiegare automaticamente su GSM/WCDMA.
# Il ciclo CFUN richiede di norma un nuovo sblocco PIN: viene ritentato
# automaticamente (richiama unlock_sim_pin). Non bloccante e non verifica
# da solo l'esito oltre a un log dello stato rete: per attendere/abortire
# esplicitamente in base al risultato va combinato con --require-lte
# --lte-wait SECONDS. Il modo di rete viene ripristinato su automatico a
# fine cattura in finalize().
#
# Avvia la cattura (start_qcsuper_capture, idempotente) PRIMA del ciclo
# CFUN, non dopo: la riconnessione forzata qui sotto e' esattamente il
# momento in cui un operatore potrebbe inviare la configurazione MDT (fa
# tipicamente parte della RRCConnectionReconfiguration successiva al
# nuovo attach) — se la cattura partisse solo a fine ciclo, come accadeva
# in una versione precedente di questo script, quella sequenza non
# verrebbe mai osservata. QCSUPER_WARMUP_WAIT attende che l'import ASN.1
# (pycrate, 10-20s tipici su Raspberry Pi, vedi nota in
# start_qcsuper_capture) sia concluso prima di innescare la riconnessione,
# altrimenti la cattura rischierebbe di non essere ancora pronta a
# registrare pacchetti proprio nel momento che interessa di piu'.
force_lte() {
    tui_set force_lte running
    start_qcsuper_capture
    log "Attesa ${QCSUPER_WARMUP_WAIT}s per l'avvio completo di qcsuper prima del ciclo radio, per catturare l'intera sequenza di re-attach..."
    tui_sleep "$QCSUPER_WARMUP_WAIT"

    log "Forzatura modalita' LTE-only (AT+CNMP=38)..."
    at_query "AT+CNMP=38" 5 >> "$SESSION_LOG" || true

    log "Ciclo radio per forzare un nuovo attach (AT+CFUN=0 poi AT+CFUN=1)..."
    at_query "AT+CFUN=0" 5 >> "$SESSION_LOG" || true
    tui_sleep 5
    at_query "AT+CFUN=1" 5 >> "$SESSION_LOG" || true
    tui_sleep 5

    unlock_sim_pin

    log "Attesa assestamento post-CFUN (10s)..."
    tui_sleep 10
    local cpsi
    cpsi=$(at_query "AT+CPSI?" 5 | tr -d '\r' | grep '^+CPSI:' || true)
    log "Stato rete dopo forzatura LTE-only: ${cpsi:-nessuna risposta}"
    tui_set force_lte ok "${cpsi:-nessuna risposta}"
}

# Ritorna 0 se il modem e' agganciato a una cella LTE (unico RAT in cui sono
# definiti gli IE MDT loggedMeasurementConfiguration/locationInfo estratti a
# fine cattura), altrimenti 1. Se la rete non e' LTE al primo controllo,
# riprova ogni 5s fino a LTE_WAIT secondi prima di arrendersi.
check_network_adequate() {
    local elapsed=0 interval=5 cpsi mode
    tui_set require_lte running
    while true; do
        cpsi=$(at_query "AT+CPSI?" 5 | tr -d '\r')
        mode=$(echo "$cpsi" | grep '^+CPSI:' | sed -E 's/^\+CPSI:[[:space:]]*([^,]+),.*/\1/')
        log "Verifica tipo rete (AT+CPSI?): ${mode:-sconosciuto}"
        if [[ "$mode" == "LTE" ]]; then
            log "Tipo rete adeguato per l'estrazione MDT (LTE): la cattura puo' procedere"
            tui_set require_lte ok "LTE"
            tui_set net_status ok "LTE"
            return 0
        fi
        tui_set net_status skip "${mode:-sconosciuto}"
        if (( elapsed >= LTE_WAIT )); then
            log "ATTENZIONE: rete attuale '${mode:-sconosciuta}' non e' LTE (atteso ${LTE_WAIT}s)."
            log "Gli IE MDT (loggedMeasurementConfiguration/locationInfo) sono definiti solo in LTE-RRC: una cattura su '${mode:-sconosciuta}' non produrrebbe dati MDT utili."
            tui_set require_lte error "rete '${mode:-sconosciuta}', non LTE dopo ${LTE_WAIT}s"
            return 1
        fi
        tui_sleep "$interval"
        elapsed=$((elapsed + interval))
    done
}

# Attende (attivando il GPS/GNSS se necessario) fino a GPS_WAIT secondi un
# fix valido da AT+CGPSINFO (latitudine non vuota). Non bloccante: se allo
# scadere non c'e' fix, logga un'ATTENZIONE e ritorna comunque.
wait_for_gps_fix() {
    local elapsed=0 interval=5 info lat lon
    log "Attesa fix GPS/GNSS (fino a ${GPS_WAIT}s)..."
    while true; do
        info=$(at_query "AT+CGPSINFO" 5 | tr -d '\r')
        info=$(echo "$info" | grep '^+CGPSINFO:' | sed -E 's/^\+CGPSINFO:[[:space:]]*//')
        lat=$(echo "$info" | cut -d',' -f1)
        if [[ -n "$lat" ]]; then
            log "Fix GPS/GNSS ottenuto: +CGPSINFO: $info"
            local ns ew decimal
            ns=$(echo "$info" | cut -d',' -f2)
            lon=$(echo "$info" | cut -d',' -f3)
            ew=$(echo "$info" | cut -d',' -f4)
            decimal=$(gps_to_decimal "$lat" "$ns" "$lon" "$ew")
            tui_set gps ok "fix: $decimal"
            tui_set gps_status ok "$decimal"
            GPS_FIX_OBTAINED=1
            return 0
        fi
        tui_set gps_status skip "nessun fix al momento"
        if (( elapsed >= GPS_WAIT )); then
            log "ATTENZIONE: nessun fix GPS/GNSS ottenuto entro ${GPS_WAIT}s (continuo comunque, verifica non bloccante)"
            tui_set gps skip "nessun fix entro ${GPS_WAIT}s"
            return 1
        fi
        log "GPS/GNSS: nessun fix ancora (${elapsed}s/${GPS_WAIT}s)"
        tui_sleep "$interval"
        elapsed=$((elapsed + interval))
    done
}

# Tenta l'attach alla rete dati (PS domain) e l'attivazione del contesto PDP
# 1, poi attende fino a NET_ATTACH_WAIT secondi che il modem risulti
# "connesso" (CGATT: 1 e contesto PDP 1 attivo). Non configura ne' richiede
# uno stack PPP/rete locale: verifica solo lo stato riportato dal modem
# stesso. Non bloccante: se allo scadere non risulta connesso, logga
# un'ATTENZIONE e ritorna comunque.
wait_for_net_attach() {
    local elapsed=0 interval=5 attach pdp addr
    tui_set net_attach running
    log "Tentativo di attach dati (AT+CGATT=1)..."
    at_query "AT+CGATT=1" 8 >> "$SESSION_LOG" || true
    log "Tentativo di attivazione contesto PDP 1 (AT+CGACT=1,1)..."
    at_query "AT+CGACT=1,1" 8 >> "$SESSION_LOG" || true
    log "Verifica stato connessione dati (fino a ${NET_ATTACH_WAIT}s)..."
    while true; do
        attach=$(at_query "AT+CGATT?" 5 | tr -d '\r' | grep '^+CGATT:' || true)
        pdp=$(at_query "AT+CGACT?" 5 | tr -d '\r' | grep '^+CGACT: 1,1' || true)
        addr=$(at_query "AT+CGPADDR=1" 5 | tr -d '\r' | grep '^+CGPADDR:' || true)
        log "Stato dati: ${attach:-CGATT n/d} | ${pdp:-PDP1 non attivo} | ${addr:-indirizzo n/d}"
        if [[ "$attach" == "+CGATT: 1" && -n "$pdp" ]]; then
            log "Modem risulta connesso a livello dati (PS attach + PDP context attivi)"
            tui_set net_attach ok "${addr:-connesso}"
            return 0
        fi
        if (( elapsed >= NET_ATTACH_WAIT )); then
            log "ATTENZIONE: modem non risulta connesso a livello dati entro ${NET_ATTACH_WAIT}s (continuo comunque, verifica non bloccante)"
            tui_set net_attach skip "non connesso entro ${NET_ATTACH_WAIT}s"
            return 1
        fi
        tui_sleep "$interval"
        elapsed=$((elapsed + interval))
    done
}

# Interroga il servizio di localizzazione lato rete (Cell Location Based
# Service) via AT+CLBS=4 (lat/long/data/ora/precisione stimate dal server
# LBS dell'operatore/SIMCom a partire dalla cella servente, senza GPS).
# Richiede il contesto dati attivo: se non risulta gia' attaccato, tenta
# l'attach prima di interrogare. Non bloccante: logga l'esito e ritorna
# comunque; il risultato grezzo va anche in $OUTDIR/lbs_query.txt.
query_lbs() {
    local attach res
    tui_set lbs running
    attach=$(at_query "AT+CGATT?" 5 | tr -d '\r' | grep '^+CGATT:' || true)
    if [[ "$attach" != "+CGATT: 1" ]]; then
        log "LBS: contesto dati non attivo, tento l'attach (AT+CGATT=1 / AT+CGACT=1,1) prima dell'interrogazione..."
        at_query "AT+CGATT=1" 8 >> "$SESSION_LOG" || true
        at_query "AT+CGACT=1,1" 8 >> "$SESSION_LOG" || true
    fi
    log "Interrogazione servizio di localizzazione di rete (AT+CLBS=4)..."
    res=$(at_query "AT+CLBS=4" 30 | tr -d '\r')
    {
        echo "# Interrogazione LBS (AT+CLBS=4) — $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "$res"
    } > "$OUTDIR/lbs_query.txt"
    if echo "$res" | grep -q '^+CLBS:'; then
        log "Risposta LBS: $(echo "$res" | grep '^+CLBS:')"
        tui_set lbs ok "$(echo "$res" | grep '^+CLBS:')"
    else
        log "ATTENZIONE: nessuna risposta valida da AT+CLBS (servizio non abilitato su questa SIM/piano, o timeout): $(echo "$res" | tr '\n' ' ')"
        tui_set lbs ok "nessuna risposta (servizio non abilitato su questa SIM/piano, o timeout)"
    fi
}

# Avvia qcsuper sulla porta Diag (cattura vera e propria). Idempotente
# (QCSUPER_STARTED): puo' essere chiamata sia da force_lte() — cosi' la
# cattura e' gia' attiva PRIMA del ciclo CFUN forzato e ne registra
# l'intera sequenza di re-attach, invece di partire a riconnessione gia'
# avvenuta come accadeva prima — sia dal punto originale nel flusso
# principale (se --force-lte non e' usato, o come rete di sicurezza se lo
# e' ma per qualche motivo non l'ha gia' avviata). Errore fatale (exit 1)
# se qcsuper termina subito dopo l'avvio.
QCSUPER_STARTED=0
start_qcsuper_capture() {
    [[ "$QCSUPER_STARTED" -eq 1 ]] && return 0
    tui_set qcsuper_start running
    # Con --usb-modem: passa a "qcsuper --usb-modem" il VID:PID invece del
    # device path (entrambe le sintassi sono gia' supportate nativamente
    # da qcsuper, vedi il suo --help) — cambia il connettore usato
    # internamente da qcsuper stesso: device path -> UsbModemPyserialConnector
    # (legge la porta seriale un BYTE alla volta, vedi read_loop() in
    # qcsuper/inputs/usb_modem_pyserial.py), VID:PID -> UsbModemPyusbConnector
    # (legge a blocchi da wMaxPacketSize, tipicamente 512 byte, via
    # pyusb/libusb). Non e' qualcosa che mdtcap implementa: sceglie solo
    # quale dei due percorsi, gia' presenti in qcsuper, usare. Ipotesi da
    # verificare sul campo (non ancora confermata in modo conclusivo):
    # potrebbe ridurre gli avvisi "Wrong CRC" su catture con molto
    # traffico diag, se la causa e' un overrun dovuto alla lettura
    # byte-a-byte sotto carico — vedi "Warning diag port"/compute_diag_warn_count().
    local usb_modem_arg="$DIAG_PORT"
    [[ "$USB_MODEM_MODE" -eq 1 ]] && usb_modem_arg="${USB_MODEM_VID}:${USB_MODEM_PID}"
    log "Avvio qcsuper su $usb_modem_arg$( [[ "$USB_MODEM_MODE" -eq 1 ]] && echo " (--usb-modem: VID:PID invece del device path $DIAG_PORT)" )..."
    "${QCSUPER_CMD[@]}" --usb-modem "$usb_modem_arg" \
        --dlf-dump "$DLF_FILE" \
        --pcap-dump "$PCAP_FILE" \
        --reassemble-sibs --decrypt-nas \
        > "$QCSUPER_LOG" 2>&1 &
    QCSUPER_PID=$!
    sleep 2
    if ! kill -0 "$QCSUPER_PID" 2>/dev/null; then
        log --show "ERRORE: qcsuper è terminato subito, controlla $QCSUPER_LOG"
        tui_set qcsuper_start error "vedi $QCSUPER_LOG"
        cat "$QCSUPER_LOG" >&2
        exit 1
    fi
    log "qcsuper avviato (PID $QCSUPER_PID)"
    tui_set qcsuper_start ok "PID $QCSUPER_PID"
    # "Warning diag port" resta "pending" (grigio) fino a qui (nessuna
    # porta diag aperta prima d'ora): da questo momento in poi lo
    # aggiorna il logger periodico (vedi piu' sotto), leggendo
    # $TUI_DIAG_STATUS_FILE via tui_refresh_live_status().
    tui_set diag_status ok "0"
    tui_set diag_error_status ok "0"
    CAPTURE_START_EPOCH=$(date +%s)
    log "Nota: su Raspberry Pi il solo import del modulo ASN.1 (pycrate) impiega tipicamente 10-20s prima che la cattura effettiva inizi; evita stop/durate troppo brevi."
    QCSUPER_STARTED=1
}

# Metriche tshark condivise fra generate_final_report/generate_plain_report
# E manifest.json (vedi generate_manifest_json piu' sotto): calcolate UNA
# SOLA VOLTA da compute_mdt_metrics() in run_analysis_and_report() (queste
# query tshark non sono gratuite, specie su Raspberry Pi), poi lette da
# tutte e tre le funzioni invece di essere ricalcolate ciascuna per conto
# proprio (come facevano generate_final_report/generate_plain_report in
# una versione precedente dello script).
MET_TOTAL_FRAMES=0
MET_LTE_FRAMES=0
MET_MDT_CONFIG=0      # solo loggedMeasurementConfiguration (MDT_LOGGED_CONFIG_FILTER)
MET_MDT_REQ=0         # loggedMeasurementConfiguration OR ueInformationRequest (MDT_REQUEST_ONLY_FILTER)
MET_MDT_ANY=0         # qualunque IE MDT, incluse le risposte (MDT_RRC_FILTER)
MET_RRC_RESP=0        # risposte UE (MDT_RESPONSE_ONLY_FILTER)
MET_RRC_RESP_GPS=0    # ...con posizione
MET_RRC_RESP_NOGPS=0  # ...senza posizione
MET_ATTIVA_HITS=0     # richieste esplicite di invio misure (logMeasReportReq_r10)

compute_mdt_metrics() {
    if command -v tshark >/dev/null 2>&1 && [[ -s "$PCAP_FILE" ]]; then
        MET_TOTAL_FRAMES=$(tshark -r "$PCAP_FILE" 2>/dev/null | wc -l)
        MET_LTE_FRAMES=$(tshark -r "$PCAP_FILE" -Y "lte_rrc" 2>/dev/null | wc -l)
        MET_MDT_CONFIG=$(tshark -r "$PCAP_FILE" -Y "$MDT_LOGGED_CONFIG_FILTER" 2>/dev/null | wc -l)
        MET_MDT_REQ=$(tshark -r "$PCAP_FILE" -Y "$MDT_REQUEST_ONLY_FILTER" 2>/dev/null | wc -l)
        MET_MDT_ANY=$(tshark -r "$PCAP_FILE" -Y "$MDT_RRC_FILTER" 2>/dev/null | wc -l)
        MET_RRC_RESP=$(tshark -r "$PCAP_FILE" -Y "$MDT_RESPONSE_ONLY_FILTER" 2>/dev/null | wc -l)
        MET_RRC_RESP_GPS=$(tshark -r "$PCAP_FILE" -Y "($MDT_RESPONSE_ONLY_FILTER) and ($MDT_LOCATION_INFO_FILTER)" 2>/dev/null | wc -l)
        MET_RRC_RESP_NOGPS=$((MET_RRC_RESP - MET_RRC_RESP_GPS))
        MET_ATTIVA_HITS=$(tshark -r "$PCAP_FILE" -Y "lte-rrc.logMeasReportReq_r10" 2>/dev/null | wc -l)
    fi
}

# Numero di avvisi (livello WARNING) scritti da qcsuper in qcsuper.log
# durante l'intera cattura live — letto da generate_final_report(),
# generate_manifest_json() (campo "diagWarn") e, con --shm, dal file
# "diagWarn". Calcolato UNA SOLA VOLTA da run_analysis_and_report(),
# accanto a compute_mdt_metrics(), sul $QCSUPER_LOG ormai completo (la
# cattura e' gia' terminata a questo punto).
#
# "| WARNING @ " combacia con QUALUNQUE avviso di livello WARNING emesso
# da un modulo di qcsuper (stesso formato per tutti: vedi basicConfig() in
# qcsuper/main.py) — nella pratica solo avvisi legati ai DATI ricevuti
# dalla porta Diag: frame HDLC scartati per CRC errato
# (_hdlc_mixin.py, il caso piu' comune — vedi la GUIDA per il significato
# di "Wrong CRC"), frame diag vuoti/troppo corti
# (usb_modem_pyusb.py). MAI un avviso come "eseguire questo comando come
# root e' pericoloso": quello lo stampa tshark (non qcsuper) durante
# l'estrazione successiva, finisce in tshark_report.err — un file
# diverso, mai contato qui.
#
# Assente in modalita' replay (--analyze-dlf/--analyze-pcap): qcsuper.log
# non esiste in quel caso (nessuna cattura live, nessuna porta Diag
# coinvolta - vedi tabella file nella GUIDA), DIAG_WARN_COUNT resta 0
# come da schema.
DIAG_WARN_COUNT=0
compute_diag_warn_count() {
    DIAG_WARN_COUNT=0
    [[ -s "$QCSUPER_LOG" ]] || return 0
    DIAG_WARN_COUNT=$(grep -c -- '| WARNING @ ' "$QCSUPER_LOG" 2>/dev/null) || DIAG_WARN_COUNT=0
}

# Come DIAG_WARN_COUNT/compute_diag_warn_count() sopra, ma per le righe di
# livello ERROR (mai contate da "| WARNING @ ", quindi prima d'ora
# INVISIBILI in report_finale.txt/manifest.json/--shm: "Warning diag port"
# restava "0" anche con un ERROR reale in qcsuper.log). Trovato sul campo:
# un timeout di "DIAG_LOG_CONFIG_F" (qcsuper/modules/_enable_log_mixin.py,
# la richiesta con cui qcsuper abilita sul modem i log tipo
# LOG_LTE_NAS_EMM_OTA_* usati da SMSSTK.silent_sms/--test-sms) produce
# esattamente una riga "| ERROR @ _base_input.py:..." in qcsuper.log, MAI
# una "| WARNING @ ", lasciando "Warning diag port: 0" nel report anche se
# quella cattura non ha mai potuto vedere traffico NAS EMM — da qui questo
# contatore separato, per rendere visibile il problema invece di doverlo
# scoprire leggendo qcsuper.log a mano.
DIAG_ERROR_COUNT=0
compute_diag_error_count() {
    DIAG_ERROR_COUNT=0
    [[ -s "$QCSUPER_LOG" ]] || return 0
    DIAG_ERROR_COUNT=$(grep -c -- '| ERROR @ ' "$QCSUPER_LOG" 2>/dev/null) || DIAG_ERROR_COUNT=0
}

# Scansione euristica a livello di bit (src/mdt_bitscan.py) per posizioni
# GPS/setup MDT che potrebbero essere sfuggiti alla catena normale
# qcsuper -> pcap -> tshark — vedi il commento "warnPosD/warnPosL/
# warnMDTD/warnMDTL" in testa allo script per la spiegazione completa dei
# 4 valori e del perche' servano DUE riletture indipendenti (D = .dlf, L =
# frame scartati per CRC errato ricostruiti da qcsuper.log). Chiamata da
# run_analysis_and_report() subito dopo compute_diag_warn_count(): gira
# SOLO se DIAG_WARN_COUNT > 0 (nessun avviso diag = nessun sospetto di
# dato perso, non ha senso spendere il tempo della scansione), altrimenti
# i 4 valori restano 0 e mdt_bitscan_report.txt viene comunque creato
# (vuoto salvo una nota) cosi' l'elenco file dell'outdir resta lo stesso a
# prescindere da cosa e' successo in questa cattura.
WARN_POS_D=0
WARN_POS_L=0
WARN_MDT_D=0
WARN_MDT_L=0
compute_bitscan_warnings() {
    WARN_POS_D=0
    WARN_POS_L=0
    WARN_MDT_D=0
    WARN_MDT_L=0
    local bitscan_report="$OUTDIR/mdt_bitscan_report.txt"

    if [[ "$DIAG_WARN_COUNT" -eq 0 ]]; then
        echo "Scansione byte non eseguita: nessun avviso WARNING di qcsuper in questa cattura (Warning diag port: 0)." > "$bitscan_report"
        return 0
    fi
    if [[ ! -f "$BITSCAN_SCRIPT" ]]; then
        log "ATTENZIONE: $BITSCAN_SCRIPT non trovato, scansione byte per posizione/MDT nascosti saltata."
        echo "Scansione byte non eseguita: $BITSCAN_SCRIPT non trovato." > "$bitscan_report"
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        log "ATTENZIONE: python3 non disponibile, scansione byte per posizione/MDT nascosti saltata."
        echo "Scansione byte non eseguita: python3 non disponibile." > "$bitscan_report"
        return 0
    fi

    # MCC/MNC di rete: stessa fonte (context_post/pre.txt via AT+CPSI) e
    # stessa logica di estrazione usate da generate_manifest_json() per il
    # campo "mcc"/"mnc" del manifest — richiamata qui a parte perche'
    # questa funzione gira PRIMA di generate_manifest_json() (i suoi
    # risultati vanno nello stesso manifest.json, vedi piu' sotto).
    local ctx_file="" mcc="" mnc="" cpsi_line mccmnc
    if [[ -s "$CTX_POST" ]]; then
        ctx_file="$CTX_POST"
    elif [[ -s "$CTX_PRE" ]]; then
        ctx_file="$CTX_PRE"
    fi
    if [[ -n "$ctx_file" ]]; then
        cpsi_line=$(ctx_section "$ctx_file" '^## AT\+CPSI' | grep -E '^\+CPSI:' | head -n1)
        mccmnc=$(echo "$cpsi_line" | sed -E 's/^\+CPSI:[[:space:]]*[^,]+,[^,]+,([0-9]+)-([0-9]+),.*/\1 \2/')
        if [[ -n "$cpsi_line" && "$mccmnc" != "$cpsi_line" ]]; then
            mcc=$(echo "$mccmnc" | cut -d' ' -f1)
            mnc=$(echo "$mccmnc" | cut -d' ' -f2)
        fi
    fi

    local bitscan_out
    if ! bitscan_out=$(python3 "$BITSCAN_SCRIPT" \
        --dlf "$DLF_FILE" \
        --qcsuper-log "$QCSUPER_LOG" \
        --gps-csv "$PERIODIC_DECODED_CSV" \
        --lat-margin "$LAT_MARGIN" --lon-margin "$LON_MARGIN" \
        --mcc "$mcc" --mnc "$mnc" \
        --bbox-dir "$GPS_BBOX_DIR" \
        --report "$bitscan_report" 2>>"$SESSION_LOG"); then
        log "ATTENZIONE: scansione byte per posizione/MDT nascosti fallita (vedi $SESSION_LOG e $bitscan_report)."
        return 0
    fi

    local key val
    while IFS='=' read -r key val; do
        case "$key" in
            warnPosD) WARN_POS_D="$val" ;;
            warnPosL) WARN_POS_L="$val" ;;
            warnMDTD) WARN_MDT_D="$val" ;;
            warnMDTL) WARN_MDT_L="$val" ;;
        esac
    done <<< "$bitscan_out"
    log "Scansione byte completata: warnPosD=$WARN_POS_D warnPosL=$WARN_POS_L warnMDTD=$WARN_MDT_D warnMDTL=$WARN_MDT_L (dettaglio in $bitscan_report)"
}

# Estrae da context_post.txt (o context_pre.txt se il primo manca) IMEI/
# ICCID/MCC/MNC e calcola il contractId — condivisi fra
# generate_final_report() (riga "Autorizzazione IMEI:", sotto) e
# generate_manifest_json() (campi "imei"/"iccid"/"mcc"/"mnc"/
# "contractId"): calcolati QUI una sola volta, invece che due volte come
# in una versione precedente di questo script (una chiamata a
# mdtcontract in meno). Popola anche IMEI_AUTH_STRING: se l'IMEI letto
# ora e' diverso da quello ORIGINALE salvato in mdt_configs/imei (vedi
# ensure_imei_backup(), stesso file condiviso con mdtimei —
# segno che l'IMEI e' stato cambiato, presumibilmente con mdtimei,
# prima di questa cattura), verifica con src/testauth se esiste
# un'autorizzazione valida per QUESTO device/ICCID/IMEI/contractId e, se
# si', ne salva la stringa AUTH restituita. Solo informativo: mdtcap non
# blocca mai la cattura in base a questo (l'eventuale gate e' compito di
# mdtimei, non suo) — si limita a documentare nel report/nei log se
# un'autorizzazione valida esiste per l'IMEI effettivamente in uso.
CTX_IMEI=""
CTX_ICCID=""
CTX_MCC=""
CTX_MNC=""
CTX_CONTRACT_ID=""
IMEI_AUTH_STRING=""
compute_imei_context() {
    CTX_IMEI=""
    CTX_ICCID=""
    CTX_MCC=""
    CTX_MNC=""
    CTX_CONTRACT_ID=""
    IMEI_AUTH_STRING=""

    local ctx_file="" cpsi_line mccmnc
    if [[ -s "$CTX_POST" ]]; then
        ctx_file="$CTX_POST"
    elif [[ -s "$CTX_PRE" ]]; then
        ctx_file="$CTX_PRE"
    fi
    if [[ -n "$ctx_file" ]]; then
        CTX_IMEI=$(ctx_section "$ctx_file" '^## AT\+CGSN' | grep -E '^[0-9]{14,16}$' | head -n1)
        CTX_ICCID=$(ctx_section "$ctx_file" '^## AT\+CCID' | grep -E '^\+I?CCID:' | sed -E 's/^\+I?CCID:[[:space:]]*//' | head -n1)
        cpsi_line=$(ctx_section "$ctx_file" '^## AT\+CPSI' | grep -E '^\+CPSI:' | head -n1)
        mccmnc=$(echo "$cpsi_line" | sed -E 's/^\+CPSI:[[:space:]]*[^,]+,[^,]+,([0-9]+)-([0-9]+),.*/\1 \2/')
        if [[ -n "$cpsi_line" && "$mccmnc" != "$cpsi_line" ]]; then
            CTX_MCC=$(echo "$mccmnc" | cut -d' ' -f1)
            CTX_MNC=$(echo "$mccmnc" | cut -d' ' -f2)
        fi
    fi

    if [[ -n "$CTX_ICCID" && -x "$MDTCONTRACT_BIN" ]]; then
        CTX_CONTRACT_ID=$("$MDTCONTRACT_BIN" "$CTX_ICCID" 2>>"$SESSION_LOG") || {
            log "ATTENZIONE: mdtcontract non ha prodotto un contractId (vedi $SESSION_LOG)."
            CTX_CONTRACT_ID=""
        }
    fi

    [[ -n "$CTX_IMEI" && -f "$IMEI_FILE" ]] || return 0
    local default_imei
    default_imei=$(cat "$IMEI_FILE" 2>/dev/null)
    [[ -n "$default_imei" && "$CTX_IMEI" != "$default_imei" ]] || return 0

    if { [[ -x "$TESTAUTH_BIN" ]] || [[ -f "$TESTAUTH_BIN" ]]; } && command -v python3 >/dev/null 2>&1; then
        local devid
        devid=$("$MDTCONTRACT_BIN" --get-devid 2>>"$SESSION_LOG") || devid=""
        if [[ -n "$devid" ]]; then
            IMEI_AUTH_STRING=$("$TESTAUTH_BIN" \
                --DEVID "$devid" --ICCID "$CTX_ICCID" --IMEI "$CTX_IMEI" --CONTRACT "$CTX_CONTRACT_ID" \
                2>>"$SESSION_LOG") || IMEI_AUTH_STRING=""
        fi
    fi

    if [[ -n "$IMEI_AUTH_STRING" ]]; then
        log "IMEI ($CTX_IMEI) diverso dall'originale ($default_imei): autorizzazione trovata (src/testauth): $IMEI_AUTH_STRING"
    else
        log "ATTENZIONE: IMEI ($CTX_IMEI) diverso dall'originale ($default_imei) ma nessuna autorizzazione valida trovata (src/testauth) — vedi $SESSION_LOG per il dettaglio."
    fi
}

# Traduce un livello I/W/C/A (src/extra_scan) nello stato TUI corrispondente
# (vedi tui_line()/TUI_C_DARKRED sopra): "vale il piu' alto nella categoria",
# gia' garantito da extra_scan stesso (le righe "<CAT>_L=" che restituisce
# sono gia' il livello piu' alto fra le regole di quella categoria).
extra_status_for_level() {
    case "$1" in
        A) echo extra_a ;;
        C) echo extra_c ;;
        W) echo extra_w ;;
        *) echo extra_i ;;
    esac
}

# "Controlli extra" (--extended, vedi src/extra_scan e il commento
# --extended in testa allo script): chiamata da run_analysis_and_report()
# subito dopo compute_imei_context() e PRIMA di generate_final_report()/
# generate_manifest_json()/dell'hashing SHA-256 (cosi' i file che scrive
# finiscono nella catena di custodia — vedi la whitelist esplicita passata
# a sha256sum piu' sotto). No-op fail-soft se --extended non e' stato
# richiesto, o se src/extra_scan/python3 non sono disponibili: le 6
# categorie restano al livello "I" di default, senza errore.
EXTRA_L_SMSSTK="I"; EXTRA_N_SMSSTK=0
EXTRA_L_NASID="I"; EXTRA_N_NASID=0
EXTRA_L_RRCCIPH="I"; EXTRA_N_RRCCIPH=0
EXTRA_L_CELLSYS="I"; EXTRA_N_CELLSYS=0
EXTRA_L_GPSLOC="I"; EXTRA_N_GPSLOC=0
EXTRA_L_WCDMA3G="I"; EXTRA_N_WCDMA3G=0
EXTRA_LEVEL="I"
compute_extra_scan() {
    local extra_report="$OUTDIR/extra_scan_report.txt"

    [[ "$EXTENDED" -eq 1 ]] || return 0

    tui_set extra_scan running

    if [[ ! -f "$EXTRA_SCAN_SCRIPT" ]]; then
        log "ATTENZIONE: $EXTRA_SCAN_SCRIPT non trovato, scansione extra saltata."
        echo "Scansione extra non eseguita: $EXTRA_SCAN_SCRIPT non trovato." > "$extra_report"
        tui_set extra_scan skip "script non trovato"
        return 0
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        log "ATTENZIONE: python3 non disponibile, scansione extra saltata."
        echo "Scansione extra non eseguita: python3 non disponibile." > "$extra_report"
        tui_set extra_scan skip "python3 non disponibile"
        return 0
    fi

    local -a op_args=()
    if [[ -n "$OP_NAME" ]]; then
        op_args=(--op "$OP_NAME")
    elif [[ -n "$CTX_MCC" && -n "$CTX_MNC" ]]; then
        op_args=(--mcc "$CTX_MCC" --mnc "$CTX_MNC")
    fi
    local -a test_sms_args=()
    [[ "$TEST_SMS" -eq 1 ]] && test_sms_args=(--test-sms)

    local extra_out
    if ! extra_out=$(python3 "$EXTRA_SCAN_SCRIPT" \
        "${op_args[@]}" \
        ${EXT_PROFILE:+--profile "$EXT_PROFILE"} \
        --configs-dir "$EXTRA_CONFIGS_DIR" \
        --file "$DLF_FILE" --out "$OUTDIR" \
        "${test_sms_args[@]}" 2>>"$SESSION_LOG"); then
        log "ATTENZIONE: scansione extra fallita (vedi $SESSION_LOG e $extra_report)."
        tui_set extra_scan error "vedi session.log"
        return 0
    fi

    local key val
    while IFS='=' read -r key val; do
        case "$key" in
            SMSSTK_L) EXTRA_L_SMSSTK="$val" ;;
            SMSSTK_N) EXTRA_N_SMSSTK="$val" ;;
            NASId_L) EXTRA_L_NASID="$val" ;;
            NASId_N) EXTRA_N_NASID="$val" ;;
            RRCCiph_L) EXTRA_L_RRCCIPH="$val" ;;
            RRCCiph_N) EXTRA_N_RRCCIPH="$val" ;;
            cellSys_L) EXTRA_L_CELLSYS="$val" ;;
            cellSys_N) EXTRA_N_CELLSYS="$val" ;;
            GPSLoc_L) EXTRA_L_GPSLOC="$val" ;;
            GPSLoc_N) EXTRA_N_GPSLOC="$val" ;;
            WCDMA3G_L) EXTRA_L_WCDMA3G="$val" ;;
            WCDMA3G_N) EXTRA_N_WCDMA3G="$val" ;;
            extraLevel) EXTRA_LEVEL="$val" ;;
        esac
    done <<< "$extra_out"

    tui_set "extra_cat_SMSSTK" "$(extra_status_for_level "$EXTRA_L_SMSSTK")" "$EXTRA_L_SMSSTK ($EXTRA_N_SMSSTK evento/i)"
    tui_set "extra_cat_NASId" "$(extra_status_for_level "$EXTRA_L_NASID")" "$EXTRA_L_NASID ($EXTRA_N_NASID evento/i)"
    tui_set "extra_cat_RRCCiph" "$(extra_status_for_level "$EXTRA_L_RRCCIPH")" "$EXTRA_L_RRCCIPH ($EXTRA_N_RRCCIPH evento/i)"
    tui_set "extra_cat_cellSys" "$(extra_status_for_level "$EXTRA_L_CELLSYS")" "$EXTRA_L_CELLSYS ($EXTRA_N_CELLSYS evento/i)"
    tui_set "extra_cat_GPSLoc" "$(extra_status_for_level "$EXTRA_L_GPSLOC")" "$EXTRA_L_GPSLOC ($EXTRA_N_GPSLOC evento/i)"
    tui_set "extra_cat_WCDMA3G" "$(extra_status_for_level "$EXTRA_L_WCDMA3G")" "$EXTRA_L_WCDMA3G ($EXTRA_N_WCDMA3G evento/i)"

    log "Scansione extra completata: extraLevel=$EXTRA_LEVEL (dettaglio in $extra_report)"
    tui_set extra_scan ok "extraLevel=$EXTRA_LEVEL"
}

# Genera (stampa + salva in report_finale.txt) il riepilogo sintetico
# richiesto da --report. Vedi il commento --report in testa allo script
# per il significato di ciascun campo e le assunzioni fatte per "GPS"/
# "Attiva" nel campo Operatore. Chiamata da finalize() solo se --report;
# presuppone che compute_mdt_metrics() sia gia' stata chiamata (usa i
# valori MET_* condivisi, vedi sopra).
generate_final_report() {
    local total_frames="$MET_TOTAL_FRAMES" lte_frames="$MET_LTE_FRAMES" mdt_req="$MET_MDT_REQ"
    local rrc_resp="$MET_RRC_RESP" rrc_resp_gps="$MET_RRC_RESP_GPS" rrc_resp_nogps="$MET_RRC_RESP_NOGPS"
    local attiva_hits="$MET_ATTIVA_HITS" diag_warn="$DIAG_WARN_COUNT" diag_error="$DIAG_ERROR_COUNT"
    local warn_pos_d="$WARN_POS_D" warn_pos_l="$WARN_POS_L" warn_mdt_d="$WARN_MDT_D" warn_mdt_l="$WARN_MDT_L"
    local imei_auth="$IMEI_AUTH_STRING"
    local test_status operatore_field ue_field risultato
    local eck lvar nvar

    if (( lte_frames > 0 )); then
        test_status="OK"
    else
        test_status="ERRORE (nessun traffico LTE-RRC rilevato nella cattura)"
    fi

    if (( mdt_req > 0 )); then
        local op_parts=("MDT")
        (( rrc_resp_gps > 0 )) && op_parts+=("GPS")
        (( attiva_hits > 0 )) && op_parts+=("Attiva")
        operatore_field=$(printf '%s, ' "${op_parts[@]}")
        operatore_field=${operatore_field%, }
    else
        operatore_field="OK"
    fi

    if (( rrc_resp_gps > 0 )); then
        ue_field="GPS"
    else
        ue_field="OK"
    fi

    if [[ "$test_status" != "OK" ]]; then
        risultato="Il test non e' andato a buon fine."
    elif (( total_frames == 0 )); then
        risultato="Non ci sono dati sufficienti (nessuna risposta RRC di alcun tipo)."
    else
        if (( mdt_req > 0 )); then
            if (( rrc_resp_gps > 0 )); then
                risultato="L'operatore richiede MDT (con posizione)."
            else
                risultato="L'operatore richiede MDT (senza posizione)."
            fi
        else
            risultato="Nessuna richiesta MDT pervenuta dall'operatore."
        fi
        if (( rrc_resp > 0 )); then
            if (( rrc_resp_gps > 0 )); then
                risultato="$risultato L'UE risponde con la posizione."
            else
                risultato="$risultato L'UE risponde senza la posizione."
            fi
        fi
    fi

    {
        echo "Test: $test_status"
        echo "Operatore: $operatore_field"
        echo "UE: $ue_field"
        echo "RRC: $rrc_resp ($rrc_resp_gps con posizione GPS, $rrc_resp_nogps senza)"
        echo "MDT: $mdt_req"
        echo "Warning diag port: $diag_warn"
        echo "Errori diag port: $diag_error"
        (( diag_error > 0 )) && echo "  ATTENZIONE: qcsuper.log contiene errori (non solo warning) durante questa cattura. Controllare qcsuper.log: un tipo di log diag potrebbe non essere stato abilitato (es. traffico SMS/NAS invisibile a SMSSTK/--test-sms pur essendo arrivato realmente)."
        echo "Warning posizione (diag): $warn_pos_d"
        echo "Warning posizione (log): $warn_pos_l"
        echo "Warning MDT (diag): $warn_mdt_d"
        echo "Warning MDT (log): $warn_mdt_l"
        [[ -n "$imei_auth" ]] && echo "Autorizzazione IMEI: $imei_auth"
        echo "Risultato: $risultato"
        # "Controlli extra:" (--extended, vedi src/extra_scan): etichette
        # SEMPRE presenti se extra_scan_get_defs() le ha risolte all'avvio
        # (vedi li' sopra), indipendentemente da --extended — con i
        # livelli/conteggi effettivi solo se --extended era attivo per
        # QUESTA cattura, altrimenti solo le intestazioni (nessun valore).
        if (( ${#EXTRA_SCAN_DEFS_ORDER[@]} > 0 )); then
            echo
            echo "Controlli extra:"
            if [[ "$EXTENDED" -eq 1 ]]; then
                echo "  extraLevel: $EXTRA_LEVEL"
                [[ "$TEST_SMS" -eq 1 ]] && echo "  Test SMS attivo: si' (--test-sms, vedi eventuali categorie forzate ad A sotto)"
                for eck in "${EXTRA_SCAN_DEFS_ORDER[@]}"; do
                    lvar="EXTRA_L_${eck^^}"
                    nvar="EXTRA_N_${eck^^}"
                    echo "  ${EXTRA_SCAN_DEFS[$eck]} ($eck): ${!lvar} (${!nvar} evento/i)"
                done
            else
                for eck in "${EXTRA_SCAN_DEFS_ORDER[@]}"; do
                    echo "  ${EXTRA_SCAN_DEFS[$eck]} ($eck): non richiesto (--extended non specificato)"
                done
            fi
        fi
    } > "$OUTDIR/report_finale.txt"

    log "=== Report finale ==="
    while IFS= read -r line; do log "$line"; done < "$OUTDIR/report_finale.txt"
    return 0
}

# Genera (stampa + aggiunge a report_finale.txt) la riga "Risultato: ..."
# in linguaggio semplice richiesta da --parla-chiaro. Vedi il commento
# --parla-chiaro in testa allo script per le quattro frasi possibili e la
# logica con cui vengono scelte. Funziona anche senza --report (usa i
# valori MET_* condivisi calcolati da compute_mdt_metrics(), vedi sopra —
# non serve che generate_final_report sia stata chiamata prima); se
# report_finale.txt esiste gia' (perche' --report l'ha scritto prima), la
# riga viene accodata con un separatore.
generate_plain_report() {
    # NB su "attiva_hits" qui sotto: basta DA SOLO a far scattare "Stacca
    # stacca", indipendentemente dal fatto che la risposta dell'UE in
    # QUESTA cattura includa o no una posizione. Non e' una svista: il
    # banco di prova qui e' un modem/SIM isolato, non il telefono che
    # userebbe davvero l'utente finale — un UE diverso (un normale
    # smartphone, con la localizzazione attiva) potrebbe rispondere alla
    # STESSA richiesta della rete (logMeasReportReq_r10) includendo la
    # posizione. E' quindi la richiesta esplicita della rete in se' —
    # segno di intenzione di ottenere la posizione — il segnale
    # rilevante, non se questo particolare UE di test l'abbia riportata o
    # no in questa specifica cattura.
    local total_frames="$MET_TOTAL_FRAMES" lte_frames="$MET_LTE_FRAMES"
    local rrc_resp_gps="$MET_RRC_RESP_GPS" attiva_hits="$MET_ATTIVA_HITS" frase

    if (( lte_frames == 0 )); then
        frase="Qualcosa e' andato storto."
    elif (( total_frames == 0 )); then
        frase="Non lo so, mi serve piu' tempo."
    elif (( rrc_resp_gps > 0 || attiva_hits > 0 )); then
        frase="Stacca, stacca, stacca, ti stanno tracciando!"
    else
        frase="Tutto bene."
        # Il verdetto "Tutto bene" si basa solo su cio' che tshark ha
        # decodificato dal pcap: se qcsuper ha scartato dei frame per CRC
        # errato durante questa cattura (Warning diag port > 0), quel
        # verdetto non tiene conto di quanto sia potuto sfuggire in quei
        # frame — vedi compute_bitscan_warnings()/warnPosD-L/warnMDTD-L per
        # il tentativo di recupero. Va quindi attenuato con un avviso,
        # indipendentemente dal fatto che la scansione abbia poi trovato
        # qualcosa: e' il rischio di aver perso dati che conta qui, non il
        # risultato della scansione stessa.
        (( DIAG_WARN_COUNT > 0 )) && frase="Sembra tutto apposto, ma c'è tanto rumore."
    fi
    PLAIN_REPORT_FRASE="$frase"

    if [[ -s "$OUTDIR/report_finale.txt" ]]; then
        { echo; echo "--- Parla chiaro ---"; echo "Risultato: $frase"; } >> "$OUTDIR/report_finale.txt"
    else
        echo "Risultato: $frase" > "$OUTDIR/report_finale.txt"
    fi

    log "=== Parla chiaro ==="
    log "Risultato: $frase"
    return 0
}

# Legge il blocco di righe della sezione "## <header_re>" in un file di
# contesto AT (vedi dump_context()), fino alla sezione "## " successiva o
# a fine file, header escluso. Usata da generate_manifest_json() per
# estrarre IMEI/ICCID/MCC/MNC senza dover riaprire la porta AT (a questo
# punto e' gia' chiusa da finalize(), prima di chiamare
# run_analysis_and_report()).
ctx_section() {
    local file="$1" header_re="$2"
    [[ -r "$file" ]] || return 1
    awk -v hdr="$header_re" '$0 ~ hdr {f=1; next} f && /^## /{exit} f' "$file"
}

# Genera manifest.json — formato STRUTTURATO (a differenza di
# manifest.txt/report_finale.txt, pensati per la lettura umana) per
# consumo automatico da parte di script esterni. Chiamata SEMPRE (non
# solo con --report/--parla-chiaro), da run_analysis_and_report() subito
# dopo compute_mdt_metrics(): presuppone i valori MET_* condivisi gia'
# calcolati. Scrive anche i file di stato --shm, se richiesto (vedi in
# fondo alla funzione).
#
# IMEI/ICCID/MCC/MNC vengono letti da context_post.txt (o context_pre.txt
# se il primo manca, es. cattura interrotta molto presto) invece di
# interrogare di nuovo il modem: la porta AT e' gia' chiusa a questo
# punto. In modalita' replay (--analyze-dlf/--analyze-pcap) nessuno dei
# due file esiste (nessun device coinvolto): questi campi restano vuoti,
# come da schema.
#
# NB su due scelte non ovvie dallo schema JSON da solo (documentate qui
# perche' non derivabili da un singolo IE RRC):
#   - "OK": rispecchia lo stesso criterio di "Test:" in report_finale.txt
#     (traffico LTE-RRC rilevato) — e' il segnale disponibile a questo
#     punto dell'esecuzione, dato che un fallimento piu' a monte (es.
#     --require-lte non soddisfatto) fa gia' uscire lo script prima di
#     arrivare qui.
#   - "reqMDTPos"/"reqMDTGPS": nessun IE RRC distingue esplicitamente
#     "vuole la posizione" da "vuole l'attivazione del GPS" (la
#     grammatica LTE-RRC non lo prevede, l'inclusione della posizione nel
#     logging e' decisa dall'UE, non comandata dalla rete via RRC) — qui
#     reqMDTPos rispecchia la richiesta ESPLICITA di invio misure
#     (logMeasReportReq, lo stesso segnale di "Attiva"/--parla-chiaro) e
#     reqMDTGPS rispecchia la presenza di QUALUNQUE configurazione/
#     richiesta MDT (loggedMeasurementConfiguration e/o
#     ueInformationRequest). Rivedere se emerge una definizione piu'
#     precisa.
generate_manifest_json() {
    # imei/iccid/mcc/mnc/contract_id: gia' calcolati da
    # compute_imei_context() (chiamata da run_analysis_and_report()
    # prima di questa funzione) — riusati qui cosi' come sono, invece di
    # rileggere il contesto/richiamare mdtcontract una seconda volta.
    local imei="$CTX_IMEI" iccid="$CTX_ICCID" mcc="$CTX_MCC" mnc="$CTX_MNC" contract_id="$CTX_CONTRACT_ID"

    # Id hardware/device di QUESTA macchina (non del modem): "machineId" e
    # "hwId" sono due campi distinti nello schema, con fallback DIVERSI da
    # quello (piu' ampio, con /etc/machine-id incluso) usato internamente
    # da mdtcontract per il contractId — vedi mdtcontract --help.
    local hwid="" machine_id=""
    [[ -r /proc/device-tree/serial-number ]] && hwid=$(tr -d '\0' < /proc/device-tree/serial-number 2>/dev/null)
    [[ -z "$hwid" && -r /sys/class/dmi/id/product_uuid ]] && hwid=$(cat /sys/class/dmi/id/product_uuid 2>/dev/null)
    [[ -r /etc/machine-id ]] && machine_id=$(cat /etc/machine-id 2>/dev/null)

    local lte=false gps=false ok=false miss=false hasmdt=false reqpos=false reqgps=false hasrrc=false hasrrcpos=false
    (( MET_LTE_FRAMES > 0 )) && lte=true
    [[ "$GPS_FIX_OBTAINED" -eq 1 ]] && gps=true
    (( MET_LTE_FRAMES > 0 )) && ok=true
    [[ -n "$PCAP_COMPLETENESS_NOTE" ]] && miss=true
    (( MET_MDT_ANY > 0 )) && hasmdt=true
    (( MET_ATTIVA_HITS > 0 )) && reqpos=true
    (( MET_MDT_REQ > 0 )) && reqgps=true
    (( MET_RRC_RESP > 0 )) && hasrrc=true
    (( MET_RRC_RESP_GPS > 0 )) && hasrrcpos=true

    # Durata EFFETTIVA (avvio -> arresto di qcsuper, CAPTURE_START_EPOCH/
    # CAPTURE_END_EPOCH sono valorizzati in ogni cattura live, con o senza
    # --duration), non quella CONFIGURATA con --duration: una cattura
    # interrotta in anticipo (Ctrl+C, o "mdtStop" con --shm) deve
    # riportare quanto e' durata DAVVERO, non il tetto massimo richiesto.
    # $DURATION resta un fallback per l'unico caso in cui gli epoch non
    # sono disponibili (nessuna cattura live avvenuta, es. modalita'
    # replay: li' resta comunque 0, dato che --duration non si applica).
    local length=0
    if [[ -n "$CAPTURE_START_EPOCH" && -n "$CAPTURE_END_EPOCH" ]]; then
        length=$((CAPTURE_END_EPOCH - CAPTURE_START_EPOCH))
    elif [[ -n "$DURATION" ]]; then
        length="$DURATION"
    fi

    MJ_IMEI="$imei" MJ_MCC="$mcc" MJ_MNC="$mnc" MJ_ICCID="$iccid" \
    MJ_TCR="$(date -u +%s)" MJ_LTE="$lte" MJ_GPS="$gps" MJ_OK="$ok" MJ_MISS="$miss" MJ_LENGTH="$length" \
    MJ_HASMDT="$hasmdt" MJ_NUMMDT="$MET_MDT_CONFIG" MJ_REQPOS="$reqpos" MJ_REQGPS="$reqgps" \
    MJ_HASRRC="$hasrrc" MJ_HASRRCPOS="$hasrrcpos" MJ_NUMRRC="$MET_RRC_RESP" MJ_NUMRRCPOS="$MET_RRC_RESP_GPS" \
    MJ_OP="$OP_NAME" MJ_PROFILE="$PROFILE_NAME" MJ_MACHINEID="$machine_id" MJ_HWID="$hwid" MJ_CONTRACTID="$contract_id" \
    MJ_DIAGWARN="$DIAG_WARN_COUNT" MJ_DIAGERROR="$DIAG_ERROR_COUNT" \
    MJ_WARNPOSD="$WARN_POS_D" MJ_WARNPOSL="$WARN_POS_L" MJ_WARNMDTD="$WARN_MDT_D" MJ_WARNMDTL="$WARN_MDT_L" \
    MJ_EXTENDED="$([[ "$EXTENDED" -eq 1 ]] && echo true || echo false)" MJ_EXTRALEVEL="$EXTRA_LEVEL" \
    MJ_EXT_SMSSTK_L="$EXTRA_L_SMSSTK" MJ_EXT_SMSSTK_N="$EXTRA_N_SMSSTK" \
    MJ_EXT_NASID_L="$EXTRA_L_NASID" MJ_EXT_NASID_N="$EXTRA_N_NASID" \
    MJ_EXT_RRCCIPH_L="$EXTRA_L_RRCCIPH" MJ_EXT_RRCCIPH_N="$EXTRA_N_RRCCIPH" \
    MJ_EXT_CELLSYS_L="$EXTRA_L_CELLSYS" MJ_EXT_CELLSYS_N="$EXTRA_N_CELLSYS" \
    MJ_EXT_GPSLOC_L="$EXTRA_L_GPSLOC" MJ_EXT_GPSLOC_N="$EXTRA_N_GPSLOC" \
    MJ_EXT_WCDMA3G_L="$EXTRA_L_WCDMA3G" MJ_EXT_WCDMA3G_N="$EXTRA_N_WCDMA3G" \
    python3 - "$OUTDIR/manifest.json" <<'PYEOF'
import json, os, sys

def b(name):
    return os.environ.get(name, "") == "true"

def i(name):
    try:
        return int(os.environ.get(name, "0"))
    except ValueError:
        return 0

data = {
    "_type": "MDT/MF",
    "ver": "1.0",
    "imei": os.environ.get("MJ_IMEI", ""),
    "mcc": os.environ.get("MJ_MCC", ""),
    "mnc": os.environ.get("MJ_MNC", ""),
    "iccid": os.environ.get("MJ_ICCID", ""),
    "tcr": i("MJ_TCR"),
    "lte": b("MJ_LTE"),
    "gps": b("MJ_GPS"),
    "OK": b("MJ_OK"),
    "miss": b("MJ_MISS"),
    "length": i("MJ_LENGTH"),
    "hasMDT": b("MJ_HASMDT"),
    "numMDT": i("MJ_NUMMDT"),
    "reqMDTPos": b("MJ_REQPOS"),
    "reqMDTGPS": b("MJ_REQGPS"),
    "hasRRC": b("MJ_HASRRC"),
    "hasRRCPos": b("MJ_HASRRCPOS"),
    "numRRC": i("MJ_NUMRRC"),
    "numRRCPox": i("MJ_NUMRRCPOS"),
    "op": os.environ.get("MJ_OP", ""),
    "profile": os.environ.get("MJ_PROFILE", ""),
    "machineId": os.environ.get("MJ_MACHINEID", ""),
    "hwId": os.environ.get("MJ_HWID", ""),
    "contractId": os.environ.get("MJ_CONTRACTID", ""),
    "diagWarn": i("MJ_DIAGWARN"),
    "diagError": i("MJ_DIAGERROR"),
    "warnPosD": i("MJ_WARNPOSD"),
    "warnPosL": i("MJ_WARNPOSL"),
    "warnMDTD": i("MJ_WARNMDTD"),
    "warnMDTL": i("MJ_WARNMDTL"),
}

# "Controlli extra" (--extended, vedi src/extra_scan): campi presenti SOLO
# se --extended era attivo per questa cattura (altrimenti assenti dal
# manifest, non semplicemente vuoti/a zero — coerente con "restano
# vuote/assenti dai valori" del commento --extended in testa a mdtcap).
if b("MJ_EXTENDED"):
    data["extended"] = True
    data["extraLevel"] = os.environ.get("MJ_EXTRALEVEL", "I")
    data["extScanCat"] = {
        "SMSSTK": {"level": os.environ.get("MJ_EXT_SMSSTK_L", "I"), "n": i("MJ_EXT_SMSSTK_N")},
        "NASId": {"level": os.environ.get("MJ_EXT_NASID_L", "I"), "n": i("MJ_EXT_NASID_N")},
        "RRCCiph": {"level": os.environ.get("MJ_EXT_RRCCIPH_L", "I"), "n": i("MJ_EXT_RRCCIPH_N")},
        "cellSys": {"level": os.environ.get("MJ_EXT_CELLSYS_L", "I"), "n": i("MJ_EXT_CELLSYS_N")},
        "GPSLoc": {"level": os.environ.get("MJ_EXT_GPSLOC_L", "I"), "n": i("MJ_EXT_GPSLOC_N")},
        "WCDMA3G": {"level": os.environ.get("MJ_EXT_WCDMA3G_L", "I"), "n": i("MJ_EXT_WCDMA3G_N")},
    }

with open(sys.argv[1], "w") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
PYEOF

    log "manifest.json scritto in $OUTDIR/manifest.json"

    # --- --shm: file di stato per consumo esterno, scritti per ultimi.
    # Rispecchiano gli stessi valori di manifest.json sopra, come 0/1
    # invece che true/false (vedi commento --shm in testa allo script).
    # Eccezione: "diagWarn"/"diagError"/"warnPosD"/"warnPosL"/"warnMDTD"/
    # "warnMDTL" non sono booleani, sono gli stessi interi dei campi
    # omonimi di manifest.json (vedi compute_diag_warn_count()/
    # compute_diag_error_count()/compute_bitscan_warnings()).
    if [[ -n "$SHM_DIR" ]]; then
        printf '%s' "$( [[ "$lte" == true ]] && echo 1 || echo 0 )" > "$SHM_DIR/lte"
        printf '%s' "$( [[ "$gps" == true ]] && echo 1 || echo 0 )" > "$SHM_DIR/gps"
        printf '%s' "$( [[ "$hasmdt" == true ]] && echo 1 || echo 0 )" > "$SHM_DIR/mdt"
        printf '%s' "$( [[ "$reqpos" == true || "$reqgps" == true ]] && echo 1 || echo 0 )" > "$SHM_DIR/mdtPos"
        printf '%s' "$( [[ "$hasrrc" == true ]] && echo 1 || echo 0 )" > "$SHM_DIR/rrc"
        printf '%s' "$( [[ "$hasrrcpos" == true ]] && echo 1 || echo 0 )" > "$SHM_DIR/rrcPos"
        printf '%s' "$contract_id" > "$SHM_DIR/contract"
        printf '%s' "$OUTDIR" > "$SHM_DIR/path"
        printf '%s' "$( [[ "$ok" == true ]] && echo 1 || echo 0 )" > "$SHM_DIR/ok"
        printf '%s' "$DIAG_WARN_COUNT" > "$SHM_DIR/diagWarn"
        printf '%s' "$DIAG_ERROR_COUNT" > "$SHM_DIR/diagError"
        printf '%s' "$WARN_POS_D" > "$SHM_DIR/warnPosD"
        printf '%s' "$WARN_POS_L" > "$SHM_DIR/warnPosL"
        printf '%s' "$WARN_MDT_D" > "$SHM_DIR/warnMDTD"
        printf '%s' "$WARN_MDT_L" > "$SHM_DIR/warnMDTL"
        if [[ "$EXTENDED" -eq 1 ]]; then
            printf '%s' "$EXTRA_LEVEL" > "$SHM_DIR/extraLevel"
            printf '%s' "$EXTRA_L_SMSSTK" > "$SHM_DIR/extra_SMSSTK_L"
            printf '%s' "$EXTRA_N_SMSSTK" > "$SHM_DIR/extra_SMSSTK_N"
            printf '%s' "$EXTRA_L_NASID" > "$SHM_DIR/extra_NASId_L"
            printf '%s' "$EXTRA_N_NASID" > "$SHM_DIR/extra_NASId_N"
            printf '%s' "$EXTRA_L_RRCCIPH" > "$SHM_DIR/extra_RRCCiph_L"
            printf '%s' "$EXTRA_N_RRCCIPH" > "$SHM_DIR/extra_RRCCiph_N"
            printf '%s' "$EXTRA_L_CELLSYS" > "$SHM_DIR/extra_cellSys_L"
            printf '%s' "$EXTRA_N_CELLSYS" > "$SHM_DIR/extra_cellSys_N"
            printf '%s' "$EXTRA_L_GPSLOC" > "$SHM_DIR/extra_GPSLoc_L"
            printf '%s' "$EXTRA_N_GPSLOC" > "$SHM_DIR/extra_GPSLoc_N"
            printf '%s' "$EXTRA_L_WCDMA3G" > "$SHM_DIR/extra_WCDMA3G_L"
            printf '%s' "$EXTRA_N_WCDMA3G" > "$SHM_DIR/extra_WCDMA3G_N"
        fi
        log "File di stato --shm scritti in $SHM_DIR"
    fi
}

# Analisi post-cattura ed estrazione dei report: condivisa tra il flusso
# di cattura live (chiamata da finalize()) e la modalita' replay
# (--analyze-dlf, chiamata da run_replay_mode()). Presuppone che
# $PCAP_FILE/$DLF_FILE/$OUTDIR siano gia' definiti; in modalita' replay
# DIAG_PORT/AT_PORT restano vuoti (non c'e' un device reale coinvolto), il
# manifest lo segnala esplicitamente invece di stampare campi vuoti.
run_analysis_and_report() {
    PCAP_LIVE_FILE=""
    PCAP_COMPLETENESS_NOTE=""
    tui_set completeness running

    # --- fallback/conversione: rigenera il pcap dal .dlf se manca ---
    # In cattura live, qcsuper scrive il pcap solo in fase di chiusura
    # pulita; se e' stato necessario un SIGKILL il pcap puo' restare
    # vuoto pur avendo dati grezzi nel .dlf. In modalita' replay questo e'
    # invece il percorso NORMALE (non c'e' mai stato un pcap): in entrambi
    # i casi si rilegge il .dlf con qcsuper --dlf-read per (ri)ottenerlo.
    local pcap_was_regenerated=0
    if [[ ! -s "$PCAP_FILE" && -s "$DLF_FILE" ]]; then
        [[ -n "$ANALYZE_DLF" ]] || log "ATTENZIONE: $PCAP_FILE risulta vuoto (probabile chiusura non pulita di qcsuper). Tento la rigenerazione dal file .dlf..."
        if "${QCSUPER_CMD[@]}" --dlf-read "$DLF_FILE" --pcap-dump "$PCAP_FILE" \
            --reassemble-sibs --decrypt-nas \
            > "$OUTDIR/qcsuper_dlf_replay.log" 2>&1; then
            log "Pcap generato dal .dlf: $(stat -c%s "$PCAP_FILE" 2>/dev/null || echo '?') byte (vedi qcsuper_dlf_replay.log)"
            pcap_was_regenerated=1
        else
            log "ATTENZIONE: generazione del pcap dal .dlf fallita, vedi qcsuper_dlf_replay.log"
        fi
    fi

    # --- controllo di completezza: pcap "live" vs pcap rigenerato ora dal
    # .dlf ---
    # Trovato rianalizzando catture reali con --analyze-dlf: il pcap scritto
    # in diretta da qcsuper durante la cattura puo' risultare
    # significativamente meno completo di quanto rigenerato subito dopo
    # dallo stesso identico .dlf (hash invariato) — osservato un caso con 9
    # frame LTE-RRC nel pcap live contro 64 rigenerando dal .dlf, tutti gia'
    # presenti nel .dlf ma non scritti nel pcap durante la cattura. Il .dlf
    # resta quindi l'unica fonte grezza affidabile: qui lo si rilegge una
    # seconda volta a scopo di verifica e, se il risultato e' piu' completo
    # del pcap live, lo si usa per l'intera analisi che segue (evita di
    # basare report_mdt_rrc.txt/coordinate_estratte.csv/report_finale.txt su
    # un pcap incompleto), conservando pero' l'originale live con altro nome
    # (mai cancellato: resta comunque nell'hashing/manifest per la catena di
    # custodia). Non si applica in modalita' replay (--analyze-dlf o
    # --analyze-pcap): li' il pcap e' gia' stato (ri)generato dal .dlf (o e'
    # esso stesso la sorgente, in --analyze-pcap) pochi istanti fa dal blocco
    # sopra o da una sessione --analyze-dlf precedente, nulla da confrontare
    # contro un "pcap live" che in quel caso non e' mai esistito.
    if [[ -z "$ANALYZE_DLF" && "$pcap_was_regenerated" -eq 0 ]] \
        && command -v tshark >/dev/null 2>&1 \
        && [[ -s "$PCAP_FILE" && -s "$DLF_FILE" ]]; then
        local check_pcap="$OUTDIR/.completeness_check.pcap" live_total live_lte dlf_total dlf_lte
        rm -f "$check_pcap"
        if "${QCSUPER_CMD[@]}" --dlf-read "$DLF_FILE" --pcap-dump "$check_pcap" \
            --reassemble-sibs --decrypt-nas \
            > "$OUTDIR/qcsuper_dlf_replay.log" 2>&1 && [[ -s "$check_pcap" ]]; then
            live_total=$(tshark -r "$PCAP_FILE" 2>/dev/null | wc -l)
            live_lte=$(tshark -r "$PCAP_FILE" -Y "lte_rrc" 2>/dev/null | wc -l)
            dlf_total=$(tshark -r "$check_pcap" 2>/dev/null | wc -l)
            dlf_lte=$(tshark -r "$check_pcap" -Y "lte_rrc" 2>/dev/null | wc -l)
            if (( dlf_total > live_total )); then
                PCAP_LIVE_FILE="${PCAP_FILE%.pcap}.live.pcap"
                mv -f "$PCAP_FILE" "$PCAP_LIVE_FILE"
                mv -f "$check_pcap" "$PCAP_FILE"
                PCAP_COMPLETENESS_NOTE="ATTENZIONE: il pcap scritto in diretta da qcsuper era incompleto ($live_total frame totali, $live_lte LTE-RRC) rispetto a quanto rigenerato ora dallo stesso .dlf, hash invariato ($dlf_total frame totali, $dlf_lte LTE-RRC). Uso per l'analisi il pcap rigenerato (piu' completo, ora $(basename "$PCAP_FILE")); l'originale scritto in diretta e' conservato come $(basename "$PCAP_LIVE_FILE")."
                log "$PCAP_COMPLETENESS_NOTE"
                tui_set completeness ok "pcap rigenerato (era incompleto, vedi report)"
            else
                rm -f "$check_pcap"
                log "Controllo di completezza pcap: OK ($live_total frame totali, $live_lte LTE-RRC, invariati rigenerando dal .dlf)"
                tui_set completeness ok "OK, $live_total frame"
            fi
        else
            log "ATTENZIONE: controllo di completezza pcap non eseguito (rigenerazione di prova dal .dlf fallita), vedi qcsuper_dlf_replay.log"
            tui_set completeness skip "rigenerazione di prova fallita"
            rm -f "$check_pcap"
        fi
    else
        tui_set completeness ok
    fi

    # --- estrazione MDT/locationInfo con tshark, se disponibile ---
    tui_set extract running
    if command -v tshark >/dev/null 2>&1 && [[ -s "$PCAP_FILE" ]]; then
        tshark -r "$PCAP_FILE" -Y "$MDT_RRC_FILTER" -V > "$OUTDIR/report_mdt_rrc.txt" 2>"$OUTDIR/tshark_report.err" || true

        # --- dump dedicato: solo loggedMeasurementConfiguration ---
        # Isolato da report_mdt_rrc.txt (che lo mischia con logMeasReport/
        # locationInfo/ecc.) per rispondere in modo diretto alla domanda "la
        # rete ha inviato la configurazione MDT, e con quali parametri
        # (incluso un eventuale campo legato alla posizione)?". Intestazione
        # con conteggio occorrenze, poi il decode -V completo di ogni
        # occorrenza cosi' si vedono tutti i sotto-campi cosi' come li
        # interpreta il dissector lte-rrc (nomi/versioni r10 possono variare
        # a seconda del firmware/release della rete).
        n_logged_cfg=$(tshark -r "$PCAP_FILE" -Y "$MDT_LOGGED_CONFIG_FILTER" 2>>"$OUTDIR/tshark_report.err" | wc -l)
        {
            if (( n_logged_cfg > 0 )); then
                echo "=== loggedMeasurementConfiguration: $n_logged_cfg occorrenza/e trovate nella cattura ==="
            else
                echo "=== loggedMeasurementConfiguration: NESSUNA occorrenza trovata nella cattura ==="
                echo "(la rete non ha inviato una configurazione di logging MDT durante questo test)"
            fi
            echo "NOTA: questo IE (LoggedMeasurementConfiguration-r10, TS 36.331) NON contiene"
            echo "un 'flag di posizione' proprio: configura solo traceReference/traceId/"
            echo "loggingDuration/loggingInterval (ed eventualmente areaConfiguration in"
            echo "release successive). L'eventuale posizione (locationInfo/coarseLocationInfo)"
            echo "arriva dopo, nella RISPOSTA dell'UE (ueInformationResponse/logMeasReport),"
            echo "in base a cosa l'UE stesso decide di includere (es. se il GPS era acceso) —"
            echo "non e' qualcosa che la rete 'attiva' con un bit qui. Vedi report_mdt_rrc.txt/"
            echo "mdt_location_requests.txt per la risposta dell'UE."
            echo
            tshark -r "$PCAP_FILE" -Y "$MDT_LOGGED_CONFIG_FILTER" -V 2>>"$OUTDIR/tshark_report.err"
        } > "$OUTDIR/logged_measurement_configuration.txt" || true

        if (( n_logged_cfg > 0 )); then
            log "ATTENZIONE: rilevata configurazione MDT (loggedMeasurementConfiguration) dalla rete — vedi logged_measurement_configuration.txt"
        else
            log "Nessuna configurazione MDT (loggedMeasurementConfiguration) rilevata in questa cattura"
        fi

        if [[ -x "$DECODE_SCRIPT" || -f "$DECODE_SCRIPT" ]]; then
            python3 "$DECODE_SCRIPT" "$PCAP_FILE" -o "$OUTDIR/coordinate_estratte.csv" \
                > "$OUTDIR/decode_coordinate.log" 2>&1 || log "ATTENZIONE: decode_mdt_location.py ha restituito un errore, vedi decode_coordinate.log"
        else
            log "ATTENZIONE: decode_mdt_location.py non trovato in $SCRIPT_DIR/src, coordinate non decodificate"
        fi

        # --- log dedicato: richieste di MDT/posizione fatte dalla rete ---
        # Copre l'intero scambio con cui l'operatore chiede esplicitamente
        # all'UE le misure/la posizione registrate (vedi commento su
        # MDT_LOCATION_REQUEST_FILTER in testa allo script): configurazione
        # del logging, richiesta di invio (logMeasReportReq), e risposta
        # dell'UE (che puo' includere la posizione, da GPS/GNSS se acceso).
        tshark -r "$PCAP_FILE" -Y "$MDT_LOCATION_REQUEST_FILTER" -V \
            > "$OUTDIR/mdt_location_requests.txt" 2>>"$OUTDIR/tshark_report.err" || true
        {
            echo "frame_number,utc_time,time_relative_s,info"
            tshark -r "$PCAP_FILE" -Y "$MDT_LOCATION_REQUEST_FILTER" -t ud \
                -T fields -E separator=, -E quote=d \
                -e frame.number -e frame.time -e frame.time_relative -e _ws.col.Info \
                2>>"$OUTDIR/tshark_report.err"
        } > "$OUTDIR/mdt_location_requests_summary.csv" || true

        n_loc=$(($(wc -l < "$OUTDIR/mdt_location_requests_summary.csv" 2>/dev/null || echo 1) - 1))
        if (( n_loc > 0 )); then
            log "ATTENZIONE: rilevate $n_loc richieste/risposte MDT o di posizione da parte della rete — vedi mdt_location_requests.txt e mdt_location_requests_summary.csv"
            tui_set extract ok "$n_loc richieste/risposte MDT rilevate"
        else
            log "Nessuna richiesta di MDT/posizione da parte della rete rilevata in questa cattura (mdt_location_requests.txt/.csv vuoti)"
            tui_set extract ok "nessuna richiesta MDT rilevata"
        fi

        log "Estrazione tshark completata: report_mdt_rrc.txt, logged_measurement_configuration.txt, coordinate_estratte.csv, mdt_location_requests.txt"
    else
        log "tshark non disponibile o pcap vuoto: analisi manuale in Wireshark necessaria"
        tui_set extract skip "tshark non disponibile o pcap vuoto"
    fi

    # Sempre calcolate (non solo con --report/--parla-chiaro): servono
    # anche a manifest.json, generato incondizionatamente piu' sotto.
    compute_mdt_metrics
    compute_diag_warn_count
    compute_diag_error_count
    tui_set warn_pos running
    tui_set warn_mdt running
    compute_bitscan_warnings
    if (( WARN_POS_D > 0 || WARN_POS_L > 0 )); then
        tui_set warn_pos skip "diag:$WARN_POS_D log:$WARN_POS_L"
    else
        tui_set warn_pos ok "diag:$WARN_POS_D log:$WARN_POS_L"
    fi
    if (( WARN_MDT_D > 0 || WARN_MDT_L > 0 )); then
        tui_set warn_mdt skip "diag:$WARN_MDT_D log:$WARN_MDT_L"
    else
        tui_set warn_mdt ok "diag:$WARN_MDT_D log:$WARN_MDT_L"
    fi

    compute_imei_context

    # "Controlli extra" (--extended, vedi src/extra_scan): DOPO
    # compute_imei_context() (i suoi risultati vanno anch'essi nello
    # stesso report_finale.txt/manifest.json), PRIMA di generate_final_
    # report()/generate_manifest_json()/dell'hashing SHA-256 piu' sotto —
    # cosi' sia i valori (report/manifest/--shm) sia i FILE che extra_scan
    # scrive nell'outdir sono gia' pronti quando si arriva a calcolare gli
    # hash per la catena di custodia.
    compute_extra_scan

    if [[ "$REPORT" -eq 1 ]]; then
        tui_set report running
        generate_final_report
        tui_set report ok
    fi

    if [[ "$PARLA_CHIARO" -eq 1 ]]; then
        tui_set parla running
        generate_plain_report
        tui_set parla ok
    fi

    # manifest.json (+ file di stato --shm): sempre generato, non solo con
    # --report/--parla-chiaro.
    generate_manifest_json

    # Il controllo di completezza sopra e' un'informazione di sicurezza
    # dell'analisi (un pcap live sostituito con uno piu' completo): va
    # riportata in report_finale.txt anche se non e' stato chiesto
    # --report/--parla-chiaro, cosi' chi legge solo quel file non se la
    # perde. generate_final_report()/generate_plain_report() scrivono
    # report_finale.txt con '>' (lo sovrascrivono), quindi questa nota va
    # aggiunta DOPO, in coda.
    if [[ -n "$PCAP_COMPLETENESS_NOTE" ]]; then
        {
            [[ -s "$OUTDIR/report_finale.txt" ]] && echo
            echo "--- Controllo di completezza pcap ---"
            echo "$PCAP_COMPLETENESS_NOTE"
        } >> "$OUTDIR/report_finale.txt"
    fi

    # --- hashing per catena di custodia (include anche gli artefatti derivati) ---
    tui_set hash running
    (
        cd "$OUTDIR"
        sha256sum -- *.pcap *.dlf context_*.txt periodic_cell_gps.csv \
            periodic_cell_gps_decoded.csv \
            report_mdt_rrc.txt logged_measurement_configuration.txt \
            coordinate_estratte.csv lbs_query.txt \
            mdt_location_requests.txt mdt_location_requests_summary.csv \
            report_finale.txt \
            extra_scan_report.txt extra_scan.log \
            extra_scan_SMSSTK.log extra_scan_NASId.log extra_scan_RRCCiph.log \
            extra_scan_cellSys.log extra_scan_GPSLoc.log extra_scan_WCDMA3G.log \
            2>/dev/null
    ) > "$HASH_FILE" || true
    log "Hash SHA-256 calcolati in $HASH_FILE"
    tui_set hash ok

    # --- manifest ---
    tui_set manifest running
    {
        if [[ -n "$ANALYZE_DLF" || -n "$ANALYZE_PCAP" ]]; then
            echo "MANIFEST — analisi (replay) di evidenza MDT"
        else
            echo "MANIFEST — acquisizione evidenza MDT"
        fi
        echo "Script: mdtcap v$SCRIPT_VERSION"
        echo "Etichetta: ${LABEL:-n/a}"
        if [[ -n "$OP_MCCMNC" ]]; then
            echo "Operatore SIM/rete (auto MCC-MNC $OP_MCCMNC): $OP_NAME"
        elif [[ -n "$OP_NAME" ]]; then
            echo "Operatore SIM/rete (--op): $OP_NAME"
        fi
        [[ -n "$PROFILE_NAME" ]] && echo "Profilo di test (--profile): $PROFILE_NAME"
        echo "Host: $(hostname) — $(uname -a)"
        echo "Operatore SO: $(logname 2>/dev/null || echo sconosciuto)"
        if [[ -n "$ANALYZE_DLF" ]]; then
            echo "Modalita': replay da file .dlf gia' registrato (nessun device coinvolto in questa esecuzione)"
            echo "File .dlf di origine: $ANALYZE_DLF"
        elif [[ -n "$ANALYZE_PCAP" ]]; then
            echo "Modalita': replay da file .pcap gia' pronto (nessun device, nessun .dlf, nessun qcsuper coinvolto in questa esecuzione)"
            echo "File .pcap di origine: $ANALYZE_PCAP"
        else
            echo "Diag port: $DIAG_PORT"
            echo "AT port: $AT_PORT"
        fi
        if [[ -n "$ANALYZE_PCAP" ]]; then
            echo "qcsuper: N/D (non necessario in modalita' replay da pcap)"
        else
            echo "qcsuper: $QCSUPER_BIN"
            if command -v git >/dev/null 2>&1; then
                qc_dir=$(dirname "$QCSUPER_BIN")
                rev=$(git -C "$qc_dir" rev-parse HEAD 2>/dev/null || echo "n/d")
                echo "qcsuper commit: $rev"
            fi
        fi
        if [[ -n "$ANALYZE_DLF" ]]; then
            echo "Controllo completezza pcap: N/D (modalita' replay, il pcap e' gia' stato rigenerato dal .dlf)"
        elif [[ -n "$ANALYZE_PCAP" ]]; then
            echo "Controllo completezza pcap: N/D (modalita' replay da pcap, nessun .dlf con cui confrontarlo)"
        elif [[ -n "$PCAP_COMPLETENESS_NOTE" ]]; then
            echo "Controllo completezza pcap: DIVERGENZA — pcap live sostituito con uno rigenerato dal .dlf, vedi report_finale.txt e $(basename "$PCAP_LIVE_FILE")"
        else
            echo "Controllo completezza pcap: OK (pcap live coerente con la rigenerazione dal .dlf)"
        fi
        echo "Inizio esecuzione (UTC): $TS_START_TAG"
        echo "Fine esecuzione (UTC): $(date -u +%Y%m%dT%H%M%SZ)"
        echo
        echo "File prodotti e relativi SHA-256:"
        cat "$HASH_FILE" 2>/dev/null
        echo
        echo "Verifica integrità con: sha256sum -c hashes_sha256.txt"
    } > "$MANIFEST"

    log "Manifest scritto in $MANIFEST"
    tui_set manifest ok
    # "manifest" e' sempre l'ultimo passo dell'elenco: una riga vuota qui
    # separa visivamente la TUI (che da qui in poi non si aggiorna piu')
    # da quanto segue (elenco file, eventuale report finale) — MA non con
    # --shm, dove non deve comparire nulla dopo l'elenco (vedi commento
    # --shm in testa allo script e tui_print_final_report() sopra).
    [[ "$TUI_ENABLED" -eq 1 && -z "$SHM_DIR" ]] && echo
    if [[ -n "$ANALYZE_DLF" || -n "$ANALYZE_PCAP" ]]; then
        log "=== Analisi completata. Contenuto di $OUTDIR: ==="
    else
        log "=== Acquisizione completata. Contenuto di $OUTDIR: ==="
    fi
    [[ "$TUI_ENABLED" -eq 1 && -n "$SHM_DIR" ]] || ls -la "$OUTDIR"

    # --- beep (--beep): sempre per ultimo, su qualunque esito (successo o
    # abort), cosi' avvisa anche quando lo script termina in anticipo.
    # Implica sempre --parla-chiaro (deciso subito dopo il parsing degli
    # argomenti, vedi sopra), e al beep segue una pausa "premi un tasto"
    # prima che finalize() chiami tui_print_final_report() subito dopo
    # questa funzione — tempo per leggere l'elenco --tui appena
    # completato prima che il messaggio finale lo segua (o, sotto
    # mdtmain, prima che il suo msgbox prenda il posto del terminale).
    # Innocuo se stdin non e' un terminale vero (es. sotto mdtmain, che
    # tiene stdin su /dev/null apposta per il proprio poll tastiera
    # durante la cattura): "read" restituisce subito per EOF, nessuna
    # attesa reale ne' alcun rischio di bloccarsi. ---
    if [[ "$BEEP" -eq 1 ]]; then
        printf '\a'
        printf 'Premere un tasto per continuare...'
        read -r -n 1 -s -- _ 2>/dev/null || true
        printf '\n'
    fi

    # [[ ]] && ... come ultimo comando propagherebbe uno status non-zero
    # (quando BEEP=0) come valore di ritorno della funzione, facendo
    # abortire lo script sotto set -e in run_replay_mode (che non ha,
    # a differenza di finalize(), un altro comando dopo la chiamata a
    # questa funzione): return 0 esplicito.
    return 0
}

# Modalita' replay (--analyze-dlf): rilegge un file .dlf gia' registrato
# in una sessione precedente e ripete su di esso l'intera analisi
# (estrazione MDT, log richieste di posizione, --report, --parla-chiaro),
# senza toccare alcun device. Non passa mai da finalize()/dalla cattura
# live: OUTDIR/PCAP_FILE/DLF_FILE sono gia' pronti quando viene chiamata.
run_replay_mode() {
    log "=== mdtcap v$SCRIPT_VERSION (modalita' replay) ==="
    log "File .dlf di origine: $ANALYZE_DLF"
    log "Output dir: $OUTDIR"
    [[ -n "$LABEL" ]] && log "Etichetta : $LABEL"

    cp -f "$ANALYZE_DLF" "$DLF_FILE"
    log "File .dlf copiato in $DLF_FILE (la cartella di evidenza resta autocontenuta)"

    run_analysis_and_report
}

# Modalita' replay da pcap (--analyze-pcap): come run_replay_mode(), ma la
# sorgente e' gia' un .pcap/.pcapng pronto (nessun .dlf, nessun qcsuper
# coinvolto): lo si copia direttamente in $PCAP_FILE, cosi' run_analysis_
# and_report() lo trova gia' non vuoto e salta la (ri)generazione dal .dlf
# (che qui non esiste affatto: $DLF_FILE resta assente per l'intera
# esecuzione, coerente col fatto che non c'e' una sorgente Diag grezza).
run_replay_pcap_mode() {
    log "=== mdtcap v$SCRIPT_VERSION (modalita' replay da pcap) ==="
    log "File .pcap di origine: $ANALYZE_PCAP"
    log "Output dir: $OUTDIR"
    [[ -n "$LABEL" ]] && log "Etichetta : $LABEL"

    cp -f "$ANALYZE_PCAP" "$PCAP_FILE"
    log "File .pcap copiato in $PCAP_FILE (la cartella di evidenza resta autocontenuta)"

    run_analysis_and_report
}

# ---- finalizzazione (trap unico) -----------------------------------------
#
# Registrato qui, PRIMA di --apn/--force-lte/qcsuper, cosi' che il cleanup
# (in particolare il ripristino di AT+CNMP dopo --force-lte, vedi sotto)
# giri anche se lo script esce in anticipo — es. --require-lte che
# abortisce, o qcsuper che non riesce a partire — e non solo alla fine di
# una cattura completata. QCSUPER_PID/PERIODIC_PID/VERBOSE_PID sono gia'
# stati predefiniti vuoti piu' sopra proprio per questo.

FINALIZED=0
finalize() {
    [[ "$FINALIZED" -eq 1 ]] && return
    FINALIZED=1
    # Se finalize() e' invocata da Ctrl+C a meta' di uno dei tui_sleep del
    # passo "capture" (unico modo in cui puo' arrivare qui ancora "in
    # corso"), la cattura e' comunque avvenuta: e' un'interruzione
    # volontaria dell'operatore, non un errore - vedi commento
    # sull'opzione --tui in testa allo script.
    tui_set capture ok
    tui_set qcsuper_stop running
    log "Arresto cattura in corso..."

    if [[ -n "$PERIODIC_PID" ]] && kill -0 "$PERIODIC_PID" 2>/dev/null; then
        kill "$PERIODIC_PID" 2>/dev/null || true
        wait "$PERIODIC_PID" 2>/dev/null || true
    fi

    if [[ -n "$VERBOSE_PID" ]] && kill -0 "$VERBOSE_PID" 2>/dev/null; then
        kill "$VERBOSE_PID" 2>/dev/null || true
        wait "$VERBOSE_PID" 2>/dev/null || true
    fi
    rm -f "$VERBOSE_SNAPSHOT_DLF" "$VERBOSE_SNAPSHOT_PCAP"

    if [[ -n "$MDT_STATUS_PID" ]] && kill -0 "$MDT_STATUS_PID" 2>/dev/null; then
        kill "$MDT_STATUS_PID" 2>/dev/null || true
        wait "$MDT_STATUS_PID" 2>/dev/null || true
    fi
    rm -f "$MDT_STATUS_SNAPSHOT_DLF" "$MDT_STATUS_SNAPSHOT_PCAP" \
        "$TUI_NET_GPS_STATUS_FILE" "$TUI_NET_GPS_STATUS_FILE.tmp" \
        "$TUI_MDT_STATUS_FILE" "$TUI_MDT_STATUS_FILE.tmp" \
        "$TUI_RECONNECT_STATUS_FILE" "$TUI_RECONNECT_STATUS_FILE.tmp" \
        "$TUI_DIAG_STATUS_FILE" "$TUI_DIAG_STATUS_FILE.tmp" \
        "$TUI_DIAG_ERROR_STATUS_FILE" "$TUI_DIAG_ERROR_STATUS_FILE.tmp"

    local qcsuper_note=""
    if [[ -n "$QCSUPER_PID" ]] && kill -0 "$QCSUPER_PID" 2>/dev/null; then
        kill -INT "$QCSUPER_PID" 2>/dev/null || true
        for i in $(seq 1 15); do
            kill -0 "$QCSUPER_PID" 2>/dev/null || break
            tui_sleep 1
        done
        if kill -0 "$QCSUPER_PID" 2>/dev/null; then
            log "qcsuper non ha risposto a SIGINT entro 15s, forzo con SIGKILL (possibile perdita di dati non ancora scritti su disco)"
            kill -KILL "$QCSUPER_PID" 2>/dev/null || true
            # "wait" esplicito sul PID appena ucciso: senza questo, bash
            # segnala comunque (in modo asincrono, alla prima occasione
            # successiva — spesso all'uscita dello script) la morte per
            # segnale di un job avviato in background con un messaggio
            # tipo "PID Killed comando..." su stderr, anche in uno script
            # non interattivo — un "wait" sincrono sul PID specifico lo
            # fa reapire subito, silenziosamente, evitando quel messaggio
            # fuorviante (sembra un errore, non lo e': e' il KILL voluto
            # qui sopra).
            wait "$QCSUPER_PID" 2>/dev/null || true
            qcsuper_note="forzato con SIGKILL, possibile perdita dati non ancora scritti"
        fi
    fi
    log "qcsuper terminato"
    CAPTURE_END_EPOCH=$(date +%s)
    tui_set qcsuper_stop ok "$qcsuper_note"

    tui_set ctx_post running
    dump_context "$CTX_POST" "post-cattura"
    tui_set ctx_post ok

    if [[ "$GPS_ENABLED" -eq 1 ]]; then
        at_query "AT+CGPS=0" 5 >> "$SESSION_LOG" || true
    fi

    if [[ "$FORCE_LTE" -eq 1 ]]; then
        tui_set restore_net running
        log "Ripristino modo di rete automatico (AT+CNMP=2), per non lasciare il modem forzato in LTE-only oltre la sessione di test..."
        at_query "AT+CNMP=2" 5 >> "$SESSION_LOG" || true
        tui_set restore_net ok
    fi

    exec {AT_FD}<&- || true

    run_analysis_and_report
    tui_print_final_report

    return 0
}

# Modalita' replay (--analyze-dlf/--analyze-pcap): tutte le funzioni
# necessarie (run_replay_mode/run_replay_pcap_mode, run_analysis_and_report,
# generate_final_report/generate_plain_report) sono ormai definite. Esce
# qui, PRIMA di registrare il trap e di qualunque interazione con la porta
# AT (mai aperta in queste modalita', vedi sopra) - finalize()/il trap
# servono solo al percorso di cattura live.
if [[ -n "$ANALYZE_DLF" ]]; then
    if [[ "$TUI_ENABLED" -eq 1 ]]; then
        echo "ATTENZIONE: --tui non e' supportato in modalita' replay (--analyze-dlf, esecuzione troppo breve perche' serva), ignorato." >&2
        TUI_ENABLED=0
    fi
    run_replay_mode
    exit 0
fi

if [[ -n "$ANALYZE_PCAP" ]]; then
    if [[ "$TUI_ENABLED" -eq 1 ]]; then
        echo "ATTENZIONE: --tui non e' supportato in modalita' replay (--analyze-pcap, esecuzione troppo breve perche' serva), ignorato." >&2
        TUI_ENABLED=0
    fi
    run_replay_pcap_mode
    exit 0
fi

trap finalize EXIT INT TERM

ensure_imei_backup

unlock_sim_pin

# Impostata dopo lo sblocco PIN: su questo modem AT+CGDCONT (scrittura)
# risponde ERROR se la SIM e' ancora bloccata.
if [[ -n "$APN" ]]; then
    set_apn
fi

if [[ "$FORCE_LTE" -eq 1 ]]; then
    force_lte
fi

tui_set ctx_pre running
dump_context "$CTX_PRE" "pre-cattura"
tui_set ctx_pre ok

if [[ "$REQUIRE_LTE" -eq 1 ]]; then
    if ! check_network_adequate; then
        log --show "Cattura ANNULLATA: rete non adeguata per l'estrazione MDT (rilanciare senza --require-lte per forzare comunque la cattura, oppure con --lte-wait maggiore)."
        exit 2
    fi
fi

if [[ "$GPS_ENABLED" -eq 1 || "$GPS_WAIT" -gt 0 ]]; then
    tui_set gps running
    if [[ "$GPS_ENABLED" -ne 1 ]]; then
        log "Attivazione GPS/GNSS (richiesta da --gps-wait): AT+CGPS=1"
        at_query "AT+CGPS=1" 5 >> "$SESSION_LOG" || true
        GPS_ENABLED=1
    else
        log "Attivazione GPS per ground-truth: AT+CGPS=1"
        at_query "AT+CGPS=1" 5 >> "$SESSION_LOG" || true
    fi
    if [[ "$GPS_WAIT" -gt 0 ]]; then
        tui_sleep 2
        wait_for_gps_fix || true
    else
        tui_set gps ok "attivato (nessuna attesa richiesta, usa --gps-wait per attendere un fix)"
    fi
fi

if [[ "$NET_ATTACH_WAIT" -gt 0 ]]; then
    wait_for_net_attach || true
fi

if [[ "$LBS_ENABLED" -eq 1 ]]; then
    query_lbs || true
fi

# ---- avvio qcsuper --------------------------------------------------------
#
# No-op se --force-lte l'ha gia' avviato prima del ciclo CFUN (vedi
# force_lte()): qui resta come rete di sicurezza per il caso normale
# (--force-lte non usato) e per garantire comunque l'avvio anche se
# force_lte() venisse richiamata in futuro senza passare da qui.

start_qcsuper_capture

# ---- logger periodico cella + GPS (facoltativo) --------------------------
#
# Sotto --tui questo stesso processo pubblica anche, ad ogni giro, lo
# stato rete/GPS corrente in $TUI_NET_GPS_STATUS_FILE: e' l'unica fonte
# per i pallini "Stato rete"/"Stato GPS" durante attese lunghe come
# "Cattura in corso" (vedi tui_refresh_live_status), perche' la porta AT
# in quella fase e' gia' impegnata da QUESTO stesso processo (oltre che da
# qcsuper sulla porta Diag) - nessuna interrogazione aggiuntiva.
#
# --reconnect-interval: la "trappola" per la riconnessione (vedi sotto)
# vive volutamente in QUESTO STESSO processo, non in uno separato: e'
# l'unico modo per non contendersi la porta AT con questo logger, dato
# che entrambi userebbero comandi AT durante "Cattura in corso" - due
# processi indipendenti che scrivono/leggono lo stesso file descriptor
# potrebbero interfogliare comando e risposta dell'uno con quelli
# dell'altro.

echo "utc_timestamp,at_field,raw_response" > "$PERIODIC_CSV"
echo "utc_timestamp,net_mode,net_state,mcc,mnc,tac_hex,cell_id,pci,band,earfcn,dl_bw,ul_bw,rsrq_raw,rsrp_raw,rssi_raw,rssnr_raw,gps_fix,gps_lat,gps_lon,gps_alt_m,gps_speed_kmh,gps_course_deg,gps_date_ddmmyy,gps_time_utc,cpsi_raw,cgpsinfo_raw" > "$PERIODIC_DECODED_CSV"

PERIODIC_PID=""
if [[ "$GPS_ENABLED" -eq 1 || -n "$DURATION" || "$TUI_ENABLED" -eq 1 || "$RECONNECT_INTERVAL" -gt 0 ]]; then
    (
        reconnect_elapsed=0
        reconnect_count=0
        while true; do
            ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
            cpsi=$(at_query "AT+CPSI?" 5 | tr '\n' '|')
            echo "\"$ts\",\"CPSI\",\"$cpsi\"" >> "$PERIODIC_CSV"
            # "|| true" su ognuna delle assegnazioni con grep in mezzo
            # alla pipe: sotto "set -o pipefail" (attivo per l'intero
            # script) un grep senza corrispondenza (risposta AT
            # inattesa/vuota) fa fallire l'intera pipeline anche se i
            # comandi successivi (sed/cut) hanno elaborato con successo
            # un input vuoto - qui siamo dentro un processo in background
            # "while true" senza nessuno che possa reagire a un'uscita
            # anticipata sotto set -e, quindi va neutralizzato
            # esplicitamente (il valore risultante resta "" in caso di
            # non corrispondenza, gestito piu' sotto).
            cpsi_line=$(echo "$cpsi" | tr '|' '\n' | grep '^+CPSI:' | sed -E 's/^\+CPSI:[[:space:]]*//') || true
            net_mode="${cpsi_line%%,*}"

            # Decodifica posizionale del formato LTE documentato da SIMCom
            # per +CPSI: <mode>,<stato>,<MCC-MNC>,<TAC hex>,<cell id>,
            # <PCI>,<banda>,<EARFCN>,<banda DL>,<banda UL>,<RSRQ>,<RSRP>,
            # <RSSI>,<RSSNR>. Solo se il RAT e' LTE (su GSM/WCDMA il
            # formato SIMCom e' diverso, non decodificato qui: il dato
            # resta comunque intero in cpsi_raw). ATTENZIONE: la scala
            # esatta degli ultimi 4 valori numerici (RSRQ/RSRP/RSSI/
            # RSSNR) non e' verificata al 100% su questo firmware -
            # riportati cosi' come restituiti dal modem, senza alcuna
            # conversione di unita'.
            c_state="" c_mcc="" c_mnc="" c_tac="" c_cellid="" c_pci="" c_band=""
            c_earfcn="" c_dlbw="" c_ulbw="" c_rsrq="" c_rsrp="" c_rssi="" c_rssnr=""
            if [[ "$net_mode" == "LTE" ]]; then
                IFS=',' read -r _ c_state c_mccmnc c_tac c_cellid c_pci c_band \
                    c_earfcn c_dlbw c_ulbw c_rsrq c_rsrp c_rssi c_rssnr <<< "$cpsi_line" || true
                c_mcc="${c_mccmnc%%-*}"
                c_mnc="${c_mccmnc#*-}"
            fi

            gps_line="" gps_fields="" gps_fix=0
            g_lat="" g_lon="" g_alt="" g_speed="" g_course="" g_date="" g_time=""
            if [[ "$GPS_ENABLED" -eq 1 ]]; then
                gps=$(at_query "AT+CGPSINFO" 5 | tr '\n' '|')
                echo "\"$ts\",\"CGPSINFO\",\"$gps\"" >> "$PERIODIC_CSV"
                gps_fields=$(echo "$gps" | tr '|' '\n' | grep '^+CGPSINFO:' | sed -E 's/^\+CGPSINFO:[[:space:]]*//') || true
                gps_lat=$(echo "$gps_fields" | cut -d',' -f1)
                if [[ -n "$gps_lat" ]]; then
                    gps_fix=1
                    gps_ns=$(echo "$gps_fields" | cut -d',' -f2)
                    gps_lon=$(echo "$gps_fields" | cut -d',' -f3)
                    gps_ew=$(echo "$gps_fields" | cut -d',' -f4)
                    g_date=$(echo "$gps_fields" | cut -d',' -f5)
                    g_time=$(echo "$gps_fields" | cut -d',' -f6)
                    g_alt=$(echo "$gps_fields" | cut -d',' -f7)
                    g_speed=$(echo "$gps_fields" | cut -d',' -f8)
                    g_course=$(echo "$gps_fields" | cut -d',' -f9)
                    gps_decimal=$(gps_to_decimal "$gps_lat" "$gps_ns" "$gps_lon" "$gps_ew")
                    g_lat="${gps_decimal%%, *}"
                    g_lon="${gps_decimal#*, }"
                    gps_line="fix:$gps_decimal"
                else
                    gps_line="nofix"
                fi
            fi

            printf '"%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s"\n' \
                "$ts" "$net_mode" "$c_state" "$c_mcc" "$c_mnc" "$c_tac" "$c_cellid" "$c_pci" "$c_band" \
                "$c_earfcn" "$c_dlbw" "$c_ulbw" "$c_rsrq" "$c_rsrp" "$c_rssi" "$c_rssnr" \
                "$gps_fix" "$g_lat" "$g_lon" "$g_alt" "$g_speed" "$g_course" "$g_date" "$g_time" \
                "$cpsi_line" "$gps_fields" \
                >> "$PERIODIC_DECODED_CSV"

            if [[ "$TUI_ENABLED" -eq 1 ]]; then
                printf '%s\n%s\n' "${net_mode:-sconosciuto}" "$gps_line" > "${TUI_NET_GPS_STATUS_FILE}.tmp" \
                    && mv -f "${TUI_NET_GPS_STATUS_FILE}.tmp" "$TUI_NET_GPS_STATUS_FILE" || true
            fi

            # "Warning diag port": riusa lo stesso giro del logger
            # periodico (nessun processo dedicato) per contare quante
            # righe WARNING ha scritto finora qcsuper in qcsuper.log -
            # vedi compute_diag_warn_count() per il criterio esatto e il
            # perche' non conta un avviso come "eseguire come root e'
            # pericoloso" (quello e' di tshark, in tshark_report.err, un
            # file diverso).
            if [[ "$TUI_ENABLED" -eq 1 && -s "$QCSUPER_LOG" ]]; then
                diag_warn_now=$(grep -c -- '| WARNING @ ' "$QCSUPER_LOG" 2>/dev/null) || diag_warn_now=0
                printf '%s' "$diag_warn_now" > "${TUI_DIAG_STATUS_FILE}.tmp" \
                    && mv -f "${TUI_DIAG_STATUS_FILE}.tmp" "$TUI_DIAG_STATUS_FILE" || true
                # "Errori diag port": stesso giro, vedi compute_diag_error_count()
                # per il perche' serve un contatore separato (un ERROR come un
                # timeout di DIAG_LOG_CONFIG_F non compare mai in "| WARNING @ ").
                diag_error_now=$(grep -c -- '| ERROR @ ' "$QCSUPER_LOG" 2>/dev/null) || diag_error_now=0
                printf '%s' "$diag_error_now" > "${TUI_DIAG_ERROR_STATUS_FILE}.tmp" \
                    && mv -f "${TUI_DIAG_ERROR_STATUS_FILE}.tmp" "$TUI_DIAG_ERROR_STATUS_FILE" || true
            fi

            # "$RECONNECTS" -eq 0 = nessun tetto (comportamento di default,
            # invariato); altrimenti smette di ciclare una volta raggiunto
            # il numero massimo, per non aumentare oltre misura il numero
            # di riconnessioni della SIM su una cattura molto lunga.
            if [[ "$RECONNECT_INTERVAL" -gt 0 && ( "$RECONNECTS" -eq 0 || "$reconnect_count" -lt "$RECONNECTS" ) ]]; then
                reconnect_elapsed=$((reconnect_elapsed + GPS_INTERVAL))
                if (( reconnect_elapsed >= RECONNECT_INTERVAL )); then
                    reconnect_count=$((reconnect_count + 1))
                    if [[ "$TUI_ENABLED" -eq 1 ]]; then
                        printf 'running|riconnessione #%d in corso\n' "$reconnect_count" > "${TUI_RECONNECT_STATUS_FILE}.tmp" \
                            && mv -f "${TUI_RECONNECT_STATUS_FILE}.tmp" "$TUI_RECONNECT_STATUS_FILE" || true
                    fi
                    log "Test riconnessione #$reconnect_count: ciclo radio (AT+CFUN=0 poi AT+CFUN=1)..."
                    at_query "AT+CFUN=0" 5 >> "$SESSION_LOG" || true
                    sleep 5
                    at_query "AT+CFUN=1" 5 >> "$SESSION_LOG" || true
                    sleep 5
                    # Come in force_lte(): dopo un ciclo CFUN serve di norma
                    # un nuovo sblocco PIN. Qui in forma minima (non si
                    # richiama unlock_sim_pin(), che ha i suoi tui_set sul
                    # passo "pin" - non pertinenti a meta' cattura) invece
                    # di duplicarne la logica di retry completa.
                    if [[ -n "$SIM_PIN" ]]; then
                        pin_status=$(at_query "AT+CPIN?" 5) || true
                        if echo "$pin_status" | grep -q 'SIM PIN'; then
                            at_query "AT+CPIN=\"$SIM_PIN\"" 8 >/dev/null 2>&1 || true
                            sleep 3
                        fi
                    fi
                    sleep 5
                    post_cpsi=$(at_query "AT+CPSI?" 5 | tr -d '\r' | grep '^+CPSI:' || true)
                    log "Test riconnessione #$reconnect_count completato: ${post_cpsi:-nessuna risposta}"
                    cap_note=""
                    if [[ "$RECONNECTS" -gt 0 && "$reconnect_count" -ge "$RECONNECTS" ]]; then
                        cap_note=" (tetto massimo --reconnects $RECONNECTS raggiunto, nessun altro ciclo in questa cattura)"
                        log "Tetto massimo di riconnessioni raggiunto (--reconnects $RECONNECTS): il test di riconnessione si ferma qui per il resto della cattura."
                    fi
                    if [[ "$TUI_ENABLED" -eq 1 ]]; then
                        printf 'ok|%d cicli completati, ultimo: %s%s\n' "$reconnect_count" "${post_cpsi:-nessuna risposta}" "$cap_note" > "${TUI_RECONNECT_STATUS_FILE}.tmp" \
                            && mv -f "${TUI_RECONNECT_STATUS_FILE}.tmp" "$TUI_RECONNECT_STATUS_FILE" || true
                    fi
                    reconnect_elapsed=0
                fi
            fi

            sleep "$GPS_INTERVAL"
        done
    ) &
    PERIODIC_PID=$!
    log "Logger periodico cella/GPS avviato (PID $PERIODIC_PID, intervallo ${GPS_INTERVAL}s)"
    [[ "$RECONNECT_INTERVAL" -gt 0 ]] && log "Test riconnessione attivo: ciclo radio ogni ${RECONNECT_INTERVAL}s durante la cattura (via lo stesso processo, PID $PERIODIC_PID)"
fi

# ---- monitor MDT in background (solo --tui --mdt-led) --------------------
#
# Alimenta il pallino "Stato MDT": rilegge periodicamente il .dlf (scritto
# incrementalmente da qcsuper, stessa tecnica di --verbose — mai in
# conflitto con esso, sono mutualmente esclusivi) su una copia propria,
# rigenera un pcap temporaneo e conta con tshark le stesse condizioni gia'
# usate da generate_final_report()/generate_plain_report(): richiesta di
# configurazione MDT (MDT_REQUEST_ONLY_FILTER), risposta dell'UE con
# posizione (MDT_RESPONSE_ONLY_FILTER + MDT_LOCATION_INFO_FILTER), o
# richiesta esplicita di invio (logMeasReportReq). Pubblica il risultato
# in $TUI_MDT_STATUS_FILE (formato "colore|nota"), letto da
# tui_refresh_live_status() durante i tick di tui_sleep.
#
# Disattivato di default (richiede --mdt-led oltre a --tui): a differenza
# di "Stato rete"/"Stato GPS" (che riusano dati gia' raccolti dal logger
# periodico, costo aggiuntivo trascurabile), questo monitor lancia un
# intero processo qcsuper --dlf-read (10-20s solo per l'import di pycrate
# su Raspberry Pi, vedi nota su --duration piu' sopra) piu' 4 chiamate
# tshark, ogni MDT_STATUS_INTERVAL secondi, IN PARALLELO al processo di
# cattura live vero e proprio: su un Raspberry Pi questo carico periodico
# compete per CPU/IO con qcsuper e, se lo affama abbastanza a lungo, puo'
# causare un overrun sul buffer della porta Diag USB (dati persi nella
# cattura vera e propria per un effetto collaterale della UI, non per un
# problema della cattura in se'). --mdt-led va quindi attivato solo
# quando serve davvero vedere l'esito MDT in tempo reale ed e' accettabile
# il costo aggiuntivo.
MDT_STATUS_PID=""
MDT_STATUS_SNAPSHOT_DLF="$OUTDIR/.tui_mdt_snapshot.dlf"
MDT_STATUS_SNAPSHOT_PCAP="$OUTDIR/.tui_mdt_snapshot.pcap"
MDT_STATUS_INTERVAL=15
if [[ "$TUI_ENABLED" -eq 1 && "$MDT_LED" -eq 1 ]]; then
    if ! command -v tshark >/dev/null 2>&1; then
        log "ATTENZIONE: --tui con tshark non disponibile, il pallino \"Stato MDT\" restera' grigio (nessun dato)."
    else
        (
            while true; do
                sleep "$MDT_STATUS_INTERVAL"
                [[ -s "$DLF_FILE" ]] || continue
                cp -f "$DLF_FILE" "$MDT_STATUS_SNAPSHOT_DLF" 2>/dev/null || continue
                rm -f "$MDT_STATUS_SNAPSHOT_PCAP"
                "${QCSUPER_CMD[@]}" --dlf-read "$MDT_STATUS_SNAPSHOT_DLF" \
                    --pcap-dump "$MDT_STATUS_SNAPSHOT_PCAP" \
                    --reassemble-sibs --decrypt-nas >/dev/null 2>&1 || continue
                [[ -s "$MDT_STATUS_SNAPSHOT_PCAP" ]] || continue
                # "|| true" per lo stesso motivo del logger periodico
                # sopra: sotto pipefail un'uscita non-zero di tshark (es.
                # filtro senza corrispondenze in alcune versioni) non deve
                # far morire in silenzio questo processo in background.
                lte_frames=$(tshark -r "$MDT_STATUS_SNAPSHOT_PCAP" -Y "lte_rrc" 2>/dev/null | wc -l) || true
                mdt_req=$(tshark -r "$MDT_STATUS_SNAPSHOT_PCAP" -Y "$MDT_REQUEST_ONLY_FILTER" 2>/dev/null | wc -l) || true
                rrc_resp_gps=$(tshark -r "$MDT_STATUS_SNAPSHOT_PCAP" -Y "($MDT_RESPONSE_ONLY_FILTER) and ($MDT_LOCATION_INFO_FILTER)" 2>/dev/null | wc -l) || true
                attiva_hits=$(tshark -r "$MDT_STATUS_SNAPSHOT_PCAP" -Y "lte-rrc.logMeasReportReq_r10" 2>/dev/null | wc -l) || true
                if (( mdt_req > 0 || rrc_resp_gps > 0 || attiva_hits > 0 )); then
                    echo "red|richiesta/posizione MDT rilevata (MDT=$mdt_req, RRC con GPS=$rrc_resp_gps)" > "${TUI_MDT_STATUS_FILE}.tmp"
                elif (( lte_frames > 0 )); then
                    echo "green|$lte_frames frame RRC, nessuna richiesta MDT" > "${TUI_MDT_STATUS_FILE}.tmp"
                else
                    echo "grey|nessun dato ancora" > "${TUI_MDT_STATUS_FILE}.tmp"
                fi
                mv -f "${TUI_MDT_STATUS_FILE}.tmp" "$TUI_MDT_STATUS_FILE" || true
            done
        ) &
        MDT_STATUS_PID=$!
        log "Monitor MDT avviato (PID $MDT_STATUS_PID, intervallo ${MDT_STATUS_INTERVAL}s)"
    fi
fi

# ---- anteprima verbose dei pacchetti decodificati (facoltativa, -v) ------
#
# qcsuper scrive il .pcap in modo bufferizzato (vedi commento in testa al
# file), quindi non e' possibile leggerlo "live". Si aggira il problema
# rileggendo periodicamente il .dlf (quello si' scritto incrementalmente su
# disco) con `qcsuper --dlf-read`, rigenerando un pcap temporaneo e
# stampando a terminale, via tshark, solo i pacchetti nuovi rispetto al giro
# precedente. E' un'anteprima "quasi in tempo reale", non un vero streaming.

VERBOSE_PID=""
VERBOSE_SNAPSHOT_DLF="$OUTDIR/.verbose_snapshot.dlf"
VERBOSE_SNAPSHOT_PCAP="$OUTDIR/.verbose_snapshot.pcap"
if [[ "$VERBOSE" -eq 1 ]]; then
    if ! command -v tshark >/dev/null 2>&1; then
        log "ATTENZIONE: -v/--verbose richiesto ma tshark non e' disponibile, anteprima decodificata disattivata (la cattura prosegue comunque)."
    else
        log "Anteprima verbose attiva: rilettura/decodifica ogni ${VERBOSE_INTERVAL}s (best-effort, vedi commento --verbose in testa allo script)."
        (
            shown=0
            while true; do
                sleep "$VERBOSE_INTERVAL"
                [[ -s "$DLF_FILE" ]] || continue
                cp -f "$DLF_FILE" "$VERBOSE_SNAPSHOT_DLF" 2>/dev/null || continue
                rm -f "$VERBOSE_SNAPSHOT_PCAP"
                "${QCSUPER_CMD[@]}" --dlf-read "$VERBOSE_SNAPSHOT_DLF" \
                    --pcap-dump "$VERBOSE_SNAPSHOT_PCAP" \
                    --reassemble-sibs --decrypt-nas >/dev/null 2>&1 || continue
                [[ -s "$VERBOSE_SNAPSHOT_PCAP" ]] || continue
                total=$(tshark -r "$VERBOSE_SNAPSHOT_PCAP" 2>/dev/null | wc -l)
                if (( total > shown )); then
                    echo "----- [$(date -u +%H:%M:%S)] pacchetti decodificati nuovi: $((total - shown)) -----"
                    tshark -r "$VERBOSE_SNAPSHOT_PCAP" -Y "frame.number > $shown" 2>/dev/null
                    loc_hits=$(tshark -r "$VERBOSE_SNAPSHOT_PCAP" \
                        -Y "(frame.number > $shown) and ($MDT_LOCATION_REQUEST_FILTER)" \
                        -T fields -e _ws.col.Info 2>/dev/null)
                    if [[ -n "$loc_hits" ]]; then
                        echo "!!! RICHIESTA MDT/POSIZIONE DALLA RETE rilevata:"
                        echo "$loc_hits" | sed 's/^/!!!   /'
                    fi
                    shown=$total
                fi
            done
        ) &
        VERBOSE_PID=$!
    fi
fi

# ---- attesa: durata fissa o Ctrl+C ---------------------------------------

tui_set capture running
if [[ -n "$DURATION" ]]; then
    if [[ "$DURATION" -lt 30 ]]; then
        log "ATTENZIONE: --duration ${DURATION}s e' inferiore ai ~15-20s di avvio (import ASN.1); la finestra di cattura utile sara' molto ridotta o nulla. Consigliato >= 60s per acquisizioni reali."
    fi
    log "Cattura in corso per ${DURATION}s (premi Ctrl+C per interrompere prima$( [[ -n "$SHM_DIR" ]] && echo ", o creando $SHM_DIR/mdtStop" ))..."
    # Tick da 1s SEMPRE (non solo con --tui, a differenza delle altre
    # chiamate a tui_sleep): con --shm serve poter rilevare mdtStop anche
    # senza --tui, non solo per l'aggiornamento a video. tui_sleep 1 con
    # --tui disattivo resta comunque un semplice "sleep 1", nessun costo
    # aggiuntivo apprezzabile rispetto a un'unica sleep piu' lunga.
    CAPTURE_ELAPSED=0
    while (( CAPTURE_ELAPSED < DURATION )); do
        if shm_stop_requested; then
            log "File $SHM_DIR/mdtStop rilevato: interrompo la cattura in anticipo (dopo ${CAPTURE_ELAPSED}s su ${DURATION}s)."
            break
        fi
        tui_sleep 1
        CAPTURE_ELAPSED=$((CAPTURE_ELAPSED + 1))
    done
else
    log "Cattura in corso. Premi Ctrl+C per terminare e finalizzare l'evidenza$( [[ -n "$SHM_DIR" ]] && echo ", o crea $SHM_DIR/mdtStop" )."
    while kill -0 "$QCSUPER_PID" 2>/dev/null; do
        if shm_stop_requested; then
            log "File $SHM_DIR/mdtStop rilevato: interrompo la cattura in anticipo."
            break
        fi
        tui_sleep 1
    done
fi
tui_set capture ok
