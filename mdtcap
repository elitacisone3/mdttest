[[ -z "$ANALYZE_DLF" || -z "$ANALYZE_PCAP" ]] || { echo "Non usare --analyze-dlf insieme a --analyze-pcap (sono alternativi: scegli la sorgente, un .dlf grezzo o un .pcap gia' pronto)." >&2; exit 1; }

# --analyze-pcap (modalita' replay da pcap): a differenza della cattura live
# e di --analyze-dlf, non serve mai rigenerare il pcap da un .dlf (il file
# indicato E' gia' il pcap da analizzare), quindi qcsuper non viene ne'
