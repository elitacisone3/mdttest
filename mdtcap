# Filtro per l'estrazione finale degli IE MDT (loggedMeasurementConfiguration
# e affini). Il dissector lte-rrc versiona gli IE (r10/r11/r16); include anche
# coarseLocationInfo-r17 (Release 17, EUTRA-RRC-Definitions.asn:
# UEInformationResponse-v1710-IEs / MeasResults eag-10): e' un IE FRATELLO di
# logMeasReport-r10, non annidato al suo interno, quindi una risposta UE con
# solo coarseLocationInfo-r17 non farebbe scattare nessuno degli altri IE qui
# sotto — omesso in precedenza, causava un falso negativo (verificato contro
# epan/dissectors/asn1/lte-rrc su github.com/wireshark/wireshark).
MDT_RRC_FILTER='lte-rrc.loggedMeasurementConfiguration_r10_element or lte-rrc.logMeasReport_r10_element or lte-rrc.locationInfo_r10_element or lte-rrc.locationInfo_r11_element or lte-rrc.locationInfo_r16_element or lte-rrc.measReportAppLayer_r15_element or lte-rrc.coarseLocationInfo_r17'

# Filtro isolato al solo IE loggedMeasurementConfiguration (a differenza di
# MDT_RRC_FILTER sopra, che lo mescola con logMeasReport/locationInfo/ecc.):
# serve per un dump dedicato che risponda alla domanda "e' arrivato il
# comando di configurazione MDT dalla rete, e con quali parametri (fra cui
# l'eventuale richiesta di includere la posizione nel logging)?" senza dover
# scorrere anche le risposte dell'UE mischiate nello stesso file.
MDT_LOGGED_CONFIG_FILTER='lte-rrc.loggedMeasurementConfiguration_r10_element'

# Filtro piu' ampio per il log dedicato "richieste MDT/posizione dalla rete":
# oltre agli IE MDT sopra, include l'handshake completo con cui la rete
# richiede esplicitamente all'UE le misure/posizione registrate:
#   - loggedMeasurementConfiguration: la rete configura il logging MDT
#   - ueInformationRequest (+ logMeasReportReq): la rete chiede all'UE di
#     inviare le misure/la posizione registrate (e' questa la "richiesta"
#     esplicita di dati di localizzazione)
#   - ueInformationResponse / logMeasReport / locationInfo: la risposta
#     dell'UE, che puo' includere la posizione (da GPS/GNSS se disponibile)
MDT_LOCATION_REQUEST_FILTER="$MDT_RRC_FILTER"' or lte-rrc.ueInformationRequest_r9_element or lte-rrc.ueInformationRequest_r16_element or lte-rrc.logMeasReportReq_r10 or lte-rrc.ueInformationResponse_r9_element or lte-rrc.ueInformationResponse_r16_element'

# Filtri usati solo dal report finale (--report), per distinguere le
# "richieste" della rete dalle "risposte" dell'UE (il filtro sopra le
# somma tutte insieme) e per isolare la presenza di una posizione.
MDT_REQUEST_ONLY_FILTER='lte-rrc.loggedMeasurementConfiguration_r10_element or lte-rrc.ueInformationRequest_r9_element or lte-rrc.ueInformationRequest_r16_element'
MDT_RESPONSE_ONLY_FILTER='lte-rrc.ueInformationResponse_r9_element or lte-rrc.ueInformationResponse_r16_element or lte-rrc.logMeasReport_r10_element'
MDT_LOCATION_INFO_FILTER='lte-rrc.locationInfo_r10_element or lte-rrc.locationInfo_r11_element or lte-rrc.locationInfo_r16_element or lte-rrc.locationInfo_r16 or lte-rrc.coarseLocationInfo_r17'

usage() {
    # Stampa l'intero blocco di commenti in testa al file (righe 3..fino a
    # "set -euo pipefail" escluso), saltando lo shebang e la riga vuota
    # iniziali. Range dinamico (non un numero di riga fisso) cosi' non va
    # aggiornato manualmente ogni volta che questo blocco cambia lunghezza.
    sed -n '3,/^set -euo pipefail/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
    exit 1
}

log() {
    # --show: forza la stampa a terminale anche sotto --tui (dove log()
    # normalmente non stampa piu' a schermo, vedi sotto) - riservato ai
    # messaggi che devono restare visibili comunque (intestazione iniziale,
    # errori fatali che precedono un exit).
    local force_show=0
    if [[ "${1:-}" == "--show" ]]; then
        force_show=1
        shift
    fi
    local msg="[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"
    # Sotto --tui il testo di log scorrerebbe sopra/sotto l'elenco a righe
    # ridisegnato da tui_redraw() rendendolo illeggibile: in quella
    # modalita' log() scrive SOLO su session.log (storico completo
    # invariato), e lo stato di avanzamento si vede tramite l'elenco a
    # righe (tui_set), non piu' come testo scorrevole - eccetto i messaggi
    # con --show.
    if [[ "$TUI_ENABLED" -ne 1 || "$force_show" -eq 1 ]]; then
        echo "$msg"
    fi
    # [[ ]] && ... come ultimo comando farebbe uscire log() con status 1
    # (facendo abortire lo script sotto set -e) ogni volta che viene
    # chiamata prima che SESSION_LOG sia definita (es. da autodetect_ports,
    # eseguita prima della creazione dell'outdir): return 0 esplicito.
    [[ -n "${SESSION_LOG:-}" ]] && echo "$msg" >> "$SESSION_LOG"
    return 0
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || { echo "Comando richiesto non trovato: $1" >&2; exit 1; }
}

# ---- TUI: elenco passi con stato in tempo reale (--tui) -----------------
#
# Alternativa a --verbose (mutualmente esclusiva, vedi validazione sopra):
# invece del testo di log che scorre a terminale, mostra un elenco fisso
# di righe — una per ogni azione prevista in base alle opzioni attive per
# QUESTA esecuzione — ridisegnato sul posto (stessa tecnica di --verbose:
# codici escape ANSI, nessuna libreria esterna) ad ogni cambio di stato,
# con un pallino colorato a sinistra:
#   grigio   = da fare (non ancora iniziato)
#   giallo   = in corso (con timer [MM:SS] o [MM:SS/MM:SS] se l'attesa ha
#              un tetto massimo noto, es. --lte-wait/--gps-wait/--duration)
#   verde    = completato con successo
#   rosso    = errore (incluso un esito che fa abortire lo script, es.
#              --require-lte non soddisfatto)
#   arancione = saltato/non bloccante (es. nessun fix GPS entro
#              --gps-wait: lo script prosegue comunque, per costruzione —
#              vedi i commenti delle singole opzioni in testa allo
#              script). L'LBS (--lbs) e' invece sempre verde: una
#              risposta assente (servizio non abilitato sul piano/SIM) e'
#              un esito normale, non un problema da segnalare in
#              arancione.
# Quando attiva, log() smette di stampare a terminale (resta comunque
# scritto per intero in session.log, invariato): l'unico testo che
# continua a comparire e' quello passato con "log --show" (intestazione
# iniziale, errori fatali) e, per ultimo, il contenuto di
# report_finale.txt se e' stato richiesto --report/--parla-chiaro (vedi
# la chiamata a tui_print_final_report() in finalize()) — esattamente
# come una cattura senza --tui, solo spostato in fondo invece che
# frammisto al log.

TUI_STEP_IDS=()
declare -A TUI_STEP_LABEL=()
