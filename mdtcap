tui_add() {
    local id="$1" label="$2" total="${3:-0}"
    TUI_STEP_IDS+=("$id")
    TUI_STEP_LABEL["$id"]="$label"
    TUI_STEP_STATUS["$id"]="pending"
    TUI_STEP_TOTAL["$id"]="$total"
    TUI_STEP_NOTE["$id"]=""
    TUI_RENDER_PLAN+=("S:$id")
}

tui_header() { TUI_RENDER_PLAN+=("H:$1"); }
tui_blank()  { TUI_RENDER_PLAN+=("B"); }

# Costruisce l'elenco dei passi PREVISTI per questa esecuzione: prima
# "Informazioni:" (3 pallini STATICI, mai aggiornati da tui_set — vedi
# sotto), poi i 3 pallini di STATO (sempre presenti, indipendenti dalle
# opzioni attive — riflettono cio' che sta succedendo davvero sulla
# rete/GPS/RRC in questo momento, anche durante attese lunghe come
# "Cattura in corso"), poi le OPERAZIONI vere e proprie, una per ogni
# azione prevista in base alle opzioni effettivamente attive: l'elenco
# mostrato da subito e' sempre completo, senza passi che compaiono a
# sorpresa a meta' cattura (un' opzione non attiva semplicemente non
# genera il suo passo, invece di comparire e passare subito a
# "saltato"). Stesso ordine del flusso reale piu' sotto nello script.
tui_build_steps() {
    # "Informazioni:" — sostituisce le righe di log sparse che altrimenti
    # comparirebbero PRIMA dell'elenco (echo semplice, non redisegnate da
    # tui_redraw): qui sono invece 3 pallini fissi, valorizzati una sola
    # volta (mai passati a tui_set, non cambiano per tutta l'esecuzione).
    # Operatore: verde se rilevato (auto MCC-MNC o --op), rosso se
    # sconosciuto (nessun operatore risolto: APN/impostazioni di rete
    # dell'operatore NON applicate). Percorso dati e Titolo sono sempre
    # verdi (sono fatti, non esiti da segnalare).
    tui_header "Informazioni:"
    tui_add info_operatore "Operatore: ${OP_NAME:-sconosciuto}"
    TUI_STEP_STATUS[info_operatore]=$([[ -n "$OP_NAME" ]] && echo ok || echo error)
    tui_add info_percorso "Percorso dati: $OUTDIR"
    TUI_STEP_STATUS[info_percorso]=ok
    tui_add info_titolo "Titolo: ${LABEL:-(nessuno)}"
    TUI_STEP_STATUS[info_titolo]=ok
    tui_blank

    tui_header "Stato:"
    tui_add net_status "Stato rete"
    tui_add gps_status "Stato GPS"
    # Sempre presente come net_status/gps_status (non serve --mdt-led): a
    # differenza di "Stato MDT" non lancia nulla di suo, si limita a
    # contare le righe WARNING gia' scritte da qcsuper in qcsuper.log
    # (vedi compute_diag_warn_count()) - costo trascurabile, nessuna
    # opzione richiesta.
    tui_add diag_status "Warning diag port"
    # Come diag_status, ma per le righe "| ERROR @ " di qcsuper.log (vedi
    # compute_diag_error_count()): un ERROR e' piu' grave di un WARNING
    # (es. un log type mai abilitato sul modem, non solo un frame scartato
    # per CRC), quindi usa il bullet rosso "error" invece dell'arancione
    # "skip" usato da diag_status quando > 0 — vedi tui_refresh_live_status().
    tui_add diag_error_status "Errori diag port"
    # Anche questi due sempre presenti come i precedenti, ma calcolati UNA
    # SOLA VOLTA a fine cattura (non in tempo reale: la scansione lavora
    # su qcsuper.log/il .dlf ormai completi) da compute_bitscan_warnings():
    # restano "pending" (grigio) per tutta la cattura, poi passano a
    # ok/skip nella stessa chiamata che li calcola in
    # run_analysis_and_report(). Nota "diag:N log:N" = warnPosD/warnPosL
    # (rispettivamente warnMDTD/warnMDTL per il secondo) — vedi il
    # commento "warnPosD/warnPosL/warnMDTD/warnMDTL" in testa allo script.
    tui_add warn_pos "GPS in frame scartati/non decodificati"
    tui_add warn_mdt "Setup MDT in frame scartati/non decodificati"
    [[ "$MDT_LED" -eq 1 ]] && tui_add mdt_status "Stato MDT"
    tui_blank

    tui_header "Operazioni:"
    # Solo con --autodetect: la ricerca delle porte richiede qualche
    # secondo (prova "AT" su ogni ttyUSB candidato) durante cui, senza
    # questo passo, lo script sembrerebbe non fare nulla. E' l'UNICO
    # passo eseguito PRIMA che l'elenco sia mostrato per intero (vedi
    # riordino piu' sotto nel flusso principale: tui_init() viene
    # chiamata prima di autodetect_ports() apposta per questo passo).
    [[ "$AUTODETECT" -eq 1 ]] && tui_add autodetect "Rilevamento porte (autodetect)"
    tui_add pin "Sblocco PIN SIM"
    [[ -n "$APN" ]] && tui_add apn "Impostazione APN ($APN)"
    # Con --force-lte la cattura parte PRIMA del ciclo radio (vedi
    # force_lte()), per registrare l'intera sequenza di re-attach: qui
    # l'elenco riflette lo stesso ordine, cosi' "Avvio cattura" compare
    # (e si completa) prima di "Forzatura LTE-only...", non dopo.
    if [[ "$FORCE_LTE" -eq 1 ]]; then
        tui_add qcsuper_start "Avvio cattura (qcsuper)"
        tui_add force_lte "Forzatura LTE-only + ciclo radio"
    fi
    tui_add ctx_pre "Contesto AT (pre-cattura)"
    [[ "$REQUIRE_LTE" -eq 1 ]] && tui_add require_lte "Verifica rete LTE" "$LTE_WAIT"
    if [[ "$GPS_ENABLED" -eq 1 || "$GPS_WAIT" -gt 0 ]]; then
        tui_add gps "GPS: attivazione + attesa fix" "$GPS_WAIT"
    fi
    [[ "$NET_ATTACH_WAIT" -gt 0 ]] && tui_add net_attach "Attach dati (PS+PDP) + attesa" "$NET_ATTACH_WAIT"
    [[ "$LBS_ENABLED" -eq 1 ]] && tui_add lbs "Interrogazione LBS"
    [[ "$FORCE_LTE" -ne 1 ]] && tui_add qcsuper_start "Avvio cattura (qcsuper)"
    tui_add capture "Cattura in corso" "${DURATION:-0}"
    [[ "$RECONNECT_INTERVAL" -gt 0 ]] && tui_add reconnect "Test riconnessione (ogni ${RECONNECT_INTERVAL}s)"
    tui_add qcsuper_stop "Arresto cattura"
    tui_add ctx_post "Contesto AT (post-cattura)"
    [[ "$FORCE_LTE" -eq 1 ]] && tui_add restore_net "Ripristino modalita' rete automatica"
    tui_add completeness "Controllo completezza pcap"
    tui_add extract "Estrazione tshark (MDT/RRC/posizione)"
    [[ "$REPORT" -eq 1 ]] && tui_add report "Generazione report finale"
    [[ "$PARLA_CHIARO" -eq 1 ]] && tui_add parla "Generazione parla-chiaro"
    [[ "$EXTENDED" -eq 1 ]] && tui_add extra_scan "Scansione extra (IMSI-catcher/sorveglianza)"
    tui_add hash "Calcolo hash SHA-256"
    tui_add manifest "Scrittura manifest"

    # "Controlli extra:" (--extended, vedi src/extra_scan): un pallino per
    # categoria, SOLO se --extended e' stato richiesto per QUESTA
    # esecuzione (a differenza di report_finale.txt, che mostra comunque
    # le intestazioni con "non richiesto" anche senza --extended, vedi
    # generate_final_report()): nella TUI, in tempo reale, una sezione
    # sempre presente ma sempre "pending"/grigia quando --extended non e'
    # usato (il caso piu' comune) era solo rumore visivo senza alcuna
    # informazione utile. compute_extra_scan() aggiorna questi pallini a
    # fine cattura con il livello/conteggio effettivo di ciascuna categoria.
    if [[ "$EXTENDED" -eq 1 && ${#EXTRA_SCAN_DEFS_ORDER[@]} -gt 0 ]]; then
        tui_blank
        tui_header "Controlli extra:"
        local ec
        for ec in "${EXTRA_SCAN_DEFS_ORDER[@]}"; do
            tui_add "extra_cat_$ec" "${EXTRA_SCAN_DEFS[$ec]} ($ec)"
        done
    fi

    if [[ "$GPS_ENABLED" -eq 0 && "$GPS_WAIT" -eq 0 ]]; then
        TUI_STEP_NOTE[gps_status]="GPS non richiesto in questa esecuzione"
    fi
    # "[[ ]] && ..." come ultimo comando propagherebbe un status non-zero
    # (quando la condizione sopra e' falsa) come valore di ritorno della
    # funzione, facendo abortire lo script sotto set -e alla prima
    # chiamata di tui_init() (che chiama tui_build_steps come comando
    # "nudo", non dentro un if/&&/||) - stesso motivo del "return 0"
    # esplicito dopo --beep in run_analysis_and_report(). L'if sopra e'
    # gia' di per se' sicuro (un if con condizione falsa e senza else
    # ritorna 0), ma un return 0 esplicito qui rende la funzione robusta
    # anche a modifiche future che aggiungessero un'altra riga "nuda".
    return 0
}

tui_fmt_mmss() {
    printf '%02d:%02d' $(( $1 / 60 )) $(( $1 % 60 ))
}

# Larghezza attuale del terminale (colonne), con fallback se non
# determinabile (es. output rediretto): tput cols legge la dimensione
# vera del terminale collegato a stderr/stdin anche quando stdout e'
# rediretto, $COLUMNS come ripiego (valorizzata solo da shell interattive
# che l'hanno esportata), 80 come ultima spiaggia. Chiamata una sola
# volta per ridisegno (da tui_redraw(), non da ogni singola tui_line())
# per non pagare il costo di "tput" una volta per riga.
tui_term_width() {
    local w
    w=$(tput cols 2>/dev/null) && [[ "$w" =~ ^[0-9]+$ ]] && (( w > 0 )) && { echo "$w"; return 0; }
    if [[ -n "${COLUMNS:-}" && "$COLUMNS" =~ ^[0-9]+$ && "$COLUMNS" -gt 0 ]]; then
        echo "$COLUMNS"
        return 0
    fi
    echo 80
}

# Converte una coppia di coordinate NMEA cosi' come le restituisce
# AT+CGPSINFO (ddmm.mmmmmm per la latitudine, dddmm.mmmmmm per la
# longitudine, entrambe SENZA segno, con l'emisfero a parte in N/S/E/W)
# in gradi decimali con segno, "lat, lon" - stesso formato che si
# incollerebbe nella barra di ricerca di Google Maps (negativo per
# emisfero S/W, 6 decimali). Usata per le note mostrate in --tui al posto
# del dato NMEA grezzo (che resta comunque disponibile per intero nei
# log/file, questa e' solo una presentazione piu' leggibile).
gps_to_decimal() {
    local lat_raw="$1" ns="$2" lon_raw="$3" ew="$4"
    awk -v lat="$lat_raw" -v ns="$ns" -v lon="$lon_raw" -v ew="$ew" 'BEGIN {
        lat_deg = int(lat / 100); lat_min = lat - (lat_deg * 100)
        lat_dd = lat_deg + (lat_min / 60)
        if (ns == "S") lat_dd = -lat_dd
        lon_deg = int(lon / 100); lon_min = lon - (lon_deg * 100)
        lon_dd = lon_deg + (lon_min / 60)
        if (ew == "W") lon_dd = -lon_dd
        printf "%.6f, %.6f", lat_dd, lon_dd
    }'
}

tui_line() {
    # "id" va dichiarato in un "local" separato da quelli che lo usano per
    # indicizzare gli array (sotto "set -u"): nella stessa istruzione
    # "local id=X status=${A[$id]}" bash valuta "$id" PRIMA che sia
    # effettivamente vincolato dalla dichiarazione corrente, risultando
    # "unbound variable" alla primissima chiamata (avviene in un
    # sottoprocesso di command substitution, che non eredita variabili
    # locali del chiamante).
    local id="$1" cols="${2:-80}"
    local status="${TUI_STEP_STATUS[$id]}" label="${TUI_STEP_LABEL[$id]}"
    local total="${TUI_STEP_TOTAL[$id]:-0}" note="${TUI_STEP_NOTE[$id]}"
    local bullet timer=""
    case "$status" in
        pending) bullet="${TUI_C_GREY}●${TUI_C_RESET}" ;;
        running) bullet="${TUI_C_YELLOW}●${TUI_C_RESET}" ;;
        ok)      bullet="${TUI_C_GREEN}●${TUI_C_RESET}" ;;
        error)   bullet="${TUI_C_RED}●${TUI_C_RESET}" ;;
        skip)    bullet="${TUI_C_ORANGE}●${TUI_C_RESET}" ;;
        # "Controlli extra:" (--extended, vedi src/extra_scan): un pallino
        # per categoria, colorato secondo il livello I/W/C/A piu' alto
        # rilevato in quella categoria (vedi extra_status_for_level()).
        extra_i) bullet="${TUI_C_GREEN}●${TUI_C_RESET}" ;;
        extra_w) bullet="${TUI_C_ORANGE}●${TUI_C_RESET}" ;;
        extra_c) bullet="${TUI_C_DARKRED}●${TUI_C_RESET}" ;;
        extra_a) bullet="${TUI_C_RED}●${TUI_C_RESET}" ;;
        *)       bullet="${TUI_C_GREY}●${TUI_C_RESET}" ;;
    esac
    if [[ "$status" == "running" ]]; then
        local elapsed=$(( $(date +%s) - ${TUI_STEP_START[$id]:-$(date +%s)} ))
        if (( total > 0 )); then
            timer=" [$(tui_fmt_mmss "$elapsed")/$(tui_fmt_mmss "$total")]"
        else
            timer=" [$(tui_fmt_mmss "$elapsed")]"
        fi
    fi
    # Tronca (mai a capo: una riga --tui deve restare SEMPRE una sola riga
    # di terminale, altrimenti il ridisegno "risali di N righe" di
    # tui_redraw() perderebbe il conto) la parte in chiaro (label+timer+
    # nota — il pallino colorato non ha caratteri visibili oltre al
    # pallino stesso, non serve tenerne conto separatamente) a "cols - 2"
    # (2 = pallino + spazio che lo segue), con una "…" finale se e' stato
    # tagliato qualcosa.
    local plain="${label}${timer}${note:+ — $note}"
    local avail=$(( cols - 2 ))
    if (( avail > 1 && ${#plain} > avail )); then
        plain="${plain:0:avail-1}…"
    fi
    printf '%s %s' "$bullet" "$plain"
}

# Ridisegna l'intero elenco (intestazioni "Stato:"/"Operazioni:", righe
# vuote di separazione e pallini) sul posto: risale di TUI_LINES_DRAWN
# righe (nessuna la prima volta) poi ristampa ogni riga cancellando prima
# il contenuto precedente (\033[2K) - stessa tecnica della singola barra
# di progresso, solo su N righe fisse invece di una.
tui_redraw() {
    [[ "$TUI_ENABLED" -eq 1 ]] || return 0
    if (( TUI_LINES_DRAWN > 0 )); then
        printf '\033[%dA' "$TUI_LINES_DRAWN"
    fi
    local cols
    cols=$(tui_term_width)
    local entry kind rest
    for entry in "${TUI_RENDER_PLAN[@]}"; do
        kind="${entry%%:*}"
        rest="${entry#*:}"
        case "$kind" in
            H) printf '\r\033[2K\033[1m%s\033[0m\n' "$rest" ;;
            B) printf '\r\033[2K\n' ;;
            S) printf '\r\033[2K%s\n' "$(tui_line "$rest" "$cols")" ;;
        esac
    done
    TUI_LINES_DRAWN=${#TUI_RENDER_PLAN[@]}
}

tui_init() {
    [[ "$TUI_ENABLED" -eq 1 ]] || return 0
    tui_build_steps
    TUI_LINES_DRAWN=0
    tui_redraw
}

# Aggiorna lo stato (ed opzionalmente una breve nota, es. l'esito) di un
# passo e ridisegna subito l'elenco. No-op se --tui non e' attivo, o se
# l'id non fa parte dei passi previsti per questa esecuzione (opzione
# corrispondente non attiva): i chiamanti non devono controllare nessuna
# delle due condizioni caso per caso, possono chiamarla incondizionatamente.
tui_set() {
    [[ "$TUI_ENABLED" -eq 1 ]] || return 0
    local id="$1" status="$2" note="${3:-}"
    [[ -v TUI_STEP_STATUS[$id] ]] || return 0
    # Il timer riparte da zero solo alla transizione VERSO "running" (da
    # uno stato diverso), non ad ogni chiamata: un passo come "reconnect"
    # (Test riconnessione) puo' essere rimesso a "running" piu' volte nel
    # corso della stessa esecuzione (una per ciclo) chiamando tui_set ad
    # ogni tick di tui_sleep finche' il file di stato dice "running" -
    # senza questa guardia il timer non avanzerebbe mai oltre 00:00.
    if [[ "$status" == "running" && "${TUI_STEP_STATUS[$id]}" != "running" ]]; then
        TUI_STEP_START["$id"]=$(date +%s)
    fi
    TUI_STEP_STATUS["$id"]="$status"
    [[ -n "$note" ]] && TUI_STEP_NOTE["$id"]="$note"
    tui_redraw
}

# Rilegge (se presenti) i file di stato scritti dai due processi in
# background (logger periodico cella/GPS/diag e monitor MDT) e aggiorna i
# pallini di STATO di conseguenza. Chiamata da tui_sleep() ad ogni tick da
# 1s: e' cosi' che "Stato rete"/"Stato GPS"/"Warning diag port"/"Stato
# MDT" cambiano colore DURANTE un'attesa lunga (in particolare "Cattura
# in corso"), non solo nei passi che li aggiornano direttamente
# (require_lte/gps in precattura). No-op se i file non esistono ancora
# (es. prima che il logger periodico/monitor MDT siano partiti) o se
# --tui non e' attivo.
tui_refresh_live_status() {
    [[ "$TUI_ENABLED" -eq 1 ]] || return 0
    if [[ -s "$TUI_NET_GPS_STATUS_FILE" ]]; then
        local net gps
        { IFS= read -r net; IFS= read -r gps; } < "$TUI_NET_GPS_STATUS_FILE" 2>/dev/null || true
        case "$net" in
            LTE) tui_set net_status ok "LTE" ;;
            "") : ;;
            *)   tui_set net_status skip "$net" ;;
        esac
        case "$gps" in
            fix:*) tui_set gps_status ok "${gps#fix:}" ;;
            nofix) tui_set gps_status skip "nessun fix al momento" ;;
            *) : ;;
        esac
    fi
    if [[ -s "$TUI_MDT_STATUS_FILE" ]]; then
        local mdt_color mdt_note
        IFS='|' read -r mdt_color mdt_note < "$TUI_MDT_STATUS_FILE" 2>/dev/null || true
        case "$mdt_color" in
            red)   tui_set mdt_status error "$mdt_note" ;;
            green) tui_set mdt_status ok "$mdt_note" ;;
            grey)  tui_set mdt_status pending "$mdt_note" ;;
        esac
    fi
    if [[ -s "$TUI_RECONNECT_STATUS_FILE" ]]; then
        local rec_status rec_note
        IFS='|' read -r rec_status rec_note < "$TUI_RECONNECT_STATUS_FILE" 2>/dev/null || true
        case "$rec_status" in
            running) tui_set reconnect running "$rec_note" ;;
            ok)      tui_set reconnect ok "$rec_note" ;;
        esac
    fi
    if [[ -s "$TUI_DIAG_STATUS_FILE" ]]; then
        local diag_warn
        diag_warn=$(<"$TUI_DIAG_STATUS_FILE")
        if [[ "$diag_warn" =~ ^[0-9]+$ ]]; then
            if (( diag_warn > 0 )); then
                tui_set diag_status skip "$diag_warn"
            else
                tui_set diag_status ok "0"
            fi
        fi
    fi
    if [[ -s "$TUI_DIAG_ERROR_STATUS_FILE" ]]; then
        local diag_error
        diag_error=$(<"$TUI_DIAG_ERROR_STATUS_FILE")
        if [[ "$diag_error" =~ ^[0-9]+$ ]]; then
            if (( diag_error > 0 )); then
                tui_set diag_error_status error "$diag_error"
            else
                tui_set diag_error_status ok "0"
            fi
        fi
    fi
}

# Come "sleep", ma se --tui e' attivo spezza l'attesa in tick da 1s,
# rileggendo lo stato rete/GPS/MDT (tui_refresh_live_status) e
# ridisegnando l'elenco (quindi anche il timer del passo "in corso") ad
# ogni tick, invece di restare fermo per l'intera durata della sleep.
# Senza --tui e' identica a "sleep N" (stesso comportamento, nessun
# overhead): i chiamanti possono quindi usarla al posto di "sleep" in ogni
# punto d'attesa senza dover distinguere i due casi.
tui_sleep() {
    local secs="$1" i
    if [[ "$TUI_ENABLED" -ne 1 ]]; then
        sleep "$secs"
        return 0
    fi
    for (( i = 0; i < secs; i++ )); do
        sleep 1
        tui_refresh_live_status
        tui_redraw
    done
}

# True (con l'effetto collaterale di cancellare il file) se --shm e'
# attivo e $SHM_DIR/mdtStop esiste: segnale esterno per terminare la
# cattura in anticipo, prima che scada --duration (o prima di un Ctrl+C
# manuale) — vedi il commento --shm in testa allo script. Controllata a
# ogni tick di 1s durante "Cattura in corso" (vedi piu' sotto nel flusso
# principale), MAI durante le attese di pre-cattura (--lte-wait/
# --gps-wait/--net-attach-wait): "termina la registrazione" si riferisce
# alla cattura vera e propria, non alla fase di setup che la precede.
# Il file viene cancellato appena rilevato (non solo all'avvio, vedi
# --shm sopra): il segnale e' cosi' "consumato" una volta agito, non
# lasciato li' a confondere una prossima esecuzione con lo stesso
# --shm DIR.
shm_stop_requested() {
    [[ -n "$SHM_DIR" && -f "$SHM_DIR/mdtStop" ]] || return 1
    rm -f "$SHM_DIR/mdtStop"
    return 0
}

# Stampa (a terminale, in fondo all'elenco --tui) il contenuto di
# report_finale.txt se --report/--parla-chiaro l'hanno prodotto: sotto
# --tui, generate_final_report()/generate_plain_report() lo scrivono su
# file e lo mandano in log (quindi solo su session.log, vedi log() sopra)
# esattamente come in cattura normale, ma senza --tui comparirebbe anche
# a terminale mescolato al resto del log — qui viene invece mostrato una
# sola volta, per intero, DOPO l'elenco a righe (comportamento richiesto:
# il report va sempre "stampato alla fine", non durante). No-op se
# --report/--parla-chiaro non sono stati richiesti o se il file manca.
tui_print_final_report() {
    [[ "$TUI_ENABLED" -eq 1 ]] || return 0
    # Con --shm, la TUI non deve stampare nulla dopo l'elenco delle
    # azioni (vedi commento --shm in testa allo script): il consumo dei
    # risultati e' demandato ai file di stato in --shm, non al terminale.
    [[ -z "$SHM_DIR" ]] || return 0
    [[ "$REPORT" -eq 1 || "$PARLA_CHIARO" -eq 1 ]] || return 0
    [[ -s "$OUTDIR/report_finale.txt" ]] || return 0
    echo
    echo "=== Report finale ==="
    if [[ "$PARLA_CHIARO" -eq 1 ]]; then
        # Con --tui + --parla-chiaro, la frase --parla-chiaro deve
        # SEMPRE restare l'ultima riga stampata — anche quando
        # report_finale.txt contiene, DOPO di lei, la nota di
        # completezza pcap (PCAP_COMPLETENESS_NOTE, aggiunta in coda al
        # file da run_analysis_and_report() DOPO generate_plain_report()).
        # Si riordina quindi solo la STAMPA qui sotto (il file su disco
        # resta invariato, con l'ordine con cui le sezioni sono state
        # scritte): prima il report tecnico di --report se presente (fino
        # al marcatore "--- Parla chiaro ---", escluso), poi l'eventuale
        # nota di completezza, poi — per ultima, sempre — la frase.
        [[ "$REPORT" -eq 1 ]] && sed '/^--- Parla chiaro ---$/,$d' "$OUTDIR/report_finale.txt"
        if [[ -n "$PCAP_COMPLETENESS_NOTE" ]]; then
            echo
            echo "--- Controllo di completezza pcap ---"
            echo "$PCAP_COMPLETENESS_NOTE"
        fi
        echo
        echo "--- Parla chiaro ---"
        echo "Risultato: $PLAIN_REPORT_FRASE"
    else
        cat "$OUTDIR/report_finale.txt"
    fi
}

list_ports() {
    echo "=== dmesg (ultime righe con ttyUSB) ==="
    dmesg | grep -i ttyUSB || echo "(nessuna riga trovata, prova 'sudo dmesg' o ricollega il modulo)"
    echo
    echo "=== porte seriali presenti ==="
    for p in /dev/ttyUSB*; do
        [[ -e "$p" ]] || continue
        info=$(udevadm info -q property -n "$p" 2>/dev/null | grep -E '^(ID_USB_INTERFACE_NUM|ID_MODEL|ID_VENDOR)=' | tr '\n' ' ')
        echo "$p  $info"
    done
    echo
    echo "Individua la porta 0 (Diag) e una porta AT (di solito la seconda o terza)"
    echo "interrogando ciascuna con: AT+CUSBPIDSWITCH? oppure semplicemente 'AT' (deve rispondere OK sulla porta AT)."
}

# Prova un singolo device candidato inviando "AT": ritorna su stdout la
# risposta grezza ricevuta (contiene "OK" se il device e' una vera porta
# AT). Apre e richiude il file descriptor, non tocca lo stato globale
# (a differenza di AT_FD/at_query, usati per la connessione persistente
# della cattura vera e propria).
probe_at_candidate() {
    local dev="$1" fd resp="" line start_ts
    # Come nel setup della porta AT vera (vedi piu' sotto): il baud rate
    # su una porta seriale USB e' puramente informativo, impostarlo
    # insieme alla modalita' raw nella STESSA chiamata stty puo' fallire
    # (su alcuni device risulta "unable to perform all requested
    # operations") pur non avendo alcun effetto pratico sul risultato;
    # le due chiamate vanno quindi separate, tollerando il fallimento
    # della prima.
    stty -F "$dev" 115200 2>/dev/null || true
    stty -F "$dev" raw -echo -echoe -echok time 0 min 0 2>/dev/null || return 1
    exec {fd}<>"$dev" 2>/dev/null || return 1
    printf 'AT\r' >&"$fd" 2>/dev/null
    start_ts=$SECONDS
    while IFS= read -r -t 2 -u "$fd" line 2>/dev/null; do
        line="${line%$'\r'}"
        [[ -z "$line" ]] && continue
        resp+="$line"$'\n'
        [[ "$line" == "OK" || "$line" == "ERROR" ]] && break
        # Limite assoluto di 3s dall'invio di "AT", a prescindere da
        # quante righe arrivano nel frattempo: una porta che trasmette in
        # continuazione senza mai rispondere OK/ERROR (es. la porta
        # GPS/NMEA, che emette frasi NMEA di continuo) farebbe altrimenti
        # ripartire il timeout di 2s del singolo "read" ad ogni riga,
        # bloccando il probing all'infinito su quella porta.
        (( SECONDS - start_ts >= 3 )) && break
    done
    exec {fd}<&-
    printf '%s' "$resp"
}

# Autodetect (--autodetect): riempie DIAG_PORT/AT_PORT se non gia'
# specificati esplicitamente sulla riga di comando.
#
# Porta AT: prova "AT" su ogni ttyUSB* candidato, filtrato per
# vendor/modello via --autodetect-vendor/--autodetect-model (default
# vendor "SimTech": copre l'intera famiglia di moduli SimCom, non solo
# questo SIM7600E-H — per altri produttori passare --autodetect-vendor
# "Quectel" o simile, individuabile con --list-ports), e usa la prima
# candidata che risponde OK.
#
# Porta Diag: qcsuper supporta gia' un "usb-modem auto" con un matching
# robusto sui descrittori USB (bInterfaceClass/SubClass/Protocol),
# collaudato su piu' modelli di modem Qualcomm-based — molto piu'
# affidabile di un'euristica su ttyUSB0 hardcoded. Come miglioramento, si
# prova prima a restringere il campo alle interfacce dello stesso
# dispositivo fisico della porta AT trovata (stesso ID_SERIAL udev) e a
# scegliere quella con il numero di interfaccia USB piu' basso
# (convenzione osservata su questo come su altri moduli Qualcomm-based:
# l'interfaccia 0 e' la porta DM/Diag), verificando poi che sia
# realmente una porta Diag funzionante con "qcsuper --usb-modem <porta>
# --info". Se questo fallisce o non e' determinabile, si ripiega su
# "auto" e la risoluzione resta a carico di qcsuper stesso.
autodetect_ports() {
    local candidates=() p info

    for p in /dev/ttyUSB*; do
        [[ -e "$p" ]] || continue
        info=$(udevadm info -q property -n "$p" 2>/dev/null) || info=""
        if [[ -n "$AUTODETECT_VENDOR" ]]; then
            echo "$info" | grep -qi "^ID_VENDOR=.*$AUTODETECT_VENDOR" || continue
        fi
        if [[ -n "$AUTODETECT_MODEL" ]]; then
            echo "$info" | grep -qi "^ID_MODEL=.*$AUTODETECT_MODEL" || continue
        fi
        candidates+=("$p")
    done

    if [[ ${#candidates[@]} -eq 0 ]]; then
        log "ATTENZIONE: --autodetect non ha trovato nessuna porta ttyUSB corrispondente (vendor='${AUTODETECT_VENDOR:-qualsiasi}', modello='${AUTODETECT_MODEL:-qualsiasi}')."
        return
    fi
    log "Autodetect: ${#candidates[@]} porta/e candidate: ${candidates[*]}"

    if [[ -z "$AT_PORT" ]]; then
        local resp
        for p in "${candidates[@]}"; do
            resp=$(probe_at_candidate "$p") || resp=""
            if echo "$resp" | grep -q '^OK$'; then
                AT_PORT="$p"
                log "Autodetect: porta AT trovata su $p"
                break
            fi
        done
        [[ -n "$AT_PORT" ]] || log "ATTENZIONE: --autodetect non ha trovato nessuna porta AT (nessuna candidata risponde OK ad 'AT')."
    fi

    if [[ -z "$DIAG_PORT" ]]; then
        local at_serial="" diag_guess=""
        if [[ -n "$AT_PORT" ]]; then
            at_serial=$(udevadm info -q property -n "$AT_PORT" 2>/dev/null | sed -n 's/^ID_SERIAL=//p') || at_serial=""
        fi
        if [[ -n "$at_serial" ]]; then
            local q q_serial q_ifnum best_ifnum=""
            for q in "${candidates[@]}"; do
                q_serial=$(udevadm info -q property -n "$q" 2>/dev/null | sed -n 's/^ID_SERIAL=//p') || q_serial=""
                [[ "$q_serial" == "$at_serial" ]] || continue
                q_ifnum=$(udevadm info -q property -n "$q" 2>/dev/null | sed -n 's/^ID_USB_INTERFACE_NUM=//p') || q_ifnum=""
                if [[ -z "$best_ifnum" || "$q_ifnum" < "$best_ifnum" ]]; then
                    best_ifnum="$q_ifnum"
                    diag_guess="$q"
                fi
            done
        fi
        if [[ -n "$diag_guess" ]] && command -v timeout >/dev/null 2>&1 \
            && timeout 15 "${QCSUPER_CMD[@]}" --usb-modem "$diag_guess" --info >/dev/null 2>&1; then
            DIAG_PORT="$diag_guess"
            log "Autodetect: porta Diag verificata su $DIAG_PORT (qcsuper --info OK)"
        else
            DIAG_PORT="auto"
            log "Autodetect: porta Diag non determinata con certezza (o verifica qcsuper fallita), delego la risoluzione a qcsuper (--usb-modem auto)."
        fi
    fi
}

# ---- autodetect dell'operatore via MCC-MNC (usato se manca --op) -------
#
# Tentativo best-effort, silenzioso in caso di fallimento, di individuare
# l'operatore della SIM SENZA che sia stato passato --op esplicitamente:
# apre la porta AT (autodetect o esplicita, dedotta da system.conf/riga di
# comando — --op non e' ancora risolto a questo punto, ma non serve: le
# porte non dipendono piu' dall'operatore, vedi mdt_configs/system.conf),
# sblocca il PIN se necessario e disponibile (--sim-pin sulla riga di
# comando, non da un file --op che a questo punto non e' ancora stato
# scelto), interroga AT+CPSI? e ne legge il campo "MCC-MNC" (terzo campo,
# es. "222-10") — stesso campo che check_network_adequate()/
# wait_for_gps_fix() leggono piu' avanti nel flusso normale, qui pero'
# PRIMA che il resto dello script sia partito. Il risultato viene cercato
# come nome file in mdt_configs/mcc-mnc/<MCC>-<MNC>: se presente (un
# symlink relativo verso mdt_configs/op/<operatore>.conf, vedi README) ne
# segue automaticamente il target.
#
# Apre e richiude la porta AT autonomamente: nessun problema a farlo due
# volte (la porta seriale non mantiene uno stato di sessione fra
# un'apertura e l'altra), il resto del flusso la riaprira' comunque piu'
# avanti nel modo consueto. Fallisce silenziosamente (nessun errore,
# nessun --op applicato, comportamento identico a oggi) se: la porta AT
# non si trova, la SIM e' bloccata e non e' stato passato --sim-pin sulla
# riga di comando, non c'e' ancora registrazione di rete, o il file
# mdt_configs/mcc-mnc/<MCC>-<MNC> non esiste per quell'operatore.
#
# Stampa su stdout il MCC-MNC risolto (es. "222-10") e ritorna 0 solo se
# ESISTE anche il file mdt_configs/mcc-mnc/<MCC>-<MNC> corrispondente;
# altrimenti non stampa nulla e ritorna 1.
autodetect_op_via_mccmnc() {
    local probe_at_port="" probe_autodetect=0
    local probe_vendor="SimTech" probe_model="" probe_sim_pin=""
    local -a probe_args=("${SYSTEM_ARGS[@]}" "$@")
    local i

    for ((i = 0; i < ${#probe_args[@]}; i++)); do
        case "${probe_args[i]}" in
            --at-port) probe_at_port="${probe_args[i+1]:-}" ;;
            --autodetect) probe_autodetect=1 ;;
            --autodetect-vendor) probe_vendor="${probe_args[i+1]:-}" ;;
            --autodetect-model) probe_model="${probe_args[i+1]:-}" ;;
            --sim-pin) probe_sim_pin="${probe_args[i+1]:-}" ;;
        esac
    done

    if [[ -z "$probe_at_port" && "$probe_autodetect" -eq 1 ]]; then
        local p info resp
        for p in /dev/ttyUSB*; do
            [[ -e "$p" ]] || continue
            info=$(udevadm info -q property -n "$p" 2>/dev/null) || info=""
            if [[ -n "$probe_vendor" ]]; then
                echo "$info" | grep -qi "^ID_VENDOR=.*$probe_vendor" || continue
            fi
            if [[ -n "$probe_model" ]]; then
                echo "$info" | grep -qi "^ID_MODEL=.*$probe_model" || continue
            fi
            resp=$(probe_at_candidate "$p") || resp=""
            if echo "$resp" | grep -q '^OK$'; then
                probe_at_port="$p"
                break
            fi
        done
    fi
    [[ -n "$probe_at_port" && -e "$probe_at_port" ]] || return 1

    local mm_fd resp mccmnc
    stty -F "$probe_at_port" 115200 2>/dev/null || true
    stty -F "$probe_at_port" raw -echo -echoe -echok time 0 min 0 2>/dev/null || return 1
    exec {mm_fd}<>"$probe_at_port" 2>/dev/null || return 1

    local cmd tmo line r
    _mm_query() {
        cmd="$1"; tmo="${2:-5}"; r=""
        printf '%s\r' "$cmd" >&"$mm_fd"
        while IFS= read -r -t "$tmo" -u "$mm_fd" line; do
            line="${line%$'\r'}"
            [[ -z "$line" ]] && continue
            r+="$line"$'\n'
            [[ "$line" == "OK" || "$line" == "ERROR" || "$line" =~ ^\+CME\ ERROR ]] && break
        done
        printf '%s' "$r"
    }

    resp=$(_mm_query "AT+CPIN?" 5)
    if echo "$resp" | grep -q '+CPIN: SIM PIN'; then
        if [[ -n "$probe_sim_pin" ]]; then
            _mm_query "AT+CPIN=\"$probe_sim_pin\"" 8 >/dev/null
            sleep 2
        else
            exec {mm_fd}<&- 2>/dev/null || true
            return 1
        fi
    fi

    resp=$(_mm_query "AT+CPSI?" 5)
    exec {mm_fd}<&- 2>/dev/null || true
    mccmnc=$(echo "$resp" | tr -d '\r' | grep '^+CPSI:' | awk -F',' '{print $3}')
    [[ "$mccmnc" =~ ^[0-9]{3}-[0-9]{1,3}$ ]] || return 1
    [[ -e "$SCRIPT_DIR/mdt_configs/mcc-mnc/$mccmnc" ]] || return 1

    printf '%s' "$mccmnc"
    return 0
}

# ---- pre-scan di system.conf/--op/--profile/--config: espandono in -----
# ---- argomenti aggiuntivi -----------------------------------------------
#
# Stesso meccanismo di fondo per tutti e quattro: il file (tokenizzato
# rispettando le virgolette tramite xargs, solo come tokenizzatore -
# nessun eval, nessuna esecuzione) viene anteposto agli argomenti reali
# della riga di comando; il parser che segue e' sequenziale e l'ultimo
# valore vince, quindi cio' che viene DOPO ha sempre la precedenza.
#
# Ordine di precedenza (dal meno al piu' specifico):
#   mdt_configs/system.conf (se presente) < --op (config operatore) <
#   --profile (profilo di test) < --config (file esplicito) < argomenti
#   veri e propri sulla riga di comando.
# Questo indipendentemente dall'ordine in cui --op/--profile/--config
# compaiono fisicamente sulla riga di comando: l'ordine sopra e' fisso,
# cosi' system.conf fornisce i parametri di SISTEMA (porte o
# --autodetect, --qcsuper — dipendono dalla macchina/dal collegamento
# hardware, non dal test), un operatore i default di rete (APN,
# --outdir-base, --force-lte/--require-lte), un profilo la "forma" del
# test (durata, GPS, UI, --reconnect-interval, ...) sovrascrivendo dove si
# sovrappone ai livelli precedenti, --config eventuali aggiustamenti
# ulteriori, e la riga di comando vince sempre su tutto.
#
# mdt_configs/system.conf non ha un'opzione dedicata per sceglierlo (a
# differenza di --op/--profile che selezionano tra piu' file con nome):
# e' UN solo file, a percorso fisso relativo allo SCRIPT, caricato
# automaticamente se presente (silenziosamente ignorato se assente — una
# copia del progetto senza system.conf ancora generato si comporta come
# prima, nessuna porta/qcsuper di default). Generato/aggiornato da
# install.sh (vedi --configure-system nel suo --help).
#
# --op NOME risolve da solo il file in mdt_configs/op/NOME.conf,
# --profile NOME in mdt_configs/profile/NOME.conf, entrambi relativi alla
# posizione dello SCRIPT (non alla directory corrente): funzionano quindi
# indipendentemente da dove si lancia mdtcap. --config FILE resta invece
# un percorso esplicito, come sempre. Nessuno di questi quattro supporta
# un altro system.conf/--op/--profile/--config annidato al proprio
# interno (verrebbe ignorato come argomento "gia' risolto", stessa
# restrizione gia' in vigore per --config).

# Trova il valore di un'opzione tra gli argomenti indicati, senza alterare
# "$@": usata per il pre-scan indipendente di --op/--profile/--config,
# che possono comparire insieme in qualsiasi ordine sulla riga di comando.
find_arg_value() {
    local want="$1"; shift
    local args=("$@") i
    for ((i = 0; i < ${#args[@]}; i++)); do
        if [[ "${args[i]}" == "$want" ]]; then
            printf '%s' "${args[i+1]:-}"
            return 0
        fi
    done
}

# Tokenizza un file di config (righe vuote/commento a riga intera
# ignorate) in un argomento per riga di output.
tokenize_config_file() {
    grep -v '^[[:space:]]*#' "$1" | grep -v '^[[:space:]]*$' | xargs -n1 printf '%s\n'
}

OP_NAME=$(find_arg_value --op "$@")
PROFILE_NAME=$(find_arg_value --profile "$@")
CONFIG_FILE=$(find_arg_value --config "$@")

SYSTEM_FILE="$SCRIPT_DIR/mdt_configs/system.conf"
SYSTEM_ARGS=()
if [[ -f "$SYSTEM_FILE" ]]; then
    readarray -t SYSTEM_ARGS < <(tokenize_config_file "$SYSTEM_FILE")
fi

# Autodetect via MCC-MNC (vedi autodetect_op_via_mccmnc sopra): solo se
# --op non e' stato passato esplicitamente, e solo per un'esecuzione che
# finirebbe davvero per aprire la porta AT (non in modalita' replay, non
# per un --list-ports/--help che non devono toccare l'hardware). Best-
# effort e silenzioso: se fallisce per qualunque motivo, il comportamento
# resta quello di sempre (nessun --op applicato).
OP_FILE=""
OP_MCCMNC=""
if [[ -z "$OP_NAME" ]] \
    && [[ -z "$(find_arg_value --analyze-dlf "$@")" ]] \
    && [[ -z "$(find_arg_value --analyze-pcap "$@")" ]] \
    && [[ " $* " != *" --list-ports "* ]] \
    && [[ " $* " != *" -h "* && " $* " != *" --help "* ]]; then
    OP_MCCMNC=$(autodetect_op_via_mccmnc "$@" 2>/dev/null) || OP_MCCMNC=""
    if [[ -n "$OP_MCCMNC" ]]; then
        OP_FILE="$SCRIPT_DIR/mdt_configs/mcc-mnc/$OP_MCCMNC"
        OP_NAME="$(basename "$(readlink "$OP_FILE")" .conf)"
        # Sotto --tui non serve: l'operatore rilevato compare gia' come
        # primo pallino della sezione "Informazioni:" (vedi
        # tui_build_steps()). TUI_ENABLED non e' ancora noto qui (il
        # parsing degli argomenti vero e proprio e' piu' sotto): si
        # pre-scansiona "$@" direttamente, stesso stile gia' usato sopra
        # per --list-ports/--help.
        [[ " $* " == *" --tui "* ]] || \
            echo "Operatore auto-rilevato via MCC-MNC $OP_MCCMNC: $OP_NAME (mdt_configs/mcc-mnc/$OP_MCCMNC -> mdt_configs/op/${OP_NAME}.conf)" >&2
    fi
fi

OP_ARGS=()
if [[ -n "$OP_FILE" ]]; then
    readarray -t OP_ARGS < <(tokenize_config_file "$OP_FILE")
elif [[ -n "$OP_NAME" ]]; then
    OP_FILE="$SCRIPT_DIR/mdt_configs/op/${OP_NAME}.conf"
    if [[ ! -f "$OP_FILE" ]]; then
        echo "Operatore sconosciuto per --op: '$OP_NAME' (file non trovato: $OP_FILE)" >&2
        echo "Operatori disponibili in $SCRIPT_DIR/mdt_configs/op/:" >&2
        for f in "$SCRIPT_DIR"/mdt_configs/op/*.conf; do
            [[ -f "$f" ]] && echo "  - $(basename "$f" .conf)" >&2
        done
        exit 1
    fi
    readarray -t OP_ARGS < <(tokenize_config_file "$OP_FILE")
fi

PROFILE_ARGS=()
if [[ -n "$PROFILE_NAME" ]]; then
    PROFILE_FILE="$SCRIPT_DIR/mdt_configs/profile/${PROFILE_NAME}.conf"
    if [[ ! -f "$PROFILE_FILE" ]]; then
        echo "Profilo sconosciuto per --profile: '$PROFILE_NAME' (file non trovato: $PROFILE_FILE)" >&2
        echo "Profili disponibili in $SCRIPT_DIR/mdt_configs/profile/:" >&2
        for f in "$SCRIPT_DIR"/mdt_configs/profile/*.conf; do
            [[ -f "$f" ]] && echo "  - $(basename "$f" .conf)" >&2
        done
        exit 1
    fi
    readarray -t PROFILE_ARGS < <(tokenize_config_file "$PROFILE_FILE")
fi

CONFIG_ARGS=()
if [[ -n "$CONFIG_FILE" ]]; then
    [[ -f "$CONFIG_FILE" ]] || { echo "File di configurazione non trovato: $CONFIG_FILE" >&2; exit 1; }
    readarray -t CONFIG_ARGS < <(tokenize_config_file "$CONFIG_FILE")
fi

set -- "${SYSTEM_ARGS[@]}" "${OP_ARGS[@]}" "${PROFILE_ARGS[@]}" "${CONFIG_ARGS[@]}" "$@"

# ---- parsing argomenti -------------------------------------------------

