#!/usr/bin/env bash
#
# mdtcap
#
# Tool per rilevare le evidenze di tracciamento/utilizzo dell'MDT
# (Minimization of Drive Tests) con posizione dell'utente o del terminale:
# acquisisce in modo forense il traffico Diag/RRC da un modulo
# Qualcomm-based (es. SIM7600E-H) tramite qcsuper, con contesto AT
# pre/post cattura, log periodico di cella/posizione e hashing dei file
# per catena di custodia.
#
# Licenza: GNU General Public License v3.0 (GPLv3) — vedi LICENSE.
# Autore:  EPTO Tramaci
#
# Uso:
#   sudo ./mdtcap --list-ports
#   sudo ./mdtcap --diag-port /dev/ttyUSB0 --at-port /dev/ttyUSB2 \
#       --qcsuper /path/to/qcsuper.py [--outdir DIR | --outdir-base DIR] [--duration SECONDS] \
#       [--gps] [--gps-interval SECONDS] [--baud 115200] [--label "descrizione"] \
#       [--sim-pin PIN] [--require-lte] [--lte-wait SECONDS] \
#       [--gps-wait SECONDS] [--net-attach-wait SECONDS] [--lbs] \
#       [--lat-margin GRADI] [--lon-margin GRADI] \
#       [-v | --verbose] [--verbose-interval SECONDS] [--tui [--mdt-led]] \
#       [--apn APN] [--force-lte] \
#       [--reconnect-interval SECONDS [--reconnects N]] \
#       [--op OPERATORE] [--profile PROFILO] [--config FILE] \
#       [--report] [--beep] \
#       [--parla-chiaro] [--no-banner] [--shm /dev/shm/mdtcap] \
#       [--autodetect [--autodetect-vendor STRINGA] [--autodetect-model STRINGA]] \
#       [--usb-modem [--usb-modem-vid VID --usb-modem-pid PID]] \
#       [--extended [--ext-profile NOME]] [--test-sms]
#
#   sudo ./mdtcap --autodetect --qcsuper /path/to/qcsuper.py \
#       --duration 160 [...]   # --diag-port/--at-port diventano opzionali
#
#   sudo ./mdtcap --analyze-dlf /percorso/capture_precedente.dlf \
#       --qcsuper /path/to/qcsuper.py [--outdir DIR | --outdir-base DIR] \
#       [--report] [--parla-chiaro] [--beep] [--label "..."]
#       # modalita' replay: nessun device, --diag-port/--at-port/--autodetect
#       # non servono e vengono ignorati (vedi --analyze-dlf sotto)
#
#   sudo ./mdtcap --analyze-pcap /percorso/capture.pcap \
#       [--outdir DIR | --outdir-base DIR] \
#       [--report] [--parla-chiaro] [--beep] [--label "..."]
#       # modalita' replay da pcap: nessun device, nessun .dlf, non serve
#       # nemmeno --qcsuper (vedi --analyze-pcap sotto)
#
# --sim-pin: se la SIM richiede il PIN, viene inviato via AT+CPIN prima di
#   avviare la cattura. ATTENZIONE: il PIN passato sulla riga di comando e'
#   visibile a chiunque abbia accesso a `ps aux` su questo host mentre lo
#   script gira. Un PIN errato NON viene ritentato automaticamente (per non
#   rischiare di bloccare la SIM dopo 3 tentativi falliti).
#
# --require-lte: prima di avviare la cattura verifica (via AT+CPSI?) che il
#   modem sia agganciato a una cella LTE. Gli IE che lo script estrae
#   (loggedMeasurementConfiguration/locationInfo r10/r11/r16/coarseLocationInfo-r17) sono definiti
#   solo in LTE-RRC: su GSM/WCDMA la cattura completa ma non produce dati
#   MDT utili. Se la rete non e' LTE, riprova ogni 5s fino a --lte-wait
#   secondi (default 0 = singola verifica, nessuna attesa); se allo scadere
#   non e' ancora LTE lo script ABORTISCE (exit 2) senza avviare qcsuper.
#
# --gps-wait SECONDS: attiva il GPS/GNSS del modulo (AT+CGPS=1, se non gia'
#   attivo con --gps) e attende fino a SECONDS secondi un fix valido
#   (AT+CGPSINFO con latitudine non vuota), riprovando ogni 5s. A differenza
#   di --require-lte NON blocca la cattura: se allo scadere non c'e' fix,
#   logga un'ATTENZIONE e procede comunque. Utile per avere un ground-truth
#   di posizione, se disponibile, senza far fallire l'intera acquisizione.
#
# --net-attach-wait SECONDS: tenta l'attach alla rete dati (AT+CGATT=1) e
#   l'attivazione del contesto PDP 1 (AT+CGACT=1,1), poi verifica ogni 5s
#   fino a SECONDS secondi che il modem risulti "connesso" (CGATT: 1 e
#   contesto PDP 1 attivo, con relativo indirizzo IP se assegnato via
#   AT+CGPADDR). Non serve e non configura uno stack PPP/rete locale: basta
#   che il modem stesso risulti connesso a livello dati. Non blocca la
#   cattura in caso di esito negativo.
#
# --lbs: interroga il servizio di localizzazione lato rete (Cell Location
#   Based Service, AT+CLBS=4: latitudine/longitudine/data/ora/precisione
#   stimate dall'operatore/server LBS di SIMCom a partire dalla cella
#   servente, senza GPS). Richiede il contesto dati attivo: se non e' gia'
#   stabilito con --net-attach-wait, lo script tenta comunque l'attach
#   prima di interrogare il servizio. Risultato salvato in lbs_query.txt.
#   Non blocca la cattura in caso di esito negativo (servizio non
#   abilitato sul piano/SIM, o timeout).
#
# -v, --verbose: mostra un'anteprima del contenuto decodificato dei
#   pacchetti via via che vengono catturati, invece di vederli solo a fine
#   cattura. ATTENZIONE tecnica: qcsuper scrive il .pcap in modo bufferizzato
#   (i frame restano nel buffer finche' non si accumulano alcuni KB o il
#   processo termina), quindi non esiste un vero streaming pacchetto-per-
#   pacchetto dalla porta Diag al terminale. La modalita' verbose aggira il
#   problema rileggendo periodicamente (ogni --verbose-interval secondi,
#   default 15) il file .dlf gia' scritto su disco (quello si' incrementale)
#   con `qcsuper --dlf-read`, e stampa a terminale — via tshark, decodificati
#   — solo i pacchetti nuovi rispetto alla lettura precedente. E' quindi
#   un'anteprima "quasi in tempo reale" (latenza pari a --verbose-interval,
#   di piu' se il volume di traffico rende la rilettura piu' lenta
#   dell'intervallo), non un vero live streaming. Richiede tshark; se non
#   disponibile la richiesta viene ignorata con un'ATTENZIONE, senza
#   bloccare la cattura.
#
# --tui: alternativa a --verbose (mutualmente esclusiva: non usarle
#   insieme) per capire in tempo reale cosa sta facendo lo script, invece
#   di leggere il testo di log che scorre. Mostra due sezioni, separate da
#   una riga vuota, ridisegnate sul posto ad ogni cambio di stato (stessi
#   codici escape ANSI di --verbose, nessuna libreria esterna):
#
#   "Stato:" — pallini sempre presenti (indipendenti dalle opzioni
#     attive), che riflettono cosa sta succedendo DAVVERO sulla rete/GPS/
#     RRC in questo momento, aggiornati periodicamente anche durante
#     un'attesa lunga come "Cattura in corso" (non solo nei passi che li
#     toccano direttamente in fase di pre-cattura):
#       - Stato rete: verde se agganciata in LTE, arancione se su un
#         altro RAT (2G/3G) o senza servizio (con l'ultimo stato noto in
#         nota), grigio finche' non c'e' ancora nessun dato. Alimentato
#         dal logger periodico cella/GPS (gia' attivo comunque durante la
#         cattura): costo aggiuntivo trascurabile, sempre presente.
#       - Stato GPS: verde con le coordinate (gradi decimali con segno,
#         "lat, lon" — stesso formato che si incollerebbe su Google Maps,
#         non il dato NMEA grezzo di AT+CGPSINFO) se c'e' un fix valido,
#         arancione se al momento non c'e' fix, grigio se il GPS non e'
#         mai stato richiesto in questa esecuzione o non c'e' ancora
#         nessun dato. Stessa fonte di "Stato rete", stesso costo
#         trascurabile, sempre presente.
#       - Warning diag port: verde con "0" finche' qcsuper non ha scritto
#         nessun avviso (WARNING) in qcsuper.log, arancione con il numero
#         di avvisi non appena ne compare almeno uno, grigio finche' la
#         porta diag non e' ancora stata aperta. Conta SOLO avvisi legati
#         ai dati ricevuti dalla porta Diag (tipicamente frame HDLC
#         scartati per CRC errato — vedi compute_diag_warn_count() per il
#         criterio esatto): non conta MAI avvisi non pertinenti ai dati,
#         es. "eseguire come root e' pericoloso" (quello e' un avviso di
#         tshark durante l'estrazione successiva, non di qcsuper — finisce
#         in tshark_report.err, un file diverso). Stessa fonte/costo di
#         "Stato rete"/"Stato GPS", sempre presente.
#       - Errori diag port: come "Warning diag port" sopra ma per le righe
#         "| ERROR @ " di qcsuper.log (vedi compute_diag_error_count()),
#         bullet ROSSO (non arancione) con il numero non appena ne compare
#         almeno uno: un ERROR e' piu' grave di un semplice WARNING, ad
#         esempio un timeout nella richiesta con cui qcsuper abilita un
#         tipo di log sul modem. Se capita, quel tipo di traffico non
#         finisce MAI nel .dlf per l'intera cattura, silenziosamente, e
#         "Warning diag port" da solo NON lo segnala. Stessa fonte/costo
#         dei precedenti, sempre presente.
#       - GPS in frame scartati/non decodificati, Setup MDT in frame
#         scartati/non decodificati: a differenza dei tre sopra, NON sono
#         aggiornati in tempo reale (restano grigi per tutta la cattura),
#         solo alla fine (calcolati insieme, una volta sola, da
#         compute_bitscan_warnings() — vedi il commento "warnPosD/
#         warnPosL/warnMDTD/warnMDTL" in testa allo script per il
#         significato completo). Nota "diag:N log:N": N e' sempre 0/0 se
#         "Warning diag port" e' rimasto a 0 (nessun avviso = scansione
#         non eseguita); arancione se almeno uno dei due N e' > 0
#         (qualcosa da controllare a mano nel report), verde se la
#         scansione e' girata senza trovare nulla.
#       - Stato MDT (solo con --mdt-led, vedi sotto: NON presente di
#         default): grigio se non c'e' ancora traffico LTE-RRC nella
#         cattura, rosso se e' comparsa una richiesta di configurazione
#         MDT e/o una risposta dell'UE con posizione (stessa logica di
#         --report/--parla-chiaro), verde se c'e' traffico RRC ma nessuna
#         di quelle condizioni (tutto bene).
#
# --mdt-led: attiva il pallino "Stato MDT" descritto sopra (nessun effetto
#   senza --tui, ignorato con un avviso). Disattivato di default perche',
#   a differenza degli altri due pallini di stato, ha un costo reale: un
#   monitor dedicato rilegge periodicamente il .dlf in crescita (stessa
#   tecnica di --verbose: qcsuper --dlf-read su una copia + tshark, mai in
#   conflitto perche' -v/--tui sono mutualmente esclusive), il che vuol
#   dire lanciare un intero processo qcsuper (10-20s solo per l'import di
#   pycrate su Raspberry Pi, vedi nota su --duration piu' sotto) piu' 4
#   chiamate tshark ogni 15s, IN PARALLELO al processo di cattura live
#   vero e proprio. Su un Raspberry Pi questo carico periodico compete per
#   CPU/IO con qcsuper e, se lo affama abbastanza a lungo, puo' causare un
#   overrun sul buffer della porta Diag USB (dati persi nella cattura per
#   un effetto collaterale della UI, non per un problema della cattura in
#   se'): usare solo quando serve davvero vedere l'esito MDT in tempo
#   reale ed e' accettabile il costo aggiuntivo.
#
#   "Operazioni:" — una riga per ogni azione prevista in base alle
#     opzioni attive per questa esecuzione (con --autodetect e' sempre la
#     PRIMA della lista, "Rilevamento porte": la ricerca impiega qualche
#     secondo, senza questo passo lo script sembrerebbe non fare nulla in
#     quella finestra; sblocco PIN, APN, forzatura LTE, verifica rete,
#     GPS, attach dati, LBS, cattura, arresto, estrazione tshark, report,
#     hash, manifest, ... — con --reconnect-interval compare anche "Test
#     riconnessione", che torna in giallo ad ogni ciclo e riporta in nota
#     quanti ne sono stati completati), con un pallino colorato a
#     sinistra: grigio = da fare,
#     giallo = in corso (con timer
#     [MM:SS], o [MM:SS/MM:SS] se l'attesa ha un tetto massimo noto, es.
#     --lte-wait/--gps-wait/--net-attach-wait/--duration), verde =
#     completato con successo, rosso = errore (incluso un esito che fa
#     abortire lo script, es. --require-lte non soddisfatto), arancione =
#     saltato/non bloccante (es. nessun fix GPS entro --gps-wait: lo
#     script prosegue comunque, per costruzione — l'LBS invece e' sempre
#     verde, una risposta assente e' un esito normale).
#
#   Sotto --tui il testo di log smette di scorrere a terminale (resta
#   comunque scritto per intero, invariato, in session.log): l'output di
#   --report/--parla-chiaro, se richiesti, viene comunque stampato per
#   intero, ma spostato in fondo, DOPO le due sezioni, invece che
#   frammisto al log. Non supportato (e ignorato, con un avviso) in
#   modalita' replay (--analyze-dlf/--analyze-pcap): esecuzioni troppo
#   brevi perche' serva.
#
# Log dedicato "richieste MDT/posizione dalla rete" (sempre attivo, non
#   richiede opzioni): a fine cattura lo script isola, con un filtro tshark
#   piu' ampio di quello del solo report MDT, l'intero scambio con cui
#   l'operatore chiede esplicitamente all'UE le misure/la posizione
#   registrate — non solo la configurazione del logging
#   (loggedMeasurementConfiguration), ma anche la richiesta di invio
#   (ueInformationRequest / logMeasReportReq) e la risposta dell'UE
#   (ueInformationResponse / logMeasReport / locationInfo, che puo'
#   includere la posizione da GPS/GNSS se il modulo l'aveva accesso, vedi
#   --gps-wait). Produce mdt_location_requests.txt (decodifica completa) e
#   mdt_location_requests_summary.csv (una riga per evento: frame, orario
#   UTC, tempo relativo, descrizione). Se e' stata usata anche -v, ogni
#   evento di questo tipo viene inoltre segnalato a terminale in tempo
#   (quasi) reale con un banner "RICHIESTA MDT/POSIZIONE DALLA RETE".
#
# --apn APN: imposta l'APN sul contesto PDP 1 (AT+CGDCONT=1,"IP",APN)
#   subito dopo lo sblocco PIN (su alcuni modem AT+CGDCONT in scrittura
#   risponde ERROR se la SIM e' ancora bloccata) e prima di qualunque altra
#   operazione di rete. Utile quando l'APN residuo di fabbrica/da un uso
#   precedente (es. "CMNET") non e' quello
#   dell'operatore reale della SIM: un APN sbagliato causa il rifiuto
#   dell'attach dati/LTE ("Missing or unknown APN"). Non bloccante: logga
#   l'esito e prosegue comunque. Indipendente da --force-lte: puo' essere
#   usato anche da solo, es. insieme a --net-attach-wait/--lbs.
#
# --force-lte: automatizza la procedura (fatta manualmente in una sessione
#   precedente) per sbloccare l'aggancio LTE quando la rete e' raggiungibile
#   ma il modem resta su GSM/WCDMA: forza la modalita' LTE-only
#   (AT+CNMP=38, cosi' non ripiega piu' automaticamente su altri RAT) e
#   cicla il radio (AT+CFUN=0 poi AT+CFUN=1) per forzare un nuovo tentativo
#   di attach. Il ciclo CFUN richiede di norma un nuovo sblocco PIN, che
#   viene ritentato automaticamente se e' stato passato --sim-pin. A fine
#   cattura il modo di rete viene ripristinato su automatico (AT+CNMP=2),
#   per non lasciare il modem forzato in LTE-only oltre la sessione di
#   test (rischio di restare senza servizio se la copertura LTE cala).
#   Non bloccante e non verifica da solo l'esito: logga lo stato rete dopo
#   il ciclo, ma per attendere/verificare/abortire esplicitamente in base
#   al risultato va combinato con --require-lte --lte-wait SECONDS (come
#   fatto manualmente in precedenza). Spesso usato insieme a --apn, quando
#   il motivo per cui l'attach LTE falliva era proprio un APN errato.
#
#   La cattura (qcsuper) viene avviata da questa stessa opzione PRIMA del
#   ciclo CFUN, non dopo: la configurazione MDT
#   (loggedMeasurementConfiguration) viaggia tipicamente dentro la
#   RRCConnectionReconfiguration successiva a un nuovo attach, quindi e'
#   proprio l'evento di riconnessione forzata qui sopra il momento in cui
#   un operatore potrebbe inviarla. Se la cattura partisse solo a fine
#   ciclo (comportamento di una versione precedente di questo script),
#   quella sequenza non sarebbe mai osservabile. Prima del ciclo vero e
#   proprio lo script attende che l'avvio di qcsuper sia concluso (vedi la
#   nota sull'import ASN.1/pycrate qualche riga sotto), cosi' la cattura e'
#   gia' pronta a registrare pacchetti quando la riconnessione avviene.
#
# --reconnect-interval SECONDS: "trappola" per lo stesso motivo di cui
#   sopra, ma ripetuta piu' volte nel corso di un'unica cattura invece che
#   una sola all'inizio: ogni SECONDS secondi durante "Cattura in corso"
#   (non in fase di pre-cattura), cicla il radio (AT+CFUN=0 poi
#   AT+CFUN=1, stessa procedura di --force-lte, incluso il ritentativo del
#   PIN se serve) forzando un nuovo attach, SENZA mai fermare/riavviare
#   qcsuper: la cattura resta continua e unica, con dentro tutti gli
#   eventi di riconnessione verificatisi. Indipendente da --force-lte
#   (funziona anche da solo, ciclando sul RAT che la rete assegna
#   automaticamente). Il conteggio del tempo usa la stessa granularita' di
#   --gps-interval (default 30s): il ciclo scatta al primo giro utile
#   dopo che sono trascorsi almeno SECONDS secondi dal precedente, non
#   esattamente al secondo. Un valore troppo basso (sotto ai ~15-20s che
#   il solo ciclo CFUN+assestamento richiede) produce un avviso ma non
#   viene bloccato. Con --tui compare come voce "Test riconnessione" (solo
#   se questa opzione e' attiva), che riporta il numero di cicli
#   completati e l'ultimo stato di rete osservato. Per default (senza
#   --reconnect-interval) questo test NON viene mai eseguito: nessun
#   ciclo radio aggiuntivo oltre a quello eventuale di --force-lte.
#
# --reconnects N: mette un tetto massimo al numero di cicli eseguiti da
#   --reconnect-interval (di cui non ha alcun effetto senza, ignorato con
#   un avviso): raggiunto N, il test di riconnessione smette di ciclare
#   per il resto della cattura (che prosegue comunque fino alla scadenza
#   di --duration). Serve a non aumentare senza controllo il numero di
#   riconnessioni della SIM su catture molto lunghe con un intervallo
#   basso. Default 0 = nessun tetto (comportamento invariato: cicla per
#   tutta la durata della cattura).
#
# --op OPERATORE / --profile PROFILO: scorciatoie per --config che
#   risolvono da sole il percorso del file, relativo alla posizione dello
#   SCRIPT (non alla directory da cui si lancia mdtcap):
#     --op OPERATORE   -> mdt_configs/op/OPERATORE.conf
#     --profile PROFILO -> mdt_configs/profile/PROFILO.conf
#   La cartella "op" contiene le configurazioni di rete/operatore (APN,
#   --outdir-base, --force-lte/--require-lte, ...); "profile" contiene la
#   "forma" del test (durata, GPS, LBS, UI, --reconnect-interval, ...),
#   pensata per essere combinata con un --op ma indipendente dall'
#   operatore. Ne' l'una ne' l'altra contengono porte/--autodetect/
#   --qcsuper: quelli sono parametri di SISTEMA, vivono in
#   mdt_configs/system.conf (vedi sopra, caricato automaticamente).
#   --op/--profile si possono usare insieme o da soli. Ordine di
#   precedenza completo, dal meno al piu' specifico (l'ultimo vince su
#   quanto si sovrappone):
#     system.conf  <  --op  <  --profile  <  --config  <  argomenti veri
#     e propri sulla riga di comando (questi ultimi vincono sempre su
#     tutto)
#   indipendentemente dall'ordine in cui --op/--profile/--config compaiono
#   fisicamente sulla riga di comando. Operatore/profilo sconosciuti
#   (file non trovato) fanno abortire lo script (exit 1) elencando le
#   opzioni disponibili nella rispettiva cartella. Nessuno dei tre
#   supporta un altro --op/--profile/--config annidato al proprio interno
#   (verrebbe ignorato come argomento "gia' risolto").
#
# Autodetect dell'operatore via MCC-MNC (se --op non e' passato): prima
#   di qualunque altra cosa (persino prima del banner iniziale) lo script
#   apre brevemente la porta AT (autodetect o esplicita, dedotta da
#   system.conf/riga di comando — non serve ancora sapere quale --op
#   usare, le porte non dipendono piu' dall'operatore), sblocca il PIN se
#   necessario e disponibile (--sim-pin sulla riga di comando), interroga
#   AT+CPSI? e ne legge il campo MCC-MNC (es. "222-10"). Se esiste un
#   file mdt_configs/mcc-mnc/<MCC>-<MNC> (pensato come symlink relativo
#   verso mdt_configs/op/<operatore>.conf, ma funziona anche con un file
#   vero e proprio) lo usa esattamente come un --op scelto a mano — nel
#   log/manifest compare pero' come "auto MCC-MNC <codice>", non "--op",
#   per lasciare chiaro che non e' stato specificato dall'utente.
#   Completamente best-effort e silenzioso in caso di fallimento (porta
#   AT non trovata, SIM bloccata senza --sim-pin, nessuna registrazione
#   di rete ancora, MCC-MNC senza file corrispondente, ...): senza
#   operatore auto-rilevato lo script si comporta esattamente come prima
#   di questa funzione (nessun --op applicato). Salta il tentativo (nessun
#   accesso alla porta) se e' gia' stato passato --op esplicitamente, o se
#   la riga di comando contiene --analyze-dlf/--analyze-pcap (nessun
#   device coinvolto in quelle modalita') o --list-ports/--help (non
#   devono toccare l'hardware).
#
# --config FILE: legge argomenti aggiuntivi da un file di testo, uno o
#   piu' per riga, con la stessa sintassi della riga di comando (es. una
#   riga "--duration 160", un'altra "-v", ecc.). Le righe vuote e quelle
#   che iniziano con # (dopo eventuali spazi) sono ignorate come commenti
#   a riga intera; non sono supportati commenti in coda alla riga. I
#   valori con spazi vanno tra virgolette (es. --label "test alpha"): il
#   file viene tokenizzato rispettando le virgolette (via xargs, senza
#   eval — non esegue nulla, ma comunque non va usato con file di cui non
#   ci si fida). Gli argomenti nel file fanno da default: quelli passati
#   davvero sulla riga di comando hanno sempre la precedenza (vengono
#   applicati dopo, quindi sovrascrivono). --config annidati dentro il
#   file non sono supportati. Esempio minimo di file:
#     --diag-port /dev/ttyUSB0
#     --at-port /dev/ttyUSB2
#     --qcsuper /usr/local/bin/qcsuper
#     --duration 160
#     --sim-pin 1234
#     --apn iliad
#     --force-lte
#     --require-lte --lte-wait 30
#     -v
#
# --report: a fine cattura stampa (e salva in report_finale.txt, incluso
#   nell'hashing) un riepilogo sintetico ricavato da tshark sul .pcap:
#     Test: OK se e' stato rilevato traffico LTE-RRC nella cattura
#       (condizione necessaria per superare il test), altrimenti ERRORE.
#     Operatore: cosa ha chiesto la rete — "OK" se non e' arrivata nessuna
#       richiesta MDT (loggedMeasurementConfiguration/ueInformationRequest);
#       altrimenti una lista tra "MDT" (richiesta presente), "GPS"
#       (la risposta dell'UE include una posizione), "Attiva" (la rete ha
#       esplicitamente richiesto l'invio delle misure via
#       logMeasReportReq, non solo configurato il logging).
#     UE: "GPS" se l'UE ha risposto includendo una posizione, altrimenti
#       "OK".
#     RRC: numero di risposte RRC dell'UE (ueInformationResponse/
#       logMeasReport), con il dettaglio di quante includono la posizione
#       GPS e quante no.
#     MDT: numero di richieste MDT ricevute dalla rete (elemento separato
#       dalle risposte dell'UE sopra).
#     Warning diag port: numero di avvisi (WARNING) scritti da qcsuper in
#       qcsuper.log durante l'intera cattura live (vedi
#       compute_diag_warn_count() — tipicamente frame HDLC scartati per
#       CRC errato). 0 in modalita' replay (qcsuper.log non esiste).
#     Errori diag port: come sopra ma per le righe "| ERROR @ " (vedi
#       compute_diag_error_count()), SEPARATO da "Warning diag port": un
#       ERROR (es. timeout nella richiesta con cui qcsuper abilita un tipo
#       di log sul modem) puo' lasciare "Warning diag port" a 0 pur avendo
#       impedito la cattura di un intero tipo di traffico per tutta la
#       sessione (es. traffico SMS/NAS, invisibile a
#       SMSSTK.silent_sms/--test-sms pur essendo arrivato realmente). Se
#       > 0, riga aggiuntiva di attenzione stampata subito sotto. 0 in
#       modalita' replay, stesso motivo di "Warning diag port".
#     Warning posizione (diag)/(log), Warning MDT (diag)/(log): risultato
#       di compute_bitscan_warnings() (warnPosD/warnPosL/warnMDTD/warnMDTL
#       nel manifest, vedi il commento omonimo in testa allo script) — 0
#       se "Warning diag port" sopra e' 0 (scansione non eseguita).
#     Autorizzazione IMEI: presente SOLO se l'IMEI letto in questa
#       cattura e' diverso da quello ORIGINALE salvato in
#       mdt_configs/imei (segno che e' stato cambiato, presumibilmente
#       con mdtimei) E src/testauth trova un'autorizzazione valida
#       per questo device/ICCID/IMEI/contractId (vedi
#       compute_imei_context()) — la stringa e' il campo AUTH
#       dell'autorizzazione trovata. Puramente informativo: mdtcap non
#       blocca mai la cattura in base a questo, ne' in un senso ne'
#       nell'altro.
#     Risultato: descrizione testuale che combina quanto sopra (test non
#       riuscito / dati insufficienti - nessuna risposta RRC di alcun tipo
#       / richiesta MDT presente o assente / UE con o senza posizione).
#   NOTA: in assenza di traffico MDT osservato durante lo sviluppo (nessun
#   operatore disponibile lo ha mai attivato in questa sessione), la
#   classificazione "GPS"/"Attiva" per il campo Operatore si basa sugli IE
#   RRC verificabili via tshark (locationInfo, logMeasReportReq) piuttosto
#   che su un test empirico con richieste MDT reali: verificare che
#   corrisponda a quanto atteso se/quando si osserva traffico MDT vero.
#
# --beep: a fine esecuzione (successo o abort, qualunque sia l'esito)
#   invia un carattere BEL (codice 7) al terminale, per un avviso sonoro
#   quando lo script termina senza dover restare a guardare il terminale.
#   Implica sempre --parla-chiaro (anche se non passato esplicitamente) e
#   fa seguire al beep "Premere un tasto per continuare...", in attesa di
#   una pressione prima di mostrare il messaggio finale — tempo per
#   vedere l'elenco --tui appena completato prima che il risultato lo
#   segua. Innocuo se lanciato senza un terminale vero collegato a stdin
#   (es. sotto mdtmain durante il test locale/USB, che riserva stdin al
#   proprio poll tastiera): la lettura ritorna subito, nessuna attesa —
#   ma il testo "Premere un tasto..." resta comunque stampato per
#   un istante prima che mdtmain ridisegni lo schermo con la propria
#   msgbox, il che risultava visivamente confuso: mdtmain passa quindi
#   sempre --no-beep (sotto), che disattiva l'intero blocco (BEL, testo,
#   pausa) mantenendo pero' --report/--parla-chiaro (gia' passati
#   esplicitamente dai profili, indipendenti da --beep).
#
# --no-beep: disattiva --beep (l'ultimo dei due passati vince, come
#   qualunque flag booleano su questa riga di comando) senza dover
#   toccare i file di profilo che lo includono (mdt_configs/profile/*)
#   — pensato per mdtmain, che aggiunge sempre questo flag DOPO
#   --profile per i propri test guidati da dialog (mai per
#   "mdtmain --run-local", che lascia il comportamento originale di
#   mdtcap intatto per scopi di debug).
#

# --outdir-base DIR: alternativa a --outdir (non usabili insieme) che
#   evita di comporre a mano il path con il timestamp: crea (se serve) DIR
#   e, dentro, una sottodirectory con nome puramente numerico
#   AAAAMMGGhhmmss (anno/mese/giorno/ore/minuti/secondi UTC, stesso istante
#   usato per timestampare i file della cattura) che diventa l'outdir
#   effettivo. Es. --outdir-base /root/mdt_evidence produce una cartella
#   tipo /root/mdt_evidence/20260903224542.
#
#   Default (senza ne' --outdir ne' --outdir-base, ne' esplicitamente ne'
#   via system.conf/--op/--profile/--config): si comporta come se fosse
#   stato passato --outdir-base log/data (log/data/<AAAAMMGGhhmmss>,
#   accanto a questo script) — cosi' le catture finiscono in un posto
#   prevedibile del progetto invece che nella directory da cui e' stato
#   lanciato mdtcap.
#
# --parla-chiaro: pensato per chi non conosce l'MDT/RRC e non deve
#   interpretare i campi tecnici di --report — stampa (e aggiunge in coda
#   a report_finale.txt, con un separatore se --report ha gia' scritto il
#   resto) una singola riga "Risultato: <frase>" in linguaggio semplice:
#     "Qualcosa e' andato storto."            se errori o rete non LTE
#     "Non lo so, mi serve piu' tempo."       se non c'e' traffico RRC
#     "Stacca, stacca, stacca, ti stanno tracciando!"
#                                              se sono state inviate
#                                              coordinate GPS dall'UE,
#                                              oppure la rete ha chiesto
#                                              esplicitamente l'invio delle
#                                              misure (logMeasReportReq) —
#                                              questa seconda condizione fa
#                                              scattare l'avviso A
#                                              PRESCINDERE dal fatto che LA
#                                              RISPOSTA IN QUESTA CATTURA
#                                              includa o no una posizione:
#                                              il banco di prova e' un
#                                              modem/SIM isolato, non il
#                                              telefono che userebbe
#                                              davvero l'utente finale, e
#                                              un UE diverso potrebbe
#                                              rispondere alla stessa
#                                              richiesta includendola — e'
#                                              la richiesta esplicita della
#                                              rete in se' il segnale
#                                              rilevante
#     "Tutto bene."                           altrimenti (nessuna
#                                              coordinata GPS richiesta o
#                                              inviata)
#   Funziona anche senza --report (autonomo). Non influisce sul campo
#   "Risultato" gia' prodotto da --report, che resta tecnico: le due righe
#   convivono se entrambe le opzioni sono attive.
#
# --no-banner: disabilita la presentazione iniziale ("MDTCap ver ...",
#   copyright) che lo script stampa per default subito dopo aver letto
#   gli argomenti (anche quelli da --config). Non compare comunque con
#   --list-ports/--help, che restituiscono solo la loro informazione.
#
# manifest.json: a differenza di manifest.txt/report_finale.txt (pensati
#   per la lettura umana), OGNI esecuzione (anche senza --report/
#   --parla-chiaro, anche in modalita' replay) scrive nell'outdir un
#   manifest.json strutturato, pensato per essere letto da script esterni
#   — campi tecnici (imei/iccid/mcc/mnc/lte/gps/hasMDT/numMDT/reqMDTPos/
#   reqMDTGPS/hasRRC/hasRRCPos/numRRC/numRRCPox/op/profile/diagWarn/...)
#   piu' un "contractId": hash che lega insieme QUESTO device di test e la
#   SIM usata (calcolato invocando lo script separato "mdtcontract ICCID",
#   vedi mdtcontract --help per i dettagli — pensato per essere usato da
#   script esterni per tracciare il consenso al test). Se "mdtcontract"
#   non e' disponibile o l'ICCID non e' determinabile (es. modalita'
#   replay), "contractId" resta vuoto: best-effort, non bloccante.
#   "diagWarn" (intero, non booleano): numero di avvisi WARNING scritti
#   da qcsuper in qcsuper.log durante la cattura live — vedi
#   compute_diag_warn_count() per il criterio esatto. 0 in modalita'
#   replay (qcsuper.log non esiste, nessuna cattura live coinvolta).
#   "diagError" (intero, non booleano): come "diagWarn" ma per le righe
#   ERROR (vedi compute_diag_error_count()), SEPARATO, mai incluso in
#   "diagWarn": un ERROR (es. timeout della richiesta con cui qcsuper
#   abilita un tipo di log sul modem) puo' aver impedito la cattura di un
#   intero tipo di traffico per tutta la sessione, senza che "diagWarn"
#   se ne accorga. 0 in modalita' replay, stesso motivo di "diagWarn".
#
# "warnPosD"/"warnPosL"/"warnMDTD"/"warnMDTL" (interi, in manifest.json e,
#   con --shm, come file separati): scansione EURISTICA a livello di bit
#   (src/mdt_bitscan.py, chiamata da compute_bitscan_warnings()) alla
#   ricerca di posizioni GPS/setup MDT che potrebbero essere sfuggiti alla
#   catena normale qcsuper -> pcap -> tshark, quando ci sono stati avvisi
#   diag (diagWarn > 0) — se diagWarn e' 0 la scansione NON viene eseguita
#   (costerebbe tempo per un rischio di perdita dati che non c'e' stato):
#   tutti e 4 i campi restano a 0.
#     - suffisso "D" (Diag): rilegge il .dlf gia' scritto con un parser
#       indipendente da qcsuper/tshark (stessa logica di
#       qcsuper/modules/pcap_dump.py, riportata in mdt_bitscan.py) — un
#       "secondo parere" anche sui record che NON hanno avuto problemi di
#       CRC, utile se il dissector lte-rrc avesse un buco (e' gia'
#       successo in passato, vedi lo scenario "r17-only" di
#       synthetic_test).
#     - suffisso "L" (Log): ricostruisce dal TESTO di qcsuper.log i byte
#       dei frame SCARTATI per CRC errato (il repr() Python nel messaggio
#       WARNING di _hdlc_mixin.py) — l'UNICA fonte possibile per quei
#       dati, dato che un frame scartato per CRC non finisce mai nel
#       .dlf. Risultati MAI verificati (il CRC e' fallito, non si sa quale
#       byte sia sbagliato): solo indizi da controllare a mano.
#     - "warnPosD"/"warnPosL": record RRC-OTA uplink con un Ellipsoid-Point
#       (posizione) plausibile trovato scorrendo OGNI offset di bit (i
#       campi UPER non sono allineati a un ottetto, una regex sui byte non
#       basterebbe — verificato contro synthetic_test). "Plausibile"
#       significa dentro un bounding box: quello delle coordinate GPS
#       vere ottenute in QUESTA cattura (periodic_cell_gps_decoded.csv,
#       se c'e' almeno un fix) allargato di --lat-margin/--lon-margin
#       gradi (default 0.02 ciascuno), altrimenti (nessun fix GPS in
#       questa cattura) il file mdt_configs/gpsBoundingBox/<MCC>.json
#       della rete rilevata, se esiste (vedi il README in quella
#       directory). Senza NESSUno dei due, la scansione posizione resta a
#       0/0 (senza un bounding box il filtro non ha alcun effetto: ogni
#       finestra di 48 bit decodifica comunque a QUALCHE lat/lon valida).
#     - "warnMDTD"/"warnMDTL": record RRC-OTA downlink in cui compare, a
#       QUALUNQUE offset di bit, la codifica UPER esatta del PLMN (MCC/MNC)
#       della rete rilevata in questa cattura — indizio di un IE che nomina
#       la nostra rete (tipicamente traceReference-r10 dentro
#       loggedMeasurementConfiguration-r10, ma PLMN-Identity compare anche
#       altrove in RRC: e' un indizio, non una prova). Restano a 0 se MCC/
#       MNC non sono determinabili in questa cattura ("se si riesce": e'
#       deliberatamente best-effort).
#   Dettaglio dei candidati trovati (offset di bit, lat/lon o posizione del
#   match) in mdt_bitscan_report.txt nell'outdir — sempre presente, vuoto/
#   con una sola nota se la scansione non e' stata eseguita.
#
# --lat-margin GRADI / --lon-margin GRADI (default 0.02 ciascuno): margine
#   di tolleranza applicato al bounding box usato da warnPosD/warnPosL
#   sopra, in entrambe le direzioni (sotto il minimo e sopra il massimo
#   osservato/configurato). Servono perche' il fix GPS reale piu' vicino a
#   un evento non coincide mai esattamente con la posizione istantanea del
#   dispositivo al momento esatto della risposta RRC (interpolazione fra
#   letture periodiche, vedi --gps-interval).
#
# --shm DIR: oltre a manifest.json, scrive anche una serie di file di
#   stato "piatti" (un valore per file: 0/1 per i booleani) in DIR —
#   pensato per un percorso in tmpfs (es. /dev/shm/mdtcap), da cui un
#   altro processo puo' leggere l'esito senza dover fare I/O su disco ne'
#   parsare JSON. Crea DIR (e le eventuali directory mancanti sul
#   percorso) se non esiste; se all'avvio vi trova gia' uno o piu' di
#   questi file (di una esecuzione precedente), li cancella subito, PRIMA
#   di qualunque altra cosa. I file vengono scritti per ultimi, a fine
#   esecuzione (stesso momento in cui viene scritto manifest.json):
#     lte      "0" o "1" — se c'e' stato traffico LTE-RRC nella cattura
#     gps      "0" o "1" — se e' stato ottenuto un fix GPS/GNSS
#     mdt      "0" o "1" — se c'e' MDT di qualunque tipo (config o
#                          richiesta o risposta)
#     mdtPos   "0" o "1" — se l'MDT rilevato implica una richiesta di
#                          posizione e/o di attivazione del GPS
#     rrc      "0" o "1" — se ci sono risposte RRC dell'UE
#     rrcPos   "0" o "1" — se qualcuna di quelle risposte include una
#                          posizione
#     contract il contractId (vedi manifest.json sopra), vuoto se non
#                          determinabile
#     path     il percorso completo dell'outdir di questa esecuzione
#     ok       "0" se ci sono stati errori, "1" se tutto e' andato a buon
#                          fine (stesso criterio del campo "OK" di
#                          manifest.json)
#     diagWarn lo stesso intero del campo "diagWarn" di manifest.json
#                          (NON un booleano 0/1 come gli altri file sopra)
#     diagError lo stesso intero del campo "diagError" di manifest.json
#                          (NON un booleano 0/1, vedi diagWarn sopra)
#     warnPosD/warnPosL/warnMDTD/warnMDTL stessi interi (NON booleani) dei
#                          campi omonimi di manifest.json, vedi sopra
#   "mdtStop" e' l'UNICO file scritto da un altro processo e LETTO da
#   mdtcap (tutti gli altri sopra sono output, mai riletti): se compare
#   in DIR durante "Cattura in corso" (controllato una volta al secondo,
#   indipendentemente da --tui), la cattura viene interrotta li' — stessa
#   analisi/report/manifest di fine cattura che si avrebbe a scadenza
#   naturale di --duration o con un Ctrl+C manuale, nessuna differenza
#   nell'evidenza prodotta a parte una durata piu' breve. Cancellato
#   subito non appena rilevato (il segnale e' "consumato" una volta
#   agito), e comunque gia' ripulito se trovato residuo all'avvio (vedi
#   sotto): un altro processo lo crea (es. "touch DIR/mdtStop" o
#   equivalente) per chiedere l'interruzione, mdtcap non lo scrive mai.
#   Ignorato durante le attese di pre-cattura (--lte-wait/--gps-wait/
#   --net-attach-wait): riguarda la cattura vera e propria, non il setup
#   che la precede.
#   Con --tui, avere --shm ATTIVO cambia anche il comportamento della TUI
#   stessa: dopo l'elenco delle azioni non viene piu' stampato NULLA a
#   schermo (ne' l'elenco file dell'outdir, ne' l'eventuale "Report
#   finale" di --report/--parla-chiaro) — il consumo dei risultati e'
#   demandato ai file in DIR, non al terminale. Senza --tui, --shm non
#   cambia il normale output a schermo/log.
#
# --extended [--ext-profile NOME]: "controlli extra" — una seconda analisi
#   opzionale, indipendente da MDT/RRC, per una prima discriminazione di
#   comportamenti di rete sospetti/malevoli tipici degli IMSI-catcher
#   (ispirata a SnoopSnitch/Darshak/AIMSICD): SMS/STK sospetti, richieste
#   di identita' non sollecitate, cifratura nulla, downgrade forzato,
#   incoerenza cella/GPS, ecc. — vedi src/extra_scan e
#   extra_configs/README.md per il dettaglio completo (categorie, formato
#   delle regole, livelli). Un indizio da verificare, NON un verdetto:
#   "Tutto questo serve per una discriminazione iniziale. I test extra
#   sono soggetti a modifiche" (le regole restano configurabili/
#   estendibili in extra_configs/, senza toccare mdtcap).
#   Solo se --extended e' presente: a fine test, PRIMA dell'hashing SHA-256
#   (cosi' i suoi file finiscono nella catena di custodia), viene invocato
#   src/extra_scan sull'outdir corrente; il risultato (un livello I/W/C/A e
#   un conteggio eventi per ciascuna categoria, piu' un "extraLevel"
#   complessivo) viene aggiunto a report_finale.txt/manifest.json/--shm,
#   nella sezione/sotto le chiavi "Controlli extra"/extScanCat/extraLevel.
#   --ext-profile NOME alimenta il --profile di src/extra_scan (risolto in
#   extra_configs/profile/NOME.conf) — NON lo stesso --profile di mdtcap
#   (mdt_configs/profile/), sono due sistemi di configurazione separati.
#   Indipendentemente da --extended, mdtcap invoca SEMPRE "src/extra_scan
#   --get-defs" (se lo script e' presente) prima di costruire la TUI/i
#   report, per etichettare stabilmente la sezione "Controlli extra:" —
#   senza --extended quella sezione mostra solo le intestazioni, mai un
#   livello/conteggio (nessun file viene scritto in quel caso).
#
# --test-sms: implica --extended (non serve passarlo separatamente).
#   Attiva, oltre alle regole normali, la ricerca di un SMS di TEST
#   inviato volutamente da un altro telefono in un ambiente controllato,
#   per validare l'intera catena di rilevamento/report senza dover
#   aspettare un vero evento di rete. Testo esatto atteso (spazi bianchi
#   ignorati):
#     ${"37337:H4XOR:MEGAVIRUS:T35T:F4K3:P4YL04D"::do(CATEGORIA)}
#   con CATEGORIA sostituita da uno di questi 6 token (7 caratteri esatti,
#   maiuscole/minuscole/underscore contano):
#     RRCCiph  cellSys  WCDMA3G  NASId__  SMSSTK_  ALL____
#   Se trovato, la categoria indicata (o tutte e 5, con ALL____) viene
#   forzata al livello A (Allarme) nel report, vedi
#   src/extra_scan:detect_test_sms_trigger per il dettaglio. Senza
#   --test-sms questo SMS non ha alcun effetto (extra_scan non lo cerca
#   nemmeno): NON e' un canale attivo in un'analisi normale.
#
# --autodetect: rende --diag-port/--at-port opzionali, individuandoli da
#   solo tra i device /dev/ttyUSB* presenti:
#     - porta AT: prova "AT" su ogni ttyUSB* candidato (filtrato per
#       vendor/modello, vedi sotto) e usa la prima che risponde OK;
#     - porta Diag: tra le interfacce dello stesso dispositivo fisico
#       della porta AT trovata (stesso ID_SERIAL udev), sceglie quella con
#       il numero di interfaccia USB piu' basso (convenzione osservata sui
#       moduli Qualcomm-based: l'interfaccia 0 e' la porta DM/Diag) e la
#       verifica con "qcsuper --usb-modem <porta> --info"; se questo
#       fallisce o non e' determinabile, ripiega su "usb-modem auto" di
#       qcsuper stesso (che implementa un matching sui descrittori USB
#       collaudato su piu' modelli, indipendente da questa euristica).
#   Se --diag-port/--at-port vengono comunque passati esplicitamente,
#   quel valore ha la precedenza e non viene toccato dall'autodetect.
#
# --autodetect-vendor STRINGA / --autodetect-model STRINGA: restringono le
#   porte candidate a quelle il cui ID_VENDOR/ID_MODEL udev contiene la
#   stringa indicata (case-insensitive; individuabili prima con
#   --list-ports). Default vendor "SimTech": copre l'intera famiglia di
#   moduli SimCom (non solo questo SIM7600E-H). Per un modem di un altro
#   produttore, es. Quectel: --autodetect --autodetect-vendor Quectel.
#
# --usb-modem (facoltativo, richiede --usb-modem-vid/--usb-modem-pid o
#   mdt_configs/system.conf gia' popolato da 'sudo ./install.sh
#   --configure-system'): fa passare a "qcsuper --usb-modem" il VID:PID
#   USB del modem (formato "vvvv:pppp", 4 cifre esadecimali ciascuno —
#   sintassi gia' supportata NATIVAMENTE da qcsuper, vedi il suo --help)
#   invece del device path (--diag-port/quello risolto da --autodetect).
#   --diag-port/--at-port/--autodetect restano comunque necessari come
#   sempre: la porta AT continua a servire per PIN/APN/CPSI/GPS, e la
#   porta Diag resta nei log/nel manifest anche quando non e' cio' che
#   viene passato a qcsuper — --usb-modem cambia SOLO l'argomento di
#   "qcsuper --usb-modem" al momento di avviare la cattura vera e propria
#   (vedi start_qcsuper_capture()).
#
#   Perche' puo' interessare: un device path fa scegliere a qcsuper
#   internamente UsbModemPyserialConnector, che legge la porta seriale un
#   BYTE alla volta (vedi read_loop() in
#   qcsuper/inputs/usb_modem_pyserial.py) — un VID:PID fa scegliere invece
#   UsbModemPyusbConnector, che legge a blocchi (wMaxPacketSize,
#   tipicamente 512 byte) via pyusb/libusb. Nessuna delle due e'
#   implementata da mdtcap: sono due percorsi gia' presenti in qcsuper,
#   mdtcap si limita a scegliere quale dei due usare passandogli l'uno o
#   l'altro formato.
#
#   VERIFICATO sul campo (due catture LTE reali da ~200s su Vodafone
#   Italia, stesso SIM7600E-H, immediatamente una dopo l'altra): il
#   risultato e' l'OPPOSTO dell'ipotesi iniziale. --usb-modem non riduce
#   gli avvisi "Wrong CRC", li AUMENTA (0 in modalita' path contro 962 con
#   --usb-modem) — ma cattura anche ~8.5 volte piu' dati grezzi (.dlf) e,
#   nonostante i frame scartati per CRC, porta a casa PIU' frame LTE-RRC
#   validi (39 contro 15): la modalita' path a lettura byte-a-byte non
#   risulta "pulita", sembra perdere molto piu' traffico ancora piu' a
#   monte, in modo silenzioso (mai un frame abbastanza intatto da arrivare
#   a fallire il CRC e generare un avviso — zero avvisi li' non vuol dire
#   zero perdita). ATTENZIONE pero': durante ENTRAMBE le catture di questo
#   test la macchina risultava in undervoltage permanente (vedi
#   "vcgencmd get_throttled", bit under-voltage/throttling attivi) — un
#   fattore di confondimento reale (assorbimenti di picco in TX del modem
#   che possono superare un alimentatore/cavo USB marginale, causando
#   instabilita' USB indipendente dal connettore usato), quindi questo
#   confronto andrebbe rifatto con un'alimentazione a posto prima di
#   trarne una conclusione definitiva su quale modalita' sia preferibile
#   in generale.
#
# --usb-modem-vid VID / --usb-modem-pid PID: il VID/PID USB usato da
#   --usb-modem sopra (4 cifre esadecimali ciascuno, es. "1e0e"/"9000" —
#   le stesse mostrate da "lsusb"). Di norma non vanno passati a mano:
#   'sudo ./install.sh --configure-system' li rileva da solo (interrogando
#   via udevadm la porta del modem) e li scrive in mdt_configs/system.conf,
#   caricato automaticamente ad ogni esecuzione come tutto il resto di
#   quel file (vedi --autodetect sopra). Senza --usb-modem, questi due
#   valori restano inutilizzati (nessun effetto sulla cattura).
#
# mdt_configs/imei: ad ogni cattura live (non in modalita' replay), se
#   questo file non esiste ancora, lo script salva al suo interno l'IMEI
#   corrente del modulo (AT+CGSN) come backup dell'IMEI di fabbrica — mai
#   sovrascritto una volta creato. Non ha alcun effetto sulla cattura:
#   serve solo da riferimento per mdtimei (script separato, non incluso
#   in mdtcap, per cambiare l'IMEI del modulo) — permette di tornare
#   all'IMEI originale con "mdtimei --imei $(cat mdt_configs/imei)". Vedi
#   mdtimei --help e la guida separata sui rischi legali di quell'operazione.
#
# --analyze-dlf FILE: modalita' "replay" — invece di catturare dal vivo,
#   rilegge un file .dlf gia' registrato in una sessione precedente (es.
#   il capture_<timestamp>.dlf prodotto da una cattura fatta con questo
#   stesso script, o con QCSuper/QXDM direttamente) e ripete su di esso
#   l'intera analisi: (ri)genera il .pcap con "qcsuper --dlf-read", poi
#   report_mdt_rrc.txt, il log delle richieste MDT/posizione, e — se
#   richiesti — --report/--parla-chiaro, con lo stesso hashing e manifest
#   di una cattura live. Nessun device coinvolto: --diag-port/--at-port/
#   --autodetect/--sim-pin/--apn/--force-lte/--require-lte/--gps*/
#   --net-attach-wait/--lbs/-v non hanno senso in questa modalita' e
#   vengono ignorati se passati. Il file indicato viene copiato dentro
#   l'outdir (cosi' la cartella di evidenza resta autocontenuta) prima di
#   essere riletto. Utile per: rianalizzare una cattura dopo un
#   aggiornamento dello script (es. filtri MDT ampliati), o per generare
#   --report/--parla-chiaro su una cattura fatta senza quelle opzioni,
#   senza dover ripetere l'acquisizione.
#
# --analyze-pcap FILE: modalita' "replay da pcap" — come --analyze-dlf, ma
#   parte direttamente da un file .pcap/.pcapng gia' pronto (es. esportato
#   da Wireshark, catturato con QCSuper/QXDM direttamente, o prodotto da
#   una sessione mdtcap precedente) invece che da un .dlf grezzo: NESSUN
#   device coinvolto e, a differenza di --analyze-dlf, non serve nemmeno
#   qcsuper (il file e' gia' nel formato che tshark sa leggere, non va
#   rigenerato da nessun .dlf). --diag-port/--at-port/--autodetect/
#   --qcsuper/--sim-pin/--apn/--force-lte/--require-lte/--gps*/
#   --net-attach-wait/--lbs/-v non hanno senso in questa modalita' e
#   vengono ignorati se passati. Incompatibile con --analyze-dlf (scegliere
#   l'una o l'altra sorgente). Il file indicato viene copiato dentro
#   l'outdir come capture_<timestamp>.pcap (cosi' la cartella di evidenza
#   resta autocontenuta) prima di essere analizzato con la stessa pipeline
#   di --analyze-dlf: report_mdt_rrc.txt, log delle richieste MDT/posizione,
#   coordinate_estratte.csv, e — se richiesti — --report/--parla-chiaro,
#   con lo stesso hashing e manifest. Non viene creato nessun
#   capture_<timestamp>.dlf (non esiste una sorgente grezza Diag in questa
#   modalita': il manifest lo segnala esplicitamente). Utile per: analizzare
#   una cattura fatta con Wireshark/altri strumenti (non necessariamente
#   con questo script o con qcsuper), o per rigenerare --report/
#   --parla-chiaro su un .pcap gia' pronto senza coinvolgere qcsuper.
#
# Controllo automatico di completezza del pcap (sempre attivo in cattura
#   live, nessuna opzione richiesta): a fine cattura, prima di qualunque
#   estrazione MDT, lo script rilegge una seconda volta il .dlf appena
#   registrato (qcsuper --dlf-read, come in --analyze-dlf) e confronta il
#   numero di frame LTE-RRC ottenuto con quello del pcap scritto in diretta
#   da qcsuper durante la cattura. Trovato analizzando catture reali: il
#   pcap live puo' risultare significativamente meno completo dello stesso
#   .dlf riletto subito dopo (caso osservato: 9 frame LTE-RRC nel pcap live
#   contro 64 rigenerando dal .dlf, hash del .dlf invariato) — il .dlf resta
#   quindi l'unica fonte grezza davvero affidabile. Se il pcap rigenerato
#   risulta piu' completo, lo script lo usa per l'intera analisi che segue
#   (report_mdt_rrc.txt, coordinate_estratte.csv, mdt_location_requests.txt,
#   report_finale.txt/--parla-chiaro), rinominando il pcap live originale in
#   capture_<timestamp>.live.pcap (mai cancellato: resta nell'hashing/
#   manifest per la catena di custodia) e segnalandolo con un'ATTENZIONE a
#   terminale/session.log, in coda a report_finale.txt e nel manifest. Se
#   invece il conteggio coincide, lo script lo registra comunque (log
#   "Controllo di completezza pcap: OK ..."), senza toccare alcun file. Non
#   si applica in modalita' replay (--analyze-dlf): li' il pcap e' gia'
#   ottenuto direttamente dal .dlf, non esiste un "pcap live" con cui
#   confrontarlo.
#
# Senza --duration la cattura resta attiva finché non premi Ctrl+C: alla
# ricezione del segnale lo script chiude qcsuper in modo pulito, ricava il
# contesto AT post-cattura, calcola gli hash e scrive il manifest.

set -euo pipefail

