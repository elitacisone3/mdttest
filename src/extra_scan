def cmd_scan(args):
    now = datetime.now(timezone.utc)
    warnings = []

    if not args.file:
        warnings.append("--file non indicato: nessuna scansione .dlf/pcap possibile.")
    if not args.out:
        print("extra_scan: --out obbligatorio (fuori da --get-defs)", file=sys.stderr)
        for cat in CATEGORY_KEYS:
            print(f"{cat}_L=I")
            print(f"{cat}_N=0")
        print("extraLevel=I")
        return 1
    if not args.op and not (args.mcc and args.mnc):
        warnings.append("ne' --op ne' --mcc/--mnc indicati: nessun file extra_configs/op/ risolto.")

    os.makedirs(args.out, exist_ok=True)

    cp, loaded_configs = load_config(args.configs_dir, args.op, args.profile, args.mcc, args.mnc)
    rules = build_rules(cp)

    if args.test_sms:
        # Garanzia ASSOLUTA (indipendente da main.conf/op/profile, vedi
        # TEST_SMS_EVT in testa al file): il livello finale di una
        # categoria in aggregate() viene SEMPRE da rules[...]["level"], mai
        # da Occurrence.level - quindi forziamo qui, in memoria, level=A e
        # min=1 per le nostre 5 regole riservate, creandole se assenti
        # (main.conf le definisce gia' con questi stessi valori, per
        # documentazione, ma questo override non dipende da quel file).
        for cat in TEST_SMS_CATEGORY_TOKENS.values():
            rule = rules.setdefault((cat, TEST_SMS_EVT), {})
            rule["level"] = "A"
            rule["min"] = 1
            rule.setdefault("max", 0)
            rule.setdefault("window_s", cp.getint("DEFAULT", "window_s", fallback=900))
            rule.setdefault("cum_threshold", 0)
            rule.setdefault("min_interval_s", 0)
            rule.setdefault("max_interval_s", 0)
            rule.setdefault("mode", "")
            rule.setdefault("comment", "Trigger di test via SMS magica (--test-sms)")
            rule.setdefault("log_msg", "")

    pcap, pcap_err = ensure_pcap(args.file, args.out) if args.file else (None, None)
    if pcap_err:
        warnings.append(pcap_err)

    occurrences = []
    if pcap:
        occurrences += detect_rrc_ciphering(pcap, rules.get(("RRCCiph", "eea0_eia0")))
        occurrences += detect_identity_request_imsi(pcap, rules.get(("NASId", "unsolicited_identity_imsi")))
        occurrences += detect_guti_realloc(pcap, rules.get(("NASId", "guti_realloc_anomaly")))
        occurrences += detect_attach_identity_release(pcap, rules.get(("NASId", "attach_identity_release")))
        occurrences += detect_forced_downgrade(
            pcap, rules.get(("cellSys", "forced_2g_downgrade")), "cellSys", "forced_2g_downgrade",
            "lte-rrc.redirectedCarrierInfo==1", "2G/GERAN",
        )
        occurrences += detect_no_neighbor_list(pcap, rules.get(("cellSys", "no_neighbor_list")))
        occurrences += detect_forced_downgrade(
            pcap, rules.get(("WCDMA3G", "forced_3g_downgrade")), "WCDMA3G", "forced_3g_downgrade",
            "lte-rrc.redirectedCarrierInfo==2 or lte-rrc.redirectedCarrierInfo==3 or lte-rrc.redirectedCarrierInfo==6",
            "3G/UMTS",
        )
        occurrences += detect_a5_0(pcap, rules.get(("WCDMA3G", "a5_0_2g")))
    else:
        warnings.append("nessun pcap disponibile: rilevatori basati su tshark saltati (RRCCiph/NASId/cellSys/WCDMA3G).")

    if args.file and os.path.isfile(args.file):
        occurrences += detect_silent_sms(args.file, rules.get(("SMSSTK", "silent_sms")))
        occurrences += detect_simjacker_envelope(args.file, rules.get(("SMSSTK", "simjacker_envelope")))
        if args.test_sms:
            occurrences += detect_test_sms_trigger(args.file, rules)

    gps_csv = os.path.join(args.out, "periodic_cell_gps_decoded.csv")
    occurrences += detect_gps_incoherence(gps_csv, rules.get(("GPSLoc", "cell_gps_incoherent")))

    occ_by_rule = defaultdict(list)
    for o in occurrences:
        occ_by_rule[(o.cat, o.evt)].append(o.ts)

    cat_level, cat_count, rule_results, extra_level = aggregate(rules, occ_by_rule)

    write_logs(args.out, occurrences, rule_results, now)
    write_report(args.out, rules, warnings, loaded_configs, cat_level, cat_count, rule_results, extra_level, now)

    for cat in CATEGORY_KEYS:
        print(f"{cat}_L={cat_level[cat]}")
        print(f"{cat}_N={cat_count[cat]}")
    print(f"extraLevel={extra_level}")
    return 0


def main():
    argv = sys.argv[1:]
    if "--get-defs" in argv:
        return cmd_get_defs()
    args = parse_args(argv)
    try:
        return cmd_scan(args)
    except Exception as exc:  # fail-soft: mai un traceback su stdout/verso mdtcap
        print(f"extra_scan: errore interno non gestito: {exc}", file=sys.stderr)
        for cat in CATEGORY_KEYS:
            print(f"{cat}_L=I")
            print(f"{cat}_N=0")
        print("extraLevel=I")
        return 0


if __name__ == "__main__":
    sys.exit(main())
