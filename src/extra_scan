def haversine_m(lat1, lon1, lat2, lon2):
    r = 6371000.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dl = math.radians(lon2 - lon1)
    a = math.sin(dphi / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dl / 2) ** 2
    return 2 * r * math.asin(math.sqrt(a))


def parse_utc_ts(s):
    try:
        return datetime.strptime(s, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None


def detect_gps_incoherence(csv_path, rule):
    if rule is None or not csv_path or not os.path.isfile(csv_path):
        return []

    # Soglie interne (non ancora esposte in extra_configs/: candidate per
    # una revisione futura, vedi "I test extra sono soggetti a
    # modifiche"): sotto STATIONARY_M ci si considera "fermi", sopra
    # JUMP_M uno spostamento "significativo".
    STATIONARY_M = 30.0
    JUMP_M = 5000.0

    samples = []
    try:
        with open(csv_path, newline="") as f:
            for row in csv.DictReader(f):
                if row.get("gps_fix") != "1":
                    continue
                try:
                    lat = float(row["gps_lat"])
                    lon = float(row["gps_lon"])
                except (KeyError, ValueError, TypeError):
                    continue
                if lat == 0 and lon == 0:
                    continue
                ts = parse_utc_ts(row.get("utc_timestamp", ""))
                if ts is None:
                    continue
                cell = (row.get("cell_id", ""), row.get("pci", ""))
                samples.append((ts, cell, lat, lon))
    except OSError:
        return []

    occs = []
    for i in range(1, len(samples)):
        ts0, cell0, lat0, lon0 = samples[i - 1]
        ts1, cell1, lat1, lon1 = samples[i]
        if not cell0[0] or not cell1[0]:
            continue
        dist = haversine_m(lat0, lon0, lat1, lon1)
        if cell0 != cell1 and dist < STATIONARY_M:
            detail = (
                f"Cambio cella ({cell0[0]}/{cell0[1]} -> {cell1[0]}/{cell1[1]}) "
                f"con spostamento GPS trascurabile ({dist:.0f} m)"
            )
            occs.append(mk_occ("GPSLoc", "cell_gps_incoherent", ts1, rule["level"], detail))
        elif cell0 == cell1 and dist > JUMP_M:
            detail = (
                f"Cella invariata ({cell1[0]}/{cell1[1]}) nonostante uno spostamento GPS "
                f"di {dist / 1000:.1f} km"
            )
            occs.append(mk_occ("GPSLoc", "cell_gps_incoherent", ts1, rule["level"], detail))
    return occs


# ---------------------------------------------------------------------
# aggregazione: conteggio per regola/categoria, promozione C->A,
# livello piu' alto per categoria ed extraLevel complessivo
# ---------------------------------------------------------------------

def densest_window_count(sorted_ts, window_s):
    """Massimo numero di timestamp (ordinati) contenuti in una finestra
    scorrevole di window_s secondi (two-pointer, O(n))."""
    best = 0
    start = 0
    for i in range(len(sorted_ts)):
        while sorted_ts[i] - sorted_ts[start] > window_s:
            start += 1
        best = max(best, i - start + 1)
    return best


def aggregate(rules, occ_by_rule):
    cat_level = {k: "I" for k in CATEGORY_KEYS}
    cat_count = {k: 0 for k in CATEGORY_KEYS}
    rule_results = []  # (cat, evt, base_level, final_level, count, promoted, counted)

    for (cat, evt), rule in rules.items():
        raw_ts = sorted(occ_by_rule.get((cat, evt), []))
        n = len(raw_ts)
        counted = n >= rule["min"]
        level = rule["level"]
        promoted = False
        if counted:
            if level == "C" and rule["cum_threshold"] > 0 and n > 0:
                window = rule["window_s"] if rule["window_s"] > 0 else (raw_ts[-1] - raw_ts[0] + 1)
                dense = densest_window_count(raw_ts, window)
                if dense >= rule["cum_threshold"]:
                    level = "A"
                    promoted = True
            if cat in cat_count:
                cat_count[cat] += n
                if LEVEL_RANK[level] > LEVEL_RANK[cat_level[cat]]:
                    cat_level[cat] = level
        rule_results.append((cat, evt, rule["level"], level, n, promoted, counted))

    extra_level = "I"
    for lvl in cat_level.values():
        if LEVEL_RANK[lvl] > LEVEL_RANK[extra_level]:
            extra_level = lvl
    return cat_level, cat_count, rule_results, extra_level


