def format_log_line(cat, evt, ts, level, detail, raw):
    code = make_code(cat, evt)
    line = f"[{iso(ts)}] {level} {code} Log {detail}\n"
    if raw:
        pad = " " * (len(f"[{iso(ts)}] {level} "))
        line += f"{pad}{code} {raw}\n"
    return line


def write_logs(out_dir, occurrences, rule_results, now):
    general_path = os.path.join(out_dir, "extra_scan.log")
    cat_files = {}
    header = f"[{iso(now)}] I {make_code('SCAN', 'START')} Log Scansione extra_scan avviata\n"
    try:
        gf = open(general_path, "w")
        gf.write(header)
        for cat in CATEGORY_KEYS:
            cf = open(os.path.join(out_dir, f"extra_scan_{cat}.log"), "w")
            cf.write(header)
            cat_files[cat] = cf

        for o in sorted(occurrences, key=lambda x: x.ts):
            line = format_log_line(o.cat, o.evt, o.ts, o.level, o.detail, o.raw)
            gf.write(line)
            if o.cat in cat_files:
                cat_files[o.cat].write(line)

        for cat, evt, base_level, final_level, n, promoted, counted in rule_results:
            if not promoted:
                continue
            detail = (
                f"Soglia cumulativa superata ({n} occorrenze a livello {base_level}): "
                f"regola {cat}.{evt} promossa da {base_level} ad {final_level}"
            )
            line = format_log_line(cat, evt, now.timestamp(), final_level, detail, "")
            gf.write(line)
            if cat in cat_files:
                cat_files[cat].write(line)
    finally:
        gf.close()
        for cf in cat_files.values():
            cf.close()


def write_report(out_dir, rules, warnings, loaded_configs, cat_level, cat_count, rule_results, extra_level, now):
    path = os.path.join(out_dir, "extra_scan_report.txt")
    with open(path, "w") as f:
        f.write(f"=== extra_scan — {iso(now)} ===\n")
        f.write("Discriminazione iniziale, non un verdetto definitivo (i test extra sono soggetti a modifiche).\n\n")
        if loaded_configs:
            f.write("Config lette (in ordine, l'ultima puo' sovrascrivere le precedenti):\n")
            for c in loaded_configs:
                f.write(f"  - {c}\n")
        else:
            f.write("Nessun file di configurazione trovato in extra_configs/ (usate solo le regole di default vuote).\n")
        f.write("\n")
        for w in warnings:
            f.write(f"ATTENZIONE: {w}\n")
        if warnings:
            f.write("\n")

        f.write("Categorie:\n")
        for cat, label in CATEGORIES:
            f.write(f"  {cat} ({label}): livello {cat_level[cat]}, {cat_count[cat]} evento/i\n")
        f.write("\n")

        f.write("Regole valutate:\n")
        by_cat = defaultdict(list)
        for cat, evt, base_level, final_level, n, promoted, counted in rule_results:
            by_cat[cat].append((evt, base_level, final_level, n, promoted, counted))
        for cat, _ in CATEGORIES:
            for evt, base_level, final_level, n, promoted, counted in sorted(by_cat.get(cat, [])):
                comment = rules.get((cat, evt), {}).get("comment", "")
                if not counted:
                    note = f"sotto soglia minima ({n} occorrenza/e)" if n else "nessuna occorrenza"
                    f.write(f"  {cat}.{evt}: {base_level} — {note}")
                else:
                    promo_note = f" -> promossa a {final_level}" if promoted else ""
                    f.write(f"  {cat}.{evt}: {base_level}{promo_note} ({n} occorrenza/e)")
                if comment:
                    f.write(f" — {comment}")
                f.write("\n")
        f.write(f"\nextraLevel: {extra_level}\n")


