def resolve_op_file(configs_dir, op, mcc, mnc):
    if op:
        f = os.path.join(configs_dir, "op", f"{op}.conf")
        return f if os.path.isfile(f) else None
    if mcc and mnc:
        link = os.path.join(configs_dir, "mcc-mnc", f"{mcc}-{mnc}")
        if os.path.isfile(link):
            return link
    return None


def load_config(configs_dir, op, profile, mcc, mnc):
    # interpolation=None: alcuni "log_msg" contengono placeholder stile
    # "%(nome)s" pensati per essere popolati dai singoli detector, non da
    # configparser stesso (che altrimenti li tratterebbe come riferimenti
    # incrociati fra chiavi INI e fallirebbe se "nome" non esiste).
    cp = configparser.ConfigParser(interpolation=None)
    main_conf = os.path.join(configs_dir, "main.conf")
    loaded = []
    if os.path.isfile(main_conf):
        cp.read(main_conf)
        loaded.append(main_conf)
    op_file = resolve_op_file(configs_dir, op, mcc, mnc)
    if op_file:
        cp.read(op_file)
        loaded.append(op_file)
    if profile:
        profile_file = os.path.join(configs_dir, "profile", f"{profile}.conf")
        if os.path.isfile(profile_file):
            cp.read(profile_file)
            loaded.append(profile_file)
    return cp, loaded


def build_rules(cp):
    rules = {}
    for section in cp.sections():
        if "." not in section:
            continue
        cat, evt = section.split(".", 1)
        if not cp.getboolean(section, "enabled", fallback=True):
            continue
        level = cp.get(section, "level", fallback="I").strip().upper()
        if level not in LEVELS:
            level = "I"
        rules[(cat, evt)] = {
            "level": level,
            "min": cp.getint(section, "min", fallback=1),
            "max": cp.getint(section, "max", fallback=0),
            "window_s": cp.getint(section, "window_s", fallback=0),
            "cum_threshold": cp.getint(section, "cum_threshold", fallback=0),
            "min_interval_s": cp.getint(section, "min_interval_s", fallback=0),
            "max_interval_s": cp.getint(section, "max_interval_s", fallback=0),
            "mode": cp.get(section, "mode", fallback=""),
            "comment": cp.get(section, "comment", fallback=""),
            "log_msg": cp.get(section, "log_msg", fallback=""),
        }
    return rules


# ---------------------------------------------------------------------
# pcap: riuso se gia' presente accanto al .dlf, altrimenti rigenerazione
# (stessi flag di mdtcap: --reassemble-sibs --decrypt-nas)
# ---------------------------------------------------------------------

def ensure_pcap(dlf_path, out_dir):
    if not dlf_path or not os.path.isfile(dlf_path):
        return None, "file .dlf non trovato o non indicato (--file)"
    base = os.path.splitext(os.path.basename(dlf_path))[0]
    for candidate_dir in (os.path.dirname(dlf_path) or ".", out_dir or "."):
        candidate = os.path.join(candidate_dir, base + ".pcap")
        if os.path.isfile(candidate) and os.path.getsize(candidate) > 0:
            return candidate, None

    qcsuper_bin = shutil.which("qcsuper") or shutil.which("qcsuper.py")
    if not qcsuper_bin:
        return None, "nessun .pcap trovato accanto al .dlf e qcsuper non disponibile per rigenerarlo"

    gen_path = os.path.join(out_dir or ".", "._extra_scan_regen.pcap")
    cmd = ([sys.executable, qcsuper_bin] if qcsuper_bin.endswith(".py") else [qcsuper_bin])
    cmd += ["--dlf-read", dlf_path, "--pcap-dump", gen_path, "--reassemble-sibs", "--decrypt-nas"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return None, f"rigenerazione pcap dal .dlf fallita: {exc}"
    if r.returncode != 0 or not os.path.isfile(gen_path):
        return None, f"rigenerazione pcap dal .dlf fallita (qcsuper exit {r.returncode})"
    return gen_path, None


# ---------------------------------------------------------------------
# tshark: estrazione campi + hex dump per singolo frame
# ---------------------------------------------------------------------

def run_tshark_fields(pcap, disp_filter, fields):
    if not pcap or not os.path.isfile(pcap):
        return []
    cmd = ["tshark", "-r", pcap, "-T", "fields", "-E", "separator=\t", "-E", "occurrence=f"]
    if disp_filter:
        cmd += ["-Y", disp_filter]
    for f in fields:
        cmd += ["-e", f]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if out.returncode != 0:
        return []
    rows = []
    for line in out.stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split("\t")
        parts += [""] * (len(fields) - len(parts))
        rows.append(dict(zip(fields, parts)))
    return rows


_HEXLINE_RE = re.compile(r'^[0-9a-fA-F]{4,8}\s+((?:[0-9a-fA-F]{2}\s+){1,16})')


def hexdump_for_frame(pcap, frame_number):
    if not pcap or not frame_number:
        return ""
    cmd = ["tshark", "-r", pcap, "-Y", f"frame.number=={frame_number}", "-x"]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if out.returncode != 0:
        return ""
    hexbytes = []
    for line in out.stdout.splitlines():
        m = _HEXLINE_RE.match(line)
        if not m:
            if hexbytes:
                break  # fine del primo blocco (il frame vero e proprio)
            continue
        hexbytes.append(m.group(1).strip().replace(" ", ""))
    return "".join(hexbytes).upper()


def capture_time_bounds(pcap):
    # "frame.time_epoch > 0", non "None": osservato empiricamente che
    # qcsuper scrive epoch 0 (1970-01-01) per i frame delle primissime
    # procedure di una sessione (Attach/Authentication/Security Mode
    # Command/RRCConnectionSetup, prima che stabilisca il riferimento di
    # orario) — un solo frame cosi' farebbe collassare min() a 0 e
    # gonfiare qualunque intervallo calcolato su questi bound (visto su
    # catture reali: "nessuna riallocazione GUTI in 1788790202s" invece
    # della vera durata della cattura, pochi minuti). Vedi anche
    # resolve_ts() sotto per lo stesso problema sui singoli eventi.
    rows = run_tshark_fields(pcap, "frame.time_epoch > 0", ["frame.time_epoch"])
    times = []
    for r in rows:
        try:
            times.append(float(r["frame.time_epoch"]))
        except (KeyError, ValueError):
            continue
    if not times:
        return None, None
    return min(times), max(times)


_EARLIEST_VALID_TS_CACHE = {}


def earliest_valid_time(pcap):
    """Prima timestamp valida (>0) nel pcap — usata come approssimazione
    per i frame con frame.time_epoch=0 (vedi resolve_ts()), cache per non
    ripetere la stessa query tshark per ogni occorrenza dello stesso
    pcap."""
    if pcap not in _EARLIEST_VALID_TS_CACHE:
        lo, _ = capture_time_bounds(pcap)
        _EARLIEST_VALID_TS_CACHE[pcap] = lo
    return _EARLIEST_VALID_TS_CACHE[pcap]


def resolve_ts(pcap, raw_epoch):
    """Converte il valore grezzo di frame.time_epoch in (timestamp,
    approssimato). Se il frame non ha una timestamp risolta (0, o
    assente), ripiega sulla prima timestamp valida dello stesso pcap
    (l'evento resta comunque contato/loggato, solo con un orario
    approssimato e segnalato come tale) invece di riportare 0
    (1970-01-01), fuorviante, o di scartare l'evento."""
    try:
        ts = float(raw_epoch)
    except (TypeError, ValueError):
        ts = 0.0
    if ts > 0:
        return ts, False
    fallback = earliest_valid_time(pcap)
    return (fallback if fallback is not None else 0.0), True


def mk_occ(cat, evt, ts, level, detail, pcap=None, frame_number=None, raw=""):
    if not raw and pcap and frame_number:
        raw = hexdump_for_frame(pcap, frame_number)
    return Occurrence(cat, evt, float(ts), level, detail, raw)


# ---------------------------------------------------------------------
# rilevatori basati su tshark/pcap
# ---------------------------------------------------------------------

def simple_tshark_detector(pcap, rule, cat, evt, disp_filter, detail_fn=None, extra_fields=None):
    if rule is None:
        return []
    fields = ["frame.number", "frame.time_epoch"] + (extra_fields or [])
    rows = run_tshark_fields(pcap, disp_filter, fields)
    occs = []
    for r in rows:
        ts, approx = resolve_ts(pcap, r.get("frame.time_epoch"))
        detail = detail_fn(r) if detail_fn else (rule["comment"] or f"Evento rilevato: {cat}.{evt}")
        if approx:
            detail += " [timestamp diag non risolta per questo frame, orario approssimato all'inizio cattura]"
        occs.append(mk_occ(cat, evt, ts, rule["level"], detail, pcap, r.get("frame.number")))
    return occs


def detect_rrc_ciphering(pcap, rule):
    if rule is None:
        return []

    def detail(r):
        parts = []
        if r.get("lte-rrc.cipheringAlgorithm") == "0":
            parts.append("EEA0")
        if r.get("lte-rrc.integrityProtAlgorithm") == "0":
            parts.append("EIA0")
        base = rule["comment"] or "Cifratura/integrita' nulla in Security Mode Command RRC"
        return f"{base} ({', '.join(parts)})" if parts else base

    return simple_tshark_detector(
        pcap, rule, "RRCCiph", "eea0_eia0",
        "lte-rrc.cipheringAlgorithm==0 or lte-rrc.integrityProtAlgorithm==0",
        detail_fn=detail,
        extra_fields=["lte-rrc.cipheringAlgorithm", "lte-rrc.integrityProtAlgorithm"],
    )


def detect_identity_request_imsi(pcap, rule):
    if rule is None:
        return []
    # Semplificazione v1: ogni Identity Request di tipo IMSI (id_type2==1)
    # e' trattata come candidato, senza verificare che manchi un
    # Authentication Request precedente nella stessa procedura (vedi
    # limiti noti in testa al file).
    return simple_tshark_detector(
        pcap, rule, "NASId", "unsolicited_identity_imsi",
        "nas-eps.nas_msg_emm_type==85 and nas-eps.emm.id_type2==1",
        detail_fn=lambda r: (rule["comment"] or "Identity Request IMSI non sollecitata"),
    )


def detect_forced_downgrade(pcap, rule, cat, evt, filter_expr, target_label):
    if rule is None:
        return []
    return simple_tshark_detector(
        pcap, rule, cat, evt, filter_expr,
        detail_fn=lambda r: (rule["comment"] or f"Redirect forzato verso {target_label}"),
    )


def detect_a5_0(pcap, rule):
    if rule is None:
        return []
    return simple_tshark_detector(
        pcap, rule, "WCDMA3G", "a5_0_2g", "gsm_a.rr.SC==0",
        detail_fn=lambda r: (rule["comment"] or "A5/0 (nessuna cifratura) accettato su GSM/2G"),
    )


def detect_guti_realloc(pcap, rule):
    if rule is None:
        return []
    rows = run_tshark_fields(pcap, "nas-eps.nas_msg_emm_type==80", ["frame.number", "frame.time_epoch"])
    events = []
    for r in rows:
        ts, _approx = resolve_ts(pcap, r.get("frame.time_epoch"))
        events.append((ts, r.get("frame.number")))
    events.sort(key=lambda e: e[0])

    occs = []
    if len(events) >= 2 and rule["min_interval_s"] > 0:
        for i in range(1, len(events)):
            interval = events[i][0] - events[i - 1][0]
            if interval < rule["min_interval_s"]:
                detail = (
                    f"Riallocazione GUTI dopo solo {interval:.0f}s dalla precedente "
                    f"(soglia minima {rule['min_interval_s']}s)"
                )
                occs.append(mk_occ("NASId", "guti_realloc_anomaly", events[i][0], rule["level"],
                                    detail, pcap, events[i][1]))
    elif not events and rule["max_interval_s"] > 0:
        lo, hi = capture_time_bounds(pcap)
        if lo is not None and (hi - lo) > rule["max_interval_s"]:
            detail = (
                f"Nessuna riallocazione GUTI in {hi - lo:.0f}s di cattura "
                f"(soglia massima {rule['max_interval_s']}s)"
            )
            occs.append(mk_occ("NASId", "guti_realloc_anomaly", hi, rule["level"], detail))
    return occs


# ---------------------------------------------------------------------
# SMSSTK.silent_sms: scansione byte-a-byte del .dlf grezzo
# ---------------------------------------------------------------------

DLF_TIMESTAMP_OFFSET = datetime(1980, 1, 6, tzinfo=timezone.utc).timestamp()


def decode_dlf_timestamp(log_time):
    """Inverso di dlf_timestamp() in synthetic_test/gen_mdt_dlf.py: i bit
    alti di log_time sono unita' da 20ms dal 1980-01-06 (i 20 bit bassi
    sono una mantissa, qui ignorata: precisione a 20ms, sufficiente per i
    nostri scopi)."""
    return DLF_TIMESTAMP_OFFSET + (log_time >> 20) / 50.0


def iter_dlf_records(data: bytes):
    """
    Stesso formato di src/mdt_bitscan.py (a sua volta porta fedele di
    qcsuper/inputs/dlf_read.py): record consecutivi (log_length u16,
    log_type u16, log_time u64) + payload. Si ferma in modo silenzioso
    su una coda troncata.
    """
    off = 0
    n = len(data)
    while off + 12 <= n:
        log_length, log_type, log_time = unpack_from("<HHQ", data, off)
        if log_length < 12 or off + log_length > n:
            break
        yield log_type, log_time, data[off + 12: off + log_length]
        off += log_length


def try_parse_sms_deliver(buf, off):
    """
    Verifica se buf[off:] inizia con un TPDU SMS-DELIVER plausibile (TS
    23.040 par. 9.2.2.1): TP-MTI=00, TP-OA di lunghezza/tipo credibili,
    TP-SCTS con nibble BCD validi (0-9). Ritorna un dict con TP-PID/
    TP-DCS/lunghezza consumata, o None. Bounded plausibility check nello
    stesso spirito di src/mdt_bitscan.py (scan_position_candidates/
    scan_mdt_candidates): non e' un parser TS 24.011/24.301 completo del
    contenitore CP-DATA/RP-DATA che lo racchiude (non necessario per
    isolare il solo TP-DCS).
    """
    if off + 2 > len(buf):
        return None
    first_octet = buf[off]
    if first_octet & 0x03 != 0x00:  # TP-MTI deve essere 00 (SMS-DELIVER)
        return None
    oa_len_digits = buf[off + 1]
    if not (1 <= oa_len_digits <= 20):
        return None
    oa_len_bytes = (oa_len_digits + 1) // 2
    p = off + 2
    if p + 1 + oa_len_bytes + 2 + 7 + 1 > len(buf):
        return None
    toa = buf[p]
    if toa & 0x80 == 0:  # bit7 del Type-of-Address e' sempre a 1
        return None
    p += 1 + oa_len_bytes
    tp_pid = buf[p]
    p += 1
    tp_dcs = buf[p]
    p += 1
    scts = buf[p:p + 7]
    for b in scts[:6]:
        if (b & 0x0F) > 9 or ((b >> 4) & 0x0F) > 9:
            return None
    return {"tp_pid": tp_pid, "tp_dcs": tp_dcs, "end": p + 7}


def classify_tp_dcs_class(dcs):
    """
    TS 23.038 par. 4: gruppo "General Data Coding" (bit7-6=00, classe
    presente solo se bit4=1) o gruppo "Data coding/message class"
    (bit7-4=1111, classe sempre presente nei bit1-0). Altri gruppi
    (compressione, message waiting indication, ecc.) non gestiti in
    questa versione: ritorna None per loro, non e' un errore.
    """
    if dcs & 0xC0 == 0x00:
        if dcs & 0x10:
            return dcs & 0x03
        return None
    if dcs & 0xF0 == 0xF0:
        return dcs & 0x03
    return None


def detect_silent_sms(dlf_path, rule):
    if rule is None:
        return []
    try:
        with open(dlf_path, "rb") as f:
            data = f.read()
    except OSError:
        return []

    occs = []
    for log_type, log_time, payload in iter_dlf_records(data):
        if log_type not in (LOG_LTE_NAS_EMM_OTA_IN_MSG_LOG_C, LOG_LTE_NAS_EMM_OTA_OUT_MSG_LOG_C):
            continue
        if len(payload) <= 4:
            continue
        msg = payload[4:]  # header <BBBB> (ext_header_ver/rrc_rel/rrc_ver), poi il messaggio NAS
        # Gate approssimativo: limita la ricerca del TPDU ai messaggi che
        # sembrano "Downlink/Uplink NAS Transport" (98/99, i soli che
        # possono veicolare SMS su NAS-EPS), cercando quel byte nei primi
        # ottetti (messaggio non protetto, o con un header di sicurezza
        # semplice gia' rimosso da --decrypt-nas di qcsuper).
        type_offset = None
        for i in range(min(8, len(msg))):
            if msg[i] in (98, 99):
                type_offset = i
                break
        if type_offset is None:
            continue
        body = msg[type_offset + 1:]
        for off in range(len(body)):
            res = try_parse_sms_deliver(body, off)
            if res is None:
                continue
            msg_class = classify_tp_dcs_class(res["tp_dcs"])
            if msg_class in (0, 2):
                detail = (rule["comment"] or "SMS silenziosa (TP-DCS class 0/2)")
                detail = f"{detail} (TP-DCS=0x{res['tp_dcs']:02x}, classe {msg_class})"
                raw_hex = body[off:res["end"]].hex().upper()
                ts = decode_dlf_timestamp(log_time)
                occs.append(mk_occ("SMSSTK", "silent_sms", ts, rule["level"], detail, raw=raw_hex))
            break  # un solo candidato per messaggio e' sufficiente
    return occs


# ---------------------------------------------------------------------
# --test-sms: SMS magica di test (vedi TEST_SMS_* in testa al file) -
# decoder GSM 7-bit autonomo (TS 23.038), NIENTE dipendenza da pycrate:
# extra_scan non ha (e non deve acquisire) dipendenze esterne, e' pensato
# per girare anche sul campo con la sola stdlib + tshark/openssl via
# subprocess (vedi il resto del file). Tabella verificata in fase di
# sviluppo contro pycrate_mobile.TS23038 (encode_7b/decode_7b) generando
# byte di prova e confrontando il decode - stesso spirito "verificato
# contro l'implementazione di riferimento" gia' usato altrove nel progetto.
# ---------------------------------------------------------------------

# Alfabeto di default GSM 03.38, indice = valore del settetto (0-127).
GSM7_BASE_TABLE = (
    "@£$¥èéùìòÇ\nØø\rÅå"
    "Δ_ΦΓΛΩΠΨΣΘΞ\x1bÆæßÉ"
    " !\"#¤%&'()*+,-./"
    "0123456789:;<=>?"
    "¡ABCDEFGHIJKLMNO"
    "PQRSTUVWXYZÄÖÑÜ§"
    "¿abcdefghijklmno"
    "pqrstuvwxyzäöñüà"
)
GSM7_ESCAPE = 0x1B  # 27: introduce il settetto seguente come carattere della tabella estesa
# Tabella estesa (TS 23.038 tab. 6.2.1.2.3.1): valore settetto -> carattere.
GSM7_EXT_TABLE = {
    10: "\x0c", 13: "\x11", 20: "^", 27: "\x0e",
    40: "{", 41: "}", 47: "\\", 60: "[", 61: "~", 62: "]", 64: "|", 101: "€",
}


def gsm7_unpack_septets(buf, count):
    """Spacchetta 'count' settetti (7 bit) da 'buf' (bytes, packing GSM
    standard: settetti consecutivi impacchettati LSB-first in ottetti).
    Ritorna una lista di interi 0-127, lunga al massimo 'count' (si ferma
    prima se 'buf' finisce, invece di sollevare - stesso spirito "fail
    soft" del resto del file)."""
    septets = []
    for i in range(count):
        bit_off = (i * 7) % 8
        byte_pos = (i * 7) // 8
        if byte_pos >= len(buf):
            break
        first = buf[byte_pos]
        if bit_off <= 1:
            val = (first >> bit_off) & 0x7F
        else:
            second = buf[byte_pos + 1] if byte_pos + 1 < len(buf) else 0
            val = ((first >> bit_off) | (second << (8 - bit_off))) & 0x7F
        septets.append(val)
    return septets


def gsm7_decode(septets):
    """Decodifica una lista di settetti (vedi gsm7_unpack_septets) in una
    stringa, gestendo l'escape verso la tabella estesa (GSM7_ESCAPE)."""
    chars = []
    i, n = 0, len(septets)
    while i < n:
        v = septets[i]
        if v == GSM7_ESCAPE and i + 1 < n:
            ext = GSM7_EXT_TABLE.get(septets[i + 1])
            if ext is not None:
                chars.append(ext)
            i += 2
            continue
        chars.append(GSM7_BASE_TABLE[v] if v < len(GSM7_BASE_TABLE) else "?")
        i += 1
    return "".join(chars)


def is_gsm7_default_alphabet(dcs):
    """True se il TP-DCS indica l'alfabeto di default a 7 bit (TS 23.038
    par. 4), sia nel gruppo "General Data Coding" (bit7-6=00, alfabeto nei
    bit3-2) sia nel gruppo "Message class" (bit7-4=1111, alfabeto nel solo
    bit2) - stessi due gruppi gia' distinti da classify_tp_dcs_class()
    sopra, qui pero' serve l'ALFABETO (7-bit si'/no), non la classe."""
    if dcs & 0xC0 == 0x00:
        return (dcs >> 2) & 0x03 == 0
    if dcs & 0xF0 == 0xF0:
        return dcs & 0x04 == 0
    return False


def detect_test_sms_trigger(dlf_path, rules):
    """Cerca, nello stesso spazio di ricerca di detect_silent_sms() (NAS
    EMM OTA -> Downlink/Uplink NAS Transport -> candidato SMS-DELIVER via
    try_parse_sms_deliver), un SMS VISIBILE normale (qualunque TP-DCS
    alfabeto 7-bit, NON limitato a class 0/2 come silent_sms) il cui
    TP-UD decodificato, spazi bianchi esclusi, corrisponde esattamente al
    testo magico TEST_SMS_TEXT_RE. Se trovato, forza al livello A la
    categoria indicata dal token (o tutte e 5 con ALL____) - vedi
    TEST_SMS_* in testa al file e l'override di rules[...]["level"] fatto
    da cmd_scan() prima di chiamare questa funzione.

    Limite noto v1: gestisce solo TP-UDHI=0 (SMS singolo, senza header
    dati utente/concatenazione) - il messaggio di test e' ~70 caratteri,
    ben sotto il limite di un SMS singolo a 7 bit (160 settetti), un
    telefono normale non ha motivo di concatenare per inviarlo."""
    try:
        with open(dlf_path, "rb") as f:
            data = f.read()
    except OSError:
        return []

    occs = []
    for log_type, log_time, payload in iter_dlf_records(data):
        if log_type not in (LOG_LTE_NAS_EMM_OTA_IN_MSG_LOG_C, LOG_LTE_NAS_EMM_OTA_OUT_MSG_LOG_C):
            continue
        if len(payload) <= 4:
            continue
        msg = payload[4:]
        type_offset = None
        for i in range(min(8, len(msg))):
            if msg[i] in (98, 99):
                type_offset = i
                break
        if type_offset is None:
            continue
        body = msg[type_offset + 1:]
        for off in range(len(body)):
            res = try_parse_sms_deliver(body, off)
            if res is None:
                continue
            udhi = bool(body[off] & 0x40)
            udl_pos = res["end"]
            if not udhi and is_gsm7_default_alphabet(res["tp_dcs"]) and udl_pos < len(body):
                udl = body[udl_pos]
                packed = body[udl_pos + 1:]
                needed_bytes = (udl * 7 + 7) // 8
                if len(packed) >= needed_bytes:
                    septets = gsm7_unpack_septets(packed, udl)
                    text = gsm7_decode(septets)
                    stripped = re.sub(r"\s+", "", text)
                    m = TEST_SMS_TEXT_RE.match(stripped)
                    if m:
                        token = m.group(1)
                        if token == TEST_SMS_ALL_TOKEN:
                            cats = list(dict.fromkeys(TEST_SMS_CATEGORY_TOKENS.values()))
                        elif token in TEST_SMS_CATEGORY_TOKENS:
                            cats = [TEST_SMS_CATEGORY_TOKENS[token]]
                        else:
                            cats = []
                        ts = decode_dlf_timestamp(log_time)
                        raw_hex = body[off:udl_pos + 1 + needed_bytes].hex().upper()
                        for cat in cats:
                            detail = (
                                f"[TEST-SMS FORCED] SMS di test rilevata "
                                f"(token={token}, categoria={cat})"
                            )
                            occs.append(mk_occ(cat, TEST_SMS_EVT, ts, "A", detail, raw=raw_hex))
            break  # un solo candidato TPDU per messaggio e' sufficiente (come detect_silent_sms)
    return occs


